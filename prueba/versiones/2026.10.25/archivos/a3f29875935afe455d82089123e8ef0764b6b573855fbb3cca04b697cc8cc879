# Lanzar el ayudante (proceso aparte que aplica la actualización con la ventana cerrada) y volver a abrir

def orden_de_arranque(script=None):
    """Cómo volver a abrir el programa: el mismo intérprete y el mismo script (los archivos que se soltaron sobre el
    acceso directo no: la lista de episodios se recupera con la sesión)."""
    script = script or (sys.argv[0] if sys.argv and sys.argv[0] else None)
    return [sys.executable, os.path.abspath(script)]


def _lanzar(orden, cwd=None, env=None, salida=None):
    flags = 0
    if os.name == "nt":
        flags = 0x00000008 | 0x00000200          # DETACHED_PROCESS | CREATE_NEW_PROCESS_GROUP
    kw = dict(cwd=cwd, env=env, close_fds=True, stdin=subprocess.DEVNULL,
              stdout=salida or subprocess.DEVNULL, stderr=salida or subprocess.DEVNULL)
    if os.name == "nt":
        try:
            return subprocess.Popen(orden, creationflags=flags | 0x01000000, **kw)   # fuera del trabajo del padre
        except OSError:
            return subprocess.Popen(orden, creationflags=flags, **kw)
    return subprocess.Popen(orden, start_new_session=True, **kw)


def copiar_ayudante(raiz):
    r = Rutas(raiz)
    carpeta = carpeta_interna(r.raiz, "ayudante")
    aqui = os.path.dirname(os.path.abspath(__file__))
    for nombre in ("actualizador.py", "actualizador_ventana.py"):
        origen = os.path.join(aqui, nombre)
        if os.path.exists(origen):
            shutil.copy2(origen, os.path.join(carpeta, nombre + ".copia"))
            reemplazar(os.path.join(carpeta, nombre + ".copia"), os.path.join(carpeta, nombre), 3.0)
    return os.path.join(carpeta, "actualizador.py")


def lanzar_ayudante(raiz, plan, carpeta, relanzar, instancia=None, sesion=None, cwd=None, ventana=True):
    """Escribe plan.json y lanza el ayudante (copia de este archivo) para que aplique la actualización en cuanto se
    cierre la ventana. Devuelve el id de la actualización."""
    r = Rutas(raiz)
    id_ = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
    datos = {"id": id_, "desde": plan.desde, "hacia": plan.pub.version, "sobre": plan.pub.sobre.decode("utf-8"),
             "huella": plan.pub.huella, "manifiesto": plan.pub.manifiesto, "operaciones": plan.operaciones,
             "preparacion": carpeta, "relanzar": relanzar, "cwd": cwd or os.getcwd(), "instancia": instancia,
             "sesion": sesion, "python": sys.executable, "creado": ahora()}
    escribir_json(r.plan, datos)
    ayudante = copiar_ayudante(raiz)
    orden = [python_ventana(), "-I", ayudante, "ayudante", "--instalacion", r.raiz]
    if not ventana:
        orden.append("--sin-ventana")
    _lanzar(orden, cwd=r.raiz)
    Registro(raiz)(f"Ayudante lanzado para pasar de la {plan.desde} a la {plan.pub.version} (id {id_}).")
    return id_


def esperar_cierre(raiz, ids, tiempo=T_CIERRE):
    """Espera a que se cierren las instancias `ids` (la ventana que pidió actualizar)."""
    fin = time.time() + tiempo
    while time.time() < fin:
        vivas = {i["id"] for i in instancias(raiz)}
        if not vivas & set(ids):
            return True
        time.sleep(0.25)
    return False


def cerrar_otras(raiz, excepto=(), tiempo=T_CIERRE, registro=None):
    """Pide a las demás ventanas del programa que se cierren (solo lo hacen si no tienen nada en marcha). Error si
    alguna tiene un trabajo en marcha o no se cierra."""
    reg = registro or (lambda t: None)
    otras = [i for i in instancias(raiz) if i.get("id") not in excepto]
    for i in otras:
        if i.get("ocupado") or i.get("tipo") == "motor":
            raise Ocupado(f"No se actualiza: hay {describir_instancia(i)} con un trabajo en marcha. Vuelve a "
                          "intentarlo cuando termine.")
    for i in otras:
        reg(f"Pidiendo que se cierre {describir_instancia(i)}")
        try:
            escribir_json(i["base"] + ".cerrar", {"por": "actualizacion", "cuando": ahora()})
        except OSError:
            pass
    fin = time.time() + tiempo
    while otras and time.time() < fin:
        vivas = {x["id"]: x for x in instancias(raiz)}
        otras = [vivas[i["id"]] for i in otras if i["id"] in vivas]
        for i in otras:
            resp = leer_json(i["base"] + ".respuesta")
            if resp and resp.get("respuesta") == "ocupado":
                raise Ocupado(f"No se actualiza: {describir_instancia(i)} tiene un trabajo en marcha.")
        time.sleep(0.25)
    if otras:
        raise Ocupado(f"No se actualiza: {describir_instancia(otras[0])} no se ha cerrado.")


def esperar_salud(raiz, id_, esperada, proceso=None, tiempo=T_SALUD, al_esperar=None):
    """Espera la señal de arranque de la versión nueva (la escribe la GUI ya abierta con su VERSION y la de los
    componentes que ha cargado). Error si no llega, si el proceso termina antes o si las versiones no cuadran."""
    r = Rutas(raiz)
    ruta = os.path.join(r.salud, f"{id_}.json")
    t0 = time.time()
    salida_temprana = None
    while time.time() - t0 < tiempo:
        s = leer_json(ruta)
        if s:
            comprobar_versiones(s.get("versiones") or {}, esperada)
            return s
        if proceso is not None and proceso.poll() is not None and salida_temprana is None:
            salida_temprana = time.time()
        if salida_temprana is not None and time.time() - salida_temprana > 10:
            raise ErrorActualizacion(f"La versión {esperada} se cerró al arrancar (código {proceso.returncode}).")
        if al_esperar:
            al_esperar(time.time() - t0)
        time.sleep(0.25)
    raise ErrorActualizacion(f"La versión {esperada} no ha dado señales de arrancar en {tiempo} s.")


def guardar_resultado(raiz, ok, mensaje, version, desde=None, detalle=""):
