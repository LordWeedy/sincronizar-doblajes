# Red: solo HTTPS con certificado comprobado, tiempos máximos, reintentos y reanudación comprobada

class _RedireccionSegura(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if urllib.parse.urlsplit(newurl).scheme.lower() != "https":
            raise SinConexion("El servidor redirige a una dirección que no es HTTPS; no se sigue.")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


class Red:
    def __init__(self, servidores=None, ca_extra=None, registro=None, cancelar=None, t_conexion=T_CONEXION,
                 intentos=INTENTOS, espera_base=ESPERA_BASE, avance=VENTANA_AVANCE, contexto=None):
        servidores = SERVIDORES if servidores is None else servidores
        self.servidores = []
        for s in servidores:
            if urllib.parse.urlsplit(s).scheme.lower() != "https":
                raise ErrorActualizacion(f"El servidor {s} no es HTTPS; no se usa.")
            self.servidores.append(s if s.endswith("/") else s + "/")
        if contexto is None:
            contexto = ssl.create_default_context()
            contexto.minimum_version = ssl.TLSVersion.TLSv1_2
            ca = CA_EXTRA if ca_extra is None else ca_extra
            if ca:
                contexto.load_verify_locations(ca)
        self.contexto = contexto
        self.registro = registro or (lambda t: None)
        self.cancelar = cancelar or threading.Event()
        self.t_conexion, self.intentos, self.espera_base, self.avance = t_conexion, intentos, espera_base, avance
        self.abridor = urllib.request.OpenerDirector()
        for h in (urllib.request.ProxyHandler(), urllib.request.HTTPSHandler(context=contexto),
                  _RedireccionSegura(), urllib.request.HTTPDefaultErrorHandler(),
                  urllib.request.HTTPErrorProcessor()):
            self.abridor.add_handler(h)

    def _abrir(self, url, cabeceras=None):
        if urllib.parse.urlsplit(url).scheme.lower() != "https":
            raise SinConexion("Solo se descarga por HTTPS.")
        cab = {"User-Agent": f"Sincronizar-Doblaje/{VERSION} (actualizador)", "Accept-Encoding": "identity"}
        cab.update(cabeceras or {})
        return self.abridor.open(urllib.request.Request(url, headers=cab), timeout=self.t_conexion)

    def _esperar(self, intento):
        espera = self.espera_base * (2 ** intento) * random.uniform(0.8, 1.2)
        if self.cancelar.wait(espera):
            raise Cancelado("Cancelado.")

    def _clasificar(self, e, url):
        """(error para el usuario, si merece la pena reintentar)."""
        if isinstance(e, ErrorActualizacion):
            return e, not isinstance(e, (Cancelado, FirmaInvalida, ManifiestoInvalido, NoEncontrado, SinEspacio))
        if es_sin_espacio(e):
            return SinEspacio("No queda espacio en el disco para la descarga.", str(e)), False
        if isinstance(e, urllib.error.HTTPError):
            if e.code == 404:
                return NoEncontrado(f"El servidor no tiene {url.rsplit('/', 1)[-1]} (404).", str(e)), False
            reintentar = e.code in (408, 425, 429) or e.code >= 500
            return SinConexion(f"El servidor respondió con un error ({e.code}).", str(e)), reintentar
        if isinstance(e, urllib.error.URLError) and isinstance(e.reason, ssl.SSLCertVerificationError):
            return SinConexion("El certificado HTTPS del servidor no es válido; no se descarga nada.", str(e)), False
        if isinstance(e, ssl.SSLError):
            return SinConexion("Falló la conexión segura (HTTPS) con el servidor.", str(e)), True
        if isinstance(e, (socket.timeout, TimeoutError)) or "timed out" in str(e):
            return SinConexion("El servidor no responde (tiempo de espera agotado).", str(e)), True
        if isinstance(e, (urllib.error.URLError, ConnectionError, OSError)) and not es_sin_espacio(e):
            return SinConexion("No hay conexión con el servidor de actualizaciones.", str(e)), True
        return e, False

    def leer(self, url, maximo):
        """El contenido de un archivo pequeño (el manifiesto), con reintentos."""
        ultimo = None
        for intento in range(self.intentos):
            if self.cancelar.is_set():
                raise Cancelado("Cancelado.")
            try:
                limite = time.time() + 60
                partes, n = [], 0
                with self._abrir(url, {"Cache-Control": "no-cache", "Pragma": "no-cache"}) as r:
                    while True:
                        b = r.read1(65536)
                        if not b:
                            break
                        partes.append(b)
                        n += len(b)
                        if n > maximo:
                            raise ManifiestoInvalido("El manifiesto es demasiado grande.")
                        if time.time() > limite or self.cancelar.is_set():
                            raise SinConexion("El servidor tarda demasiado en mandar el manifiesto.")
                return b"".join(partes)
            except Exception as e:
                ultimo, reintentar = self._clasificar(e, url)
                self.registro(f"  {url}: {mensaje_de(ultimo)} {getattr(ultimo, 'detalle', '')}".rstrip())
                if not reintentar:
                    break
                if intento + 1 < self.intentos:
                    self._esperar(intento)
        raise ultimo or SinConexion("No se pudo conectar con el servidor.")

    def descargar(self, url, destino, tamano, sha, progreso=None):
        """Descarga url en destino (que debe acabar en .parcial) comprobando tamaño y SHA-256. Reanuda lo descargado
        antes solo si el registro de al lado dice que es exactamente este archivo (mismo SHA-256 y tamaño)."""
        meta = destino + ".json"
        ultimo = None
        for intento in range(self.intentos):
            if self.cancelar.is_set():
                raise Cancelado("Cancelado.")
            try:
                self._una_descarga(url, destino, meta, tamano, sha, progreso)
                return
            except Exception as e:
                ultimo, reintentar = self._clasificar(e, url)
                self.registro(f"  {url}: {mensaje_de(ultimo)} {getattr(ultimo, 'detalle', '')}".rstrip())
                if not reintentar:
                    break
                if intento + 1 < self.intentos:
                    if progreso:
                        progreso(reintento=f"{mensaje_de(ultimo)} Reintentando ({intento + 2} de {self.intentos})...")
                    self._esperar(intento)
        raise ultimo or SinConexion("No se pudo conectar con el servidor.")

    def _una_descarga(self, url, destino, meta, tamano, sha, progreso):
        previo = 0
        m = leer_json(meta, {}) or {}
        if os.path.exists(destino) and m.get("sha256") == sha and m.get("tamano") == tamano:
            previo = os.path.getsize(destino)
            if previo > tamano:
                previo = 0
        if previo == 0:
            for x in (destino,):
                if os.path.exists(x):
                    os.remove(x)
            escribir_json(meta, {"sha256": sha, "tamano": tamano, "url": url})
        h = hashlib.sha256()
        if previo:
            with open(destino, "rb") as f:
                for b in iter(lambda: f.read(1 << 20), b""):
                    h.update(b)
        hecho = previo
        if progreso:
            progreso(hecho=hecho)
        if previo < tamano:
            cab = {"Range": f"bytes={previo}-"} if previo else {}
            try:
                r = self._abrir(url, cab)
            except urllib.error.HTTPError as e:
                if e.code == 416 and previo:
                    os.remove(destino)
                    raise SinConexion("La descarga a medias no encaja; se empieza de nuevo.")
                raise
            with r:
                if previo and r.status != 206:
                    previo, hecho, h = 0, 0, hashlib.sha256()           # el servidor no reanuda: desde el principio
                elif previo:
                    rango = r.headers.get("Content-Range", "")
                    if not rango.startswith(f"bytes {previo}-"):
                        raise SinConexion("El servidor respondió con otro trozo del archivo.", rango)
                largo = r.headers.get("Content-Length")
                if largo is not None and int(largo) != tamano - previo:
                    raise ManifiestoInvalido(f"El servidor dice que {url.rsplit('/', 1)[-1]} ocupa otra cosa "
                                             f"({int(largo) + previo} bytes en vez de {tamano}).")
                limite = time.time() + 600 + tamano / 16384
                muestras = [(time.time(), hecho)]
                with open(destino, "ab" if previo else "wb") as f:
                    while hecho < tamano:
                        if self.cancelar.is_set():
                            raise Cancelado("Cancelado.")
                        try:
                            b = r.read1(65536)
                        except (socket.timeout, TimeoutError) as e:
                            raise SinConexion(f"La transferencia está parada (no llega nada en {self.t_conexion} s).",
                                              str(e))
                        except (ConnectionError, OSError) as e:
                            if es_sin_espacio(e):
                                raise
                            raise SinConexion("Se cortó la conexión durante la descarga.", str(e))
                        if not b:
                            raise SinConexion("Se cortó la conexión durante la descarga (archivo incompleto).")
                        if hecho + len(b) > tamano:
                            raise ManifiestoInvalido("El servidor manda más datos de los que dice el manifiesto.")
                        f.write(b)
                        h.update(b)
                        hecho += len(b)
                        t = time.time()
                        muestras.append((t, hecho))
                        while len(muestras) > 2 and muestras[1][0] <= t - self.avance[0]:
                            muestras.pop(0)
                        if t - muestras[0][0] >= self.avance[0] and hecho - muestras[0][1] < self.avance[1]:
                            raise SinConexion("La transferencia está parada (no avanza).")
                        if t > limite:
                            raise SinConexion("La descarga está tardando demasiado.")
                        if progreso:
                            progreso(hecho=hecho)
                    f.flush()
                    os.fsync(f.fileno())
        if hecho != tamano or h.hexdigest() != sha:
            for x in (destino, meta):
                if os.path.exists(x):
                    os.remove(x)
            raise ManifiestoInvalido(f"{url.rsplit('/', 1)[-1]}: lo descargado no coincide con el manifiesto "
                                     "(SHA-256 o tamaño distinto).")


