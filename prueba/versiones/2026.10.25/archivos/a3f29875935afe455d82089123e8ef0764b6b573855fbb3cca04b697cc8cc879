def es_enlace(ruta):
    """Enlace simbólico, punto de unión u otro punto de reanálisis (pueden llevar fuera de la carpeta)."""
    try:
        st = os.lstat(ruta)
    except FileNotFoundError:
        return False
    if stat.S_ISLNK(st.st_mode):
        return True
    return bool(getattr(st, "st_file_attributes", 0) & getattr(stat, "FILE_ATTRIBUTE_REPARSE_POINT", 0x400))


def dentro(raiz, ruta):
    raiz, ruta = os.path.normcase(os.path.realpath(raiz)), os.path.normcase(os.path.realpath(ruta))
    try:
        return os.path.commonpath([raiz, ruta]) == raiz and ruta != raiz
    except ValueError:
        return False


def carpeta_interna(raiz, *partes):
    """Crea (si hace falta) una carpeta del actualizador y comprueba que no lleve fuera por un enlace."""
    raiz = os.path.realpath(raiz)
    actual = raiz
    for parte in (".actualizador",) + partes:
        actual = os.path.join(actual, parte)
        if es_enlace(actual):
            raise SinPermisos(f"La carpeta {actual} es un enlace a otro sitio; por seguridad no se usa.")
        os.makedirs(actual, exist_ok=True)
    if not dentro(raiz, actual):
        raise SinPermisos(f"La carpeta {actual} queda fuera de la instalación; por seguridad no se usa.")
    return actual


class Registro:
    """Registro de la operación en .actualizador\\registro.txt (sin contraseñas ni tokens)."""

    def __init__(self, raiz, eco=None):
        self.ruta = Rutas(raiz).registro
        self.eco = eco
        self.lock = threading.Lock()

    def __call__(self, texto):
        texto = sin_secretos(str(texto))
        if self.eco:
            try:
                self.eco(texto)
            except Exception:
                pass
        with self.lock:
            try:
                os.makedirs(os.path.dirname(self.ruta), exist_ok=True)
                if os.path.exists(self.ruta) and os.path.getsize(self.ruta) > 512 * 1024:
                    reemplazar(self.ruta, self.ruta[:-4] + ".1.txt")
                with open(self.ruta, "a", encoding="utf-8") as f:
                    f.write(f"{ahora()} [{os.getpid()}] {texto}\n")
            except OSError:
                pass


