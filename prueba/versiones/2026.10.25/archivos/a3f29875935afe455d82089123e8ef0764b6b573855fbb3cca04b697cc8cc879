def _instalar_publicacion(raiz, pub, servidor, red, permitir_bajada=False, mismo=False):
    """Para reparar y restaurar-version desde la consola: descarga, aplica y comprueba (sin la GUI)."""
    instalada = leer_estado(raiz).get("version") or VERSION
    if not mismo and not permitir_bajada and version_tupla(pub.version) <= version_tupla(instalada):
        raise ErrorActualizacion(f"La {pub.version} no es posterior a la instalada ({instalada}).")
    plan = calcular_plan(raiz, pub, servidor, instalada)
    if plan.vacio():
        print("Todos los archivos están bien; no hay nada que cambiar.")
        return 0
    for o in plan.operaciones:
        print(f"  {o['tipo']:9s} {o['ruta']}")
    if ocupadas(raiz):
        raise Ocupado("Hay una ventana o un análisis del programa con un trabajo en marcha; ciérralo antes.")
    cerrojo = Cerrojo(Rutas(raiz).cerrojo)
    if not cerrojo.tomar():
        raise Ocupado("Ya hay otra actualización en marcha.")
    try:
        carpeta = preparar(raiz, plan, red, progreso=lambda **k: None)
        cerrar_otras(raiz, tiempo=30)
        datos = {"id": time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}", "desde": instalada, "hacia": pub.version,
                 "manifiesto": pub.manifiesto, "operaciones": plan.operaciones, "preparacion": carpeta}
        aplicar(raiz, datos, Registro(raiz, eco=print), progreso=lambda i, n, ruta: print(f"  {i}/{n} {ruta}"))
        try:
            comprobar_versiones(versiones_instaladas(raiz), pub.version)
        except ErrorActualizacion as e:
            revertir(raiz, Registro(raiz, eco=print))
            raise ErrorActualizacion(f"{e.mensaje} Se ha deshecho.", e.detalle)
        confirmar(raiz, Registro(raiz, eco=print))
        print(f"Instalada la {pub.version}. Abre el programa para comprobarlo.")
        return 0
    finally:
        cerrojo.soltar()


def deshacer_ultima(raiz):
    """Vuelve a dejar la instalación como estaba antes de la última actualización confirmada, con su respaldo."""
    lista = [x for x in respaldos(raiz) if x[2] and x[2].get("estado") == "confirmado"]
    if not lista:
        raise ErrorActualizacion("No hay ninguna actualización que deshacer (no quedan respaldos).")
    carpeta, datos, diario = lista[0]
    if ocupadas(raiz):
        raise Ocupado("Hay una ventana o un análisis del programa con un trabajo en marcha; ciérralo antes.")
    r = Rutas(raiz)
    cerrojo = Cerrojo(r.cerrojo)
    if not cerrojo.tomar():
        raise Ocupado("Ya hay otra actualización en marcha.")
    try:
        cerrar_otras(raiz, tiempo=30)
        id_ = time.strftime("%Y%m%d-%H%M%S") + f"-{os.getpid()}"
        prep = carpeta_interna(r.raiz, "preparacion", "deshacer-" + id_)
        ops, archivos = [], {}
        est_viejo = leer_json(os.path.join(carpeta, "estado.json"), {}) or {}
        for o in diario["operaciones"]:
            dest = destino_seguro(raiz, o["ruta"])
            actual = _sha_o_none(dest)
            if o["tipo"] == "nuevo":
                if actual == o["sha256"]:
                    ops.append({"ruta": o["ruta"], "tipo": "retirar", "tamano": 0, "sha256": None, "sha_antes": actual})
                continue
            copia = os.path.join(carpeta, "archivos", *o["ruta"].split("/"))
            if not os.path.isfile(copia):
                raise ErrorActualizacion(f"Falta el respaldo de {o['ruta']}.")
            shutil.copy2(copia, os.path.join(prep, o["sha_antes"]))
            ops.append({"ruta": o["ruta"], "tipo": "sustituir" if actual else "nuevo",
                        "tamano": os.path.getsize(copia), "sha256": o["sha_antes"], "sha_antes": actual})
        for ruta, info in (est_viejo.get("archivos") or {}).items():
            archivos[ruta] = info
        manifiesto = {"archivos": [{"ruta": k, "sha256": v["sha256"], "tamano": v["tamano"]}
                                   for k, v in archivos.items()]}
        datos_plan = {"id": id_, "desde": diario["hacia"], "hacia": diario.get("desde") or "?", "manifiesto": manifiesto,
                      "operaciones": ops, "preparacion": prep}
        if not manifiesto["archivos"]:
            manifiesto["archivos"] = []
        aplicar(raiz, datos_plan, Registro(raiz, eco=print), progreso=lambda i, n, ruta: print(f"  {i}/{n} {ruta}"))
        confirmar(raiz, Registro(raiz, eco=print))
        if not est_viejo:
            try:
                os.remove(r.json_estado)
            except OSError:
                pass
        else:
            escribir_json(r.json_estado, est_viejo)
        shutil.rmtree(prep, ignore_errors=True)
        print(f"Vuelta a la versión {diario.get('desde')}.")
        return 0
    finally:
        cerrojo.soltar()


def main(argv=None):
    import argparse
    ap = argparse.ArgumentParser(description="Actualizaciones de Sincronizar Doblaje.")
    ap.add_argument("orden", choices=("estado", "comprobar", "recuperar", "deshacer", "reparar", "restaurar-version",
                                      "ayudante", "vigilar"))
    ap.add_argument("version", nargs="?")
    ap.add_argument("--instalacion", default=os.path.dirname(os.path.abspath(__file__)))
    ap.add_argument("--confirmo", action="store_true")
    ap.add_argument("--sin-ventana", action="store_true")
    ap.add_argument("--id")
    ap.add_argument("--pid", type=int)
    args = ap.parse_args(argv)
    raiz = os.path.realpath(args.instalacion)
    if args.orden in ("ayudante", "vigilar"):
        vigilar = args.id if args.orden == "vigilar" else None
        ventana = None
        if not args.sin_ventana and os.environ.get("SINCRONIZAR_ACTUALIZADOR_SIN_VENTANA") != "1":
            try:
                sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
                import actualizador_ventana
                ventana = actualizador_ventana.VentanaAyudante()
            except Exception as e:
                Registro(raiz)(f"Sin ventana para el ayudante: {e}")
        if ventana is not None:
            return ventana.ejecutar(lambda ui: ejecutar_ayudante(raiz, ui, vigilar, args.pid))
        return ejecutar_ayudante(raiz, None, vigilar, args.pid)
    gui = os.path.join(raiz, GUI)
    version_inst = leer_estado(raiz).get("version") or _version_de(gui) or VERSION
    try:
        if args.orden == "estado":
            est = leer_estado(raiz)
            print(f"Instalación: {raiz}\nVersión del programa: {_version_de(gui) or '?'}"
                  f"\nVersión según el actualizador: {est.get('version') or '(nunca actualizado)'}")
            d = leer_json(Rutas(raiz).diario)
            print("Actualización pendiente: " + (f"{d['estado']} de la {d.get('desde')} a la {d['hacia']}" if d
                                                  else "ninguna"))
            for c, datos, diario in respaldos(raiz):
                print(f"Respaldo {os.path.basename(c)}: {datos.get('desde')} -> {datos.get('hacia')}, "
                      f"{(diario or {}).get('estado', '?')}")
            for i in instancias(raiz):
                print(f"Abierto: {describir_instancia(i)}" + (" (con un trabajo en marcha)" if i.get("ocupado") else ""))
            return 0
        if args.orden == "recuperar":
            d = leer_json(Rutas(raiz).diario)
            if not d:
                print("No hay ninguna actualización a medias.")
                return 0
            with Cerrojo(Rutas(raiz).cerrojo) as c:
                if not c.tomar():
                    raise Ocupado("Hay una actualización en marcha ahora mismo; espera a que termine.")
                revertir(raiz, Registro(raiz, eco=print))
            return 0
        if args.orden == "deshacer":
            return deshacer_ultima(raiz)
        red = Red(registro=Registro(raiz, eco=print))
        if args.orden == "comprobar":
            c = comprobar(raiz, version_inst, red)
            print({"al_dia": f"Al día: la publicada es la {c.pub.version}.",
                   "disponible": f"Hay una versión nueva: {c.pub.version}.",
                   "incompatible": f"Hay una versión nueva ({c.pub.version}) pero {c.motivo}."}[c.estado])
            return 0
        if args.orden == "reparar":
            pub, s = obtener_publicacion(red, version=version_inst)
            return _instalar_publicacion(raiz, pub, s, red, mismo=True)
        if args.orden == "restaurar-version":
            if not args.version or not args.confirmo:
                ap.error("indica la versión y --confirmo (instalar una versión anterior es una decisión explícita)")
            pub, s = obtener_publicacion(red, version=args.version)
            return _instalar_publicacion(raiz, pub, s, red, permitir_bajada=True, mismo=True)
    except ErrorActualizacion as e:
        print(f"ERROR: {e.mensaje}")
        return 1
    return 0


def _version_de(ruta_py):
    """La VERSION que declara un .py sin ejecutarlo."""
    import ast
    try:
        with open(ruta_py, encoding="utf-8") as f:
            arbol = ast.parse(f.read())
    except (OSError, SyntaxError, ValueError):
        return None
    for x in arbol.body:
        if isinstance(x, ast.Assign) and any(getattr(t, "id", "") == "VERSION" for t in x.targets):
            if isinstance(x.value, ast.Constant) and isinstance(x.value.value, str):
                return x.value.value
    return None


