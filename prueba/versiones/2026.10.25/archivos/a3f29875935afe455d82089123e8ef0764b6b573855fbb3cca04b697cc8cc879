def python_consola(exe=None):
    exe = exe or sys.executable
    carpeta, nombre = os.path.split(exe)
    if nombre.lower() == "pythonw.exe" and os.path.exists(os.path.join(carpeta, "python.exe")):
        return os.path.join(carpeta, "python.exe")
    return exe


def python_ventana(exe=None):
    exe = exe or sys.executable
    carpeta, nombre = os.path.split(exe)
    if nombre.lower() == "python.exe" and os.path.exists(os.path.join(carpeta, "pythonw.exe")):
        return os.path.join(carpeta, "pythonw.exe")
    return exe


SIN_CONSOLA = 0x08000000 if os.name == "nt" else 0


def versiones_instaladas(raiz, python=None, tiempo=90):
    """{componente: VERSION} leyendo cada .py del programa en un proceso aparte (importa el motor como lo haría la
    GUI), o ErrorActualizacion con lo que falló."""
    codigo = ("import sys, json, os; sys.dont_write_bytecode = True; sys.path.insert(0, sys.argv[1]); "
              "import importlib; v = {}\n"
              "for n in ('sincronizar_doblaje', 'limpiar_vhs', 'actualizador', 'actualizador_ventana'):\n"
              "    v[n] = importlib.import_module(n).VERSION\n"
              "import ast\n"
              "for n in ('Sincronizar_Doblaje_Gui.py',):\n"
              "    t = ast.parse(open(os.path.join(sys.argv[1], n), encoding='utf-8').read())\n"
              "    v[n[:-3]] = next(x.value.value for x in t.body if isinstance(x, ast.Assign) and "
              "any(getattr(y, 'id', '') == 'VERSION' for y in x.targets))\n"
              "print('VERSIONES ' + json.dumps(v))\n")
    try:
        p = subprocess.run([python_consola(python), "-I", "-c", codigo, os.path.realpath(raiz)], capture_output=True,
                           text=True, encoding="utf-8", errors="replace", timeout=tiempo, creationflags=SIN_CONSOLA)
    except subprocess.TimeoutExpired:
        raise ErrorActualizacion("La versión nueva no termina de cargar (más de 90 s).")
    for linea in p.stdout.splitlines():
        if linea.startswith("VERSIONES "):
            return json.loads(linea[10:])
    error = (p.stderr or p.stdout).strip().splitlines()
    raise ErrorActualizacion("La versión nueva no carga: " + (error[-1] if error else f"código {p.returncode}"),
                             "\n".join(error[-15:]))


def comprobar_versiones(versiones, esperada):
    malas = {k: v for k, v in versiones.items() if v != esperada}
    if malas:
        raise ErrorActualizacion("Componentes de versiones distintas: " +
                                 ", ".join(f"{k} {v}" for k, v in sorted(malas.items())) + f" (se esperaba {esperada}).")


