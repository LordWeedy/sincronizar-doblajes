# Ed25519 (RFC 8032), en Python puro: el programa no necesita instalar nada para comprobar las firmas

_P = 2 ** 255 - 19
_Q = 2 ** 252 + 27742317777372353535851937790883648493


def _inv(x):
    return pow(x, _P - 2, _P)


_D = -121665 * _inv(121666) % _P
_RAIZ_M1 = pow(2, (_P - 1) // 4, _P)


def _suma(a, b):
    x1, y1, z1, t1 = a
    x2, y2, z2, t2 = b
    pa = (y1 - x1) * (y2 - x2) % _P
    pb = (y1 + x1) * (y2 + x2) % _P
    pc = 2 * t1 * t2 * _D % _P
    pd = 2 * z1 * z2 % _P
    e, f, g, h = pb - pa, pd - pc, pd + pc, pb + pa
    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)


def _por(k, punto):
    r = (0, 1, 1, 0)
    while k > 0:
        if k & 1:
            r = _suma(r, punto)
        punto = _suma(punto, punto)
        k >>= 1
    return r


def _iguales(a, b):
    return (a[0] * b[2] - b[0] * a[2]) % _P == 0 and (a[1] * b[2] - b[1] * a[2]) % _P == 0


def _x(y, signo):
    if y >= _P:
        return None
    x2 = (y * y - 1) * _inv(_D * y * y + 1) % _P
    if x2 == 0:
        return None if signo else 0
    x = pow(x2, (_P + 3) // 8, _P)
    if (x * x - x2) % _P:
        x = x * _RAIZ_M1 % _P
    if (x * x - x2) % _P:
        return None
    if (x & 1) != signo:
        x = _P - x
    return x


_GY = 4 * _inv(5) % _P
_GX = _x(_GY, 0)
_G = (_GX, _GY, 1, _GX * _GY % _P)


def _comprimir(punto):
    zi = _inv(punto[2])
    x, y = punto[0] * zi % _P, punto[1] * zi % _P
    return int.to_bytes(y | ((x & 1) << 255), 32, "little")


def _descomprimir(b):
    if len(b) != 32:
        return None
    y = int.from_bytes(b, "little")
    signo, y = y >> 255, y & ((1 << 255) - 1)
    x = _x(y, signo)
    return None if x is None else (x, y, 1, x * y % _P)


def _h(b):
    return int.from_bytes(hashlib.sha512(b).digest(), "little") % _Q


def _expandir(secreta):
    h = hashlib.sha512(secreta).digest()
    a = int.from_bytes(h[:32], "little")
    a &= (1 << 254) - 8
    a |= 1 << 254
    return a, h[32:]


def ed25519_publica(secreta):
    if len(secreta) != 32:
        raise ValueError("la clave privada tiene que tener 32 bytes")
    a, _ = _expandir(secreta)
    return _comprimir(_por(a, _G))


def ed25519_firmar(secreta, mensaje):
    a, prefijo = _expandir(secreta)
    pub = _comprimir(_por(a, _G))
    r = _h(prefijo + mensaje)
    rb = _comprimir(_por(r, _G))
    s = (r + _h(rb + pub + mensaje) * a) % _Q
    return rb + int.to_bytes(s, 32, "little")


def ed25519_verificar(publica, mensaje, firma):
    if len(publica) != 32 or len(firma) != 64:
        return False
    a = _descomprimir(publica)
    r = _descomprimir(firma[:32])
    if a is None or r is None:
        return False
    s = int.from_bytes(firma[32:], "little")
    if s >= _Q:
        return False
    h = _h(firma[:32] + publica + mensaje)
    return _iguales(_por(s, _G), _suma(r, _por(h, a)))


def id_de_clave(publica):
    return hashlib.sha256(publica).hexdigest()[:16]


