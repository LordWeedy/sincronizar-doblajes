# Comprobar si hay versión nueva

class Comprobacion:
    def __init__(self, estado, pub=None, servidor=None, motivo=None):
        self.estado, self.pub, self.servidor, self.motivo = estado, pub, servidor, motivo


def leer_estado(raiz):
    return leer_json(Rutas(raiz).json_estado, {}) or {}


def obtener_publicacion(red, claves=None, version=None):
    """(Publicacion, servidor) del primer servidor que responda con un manifiesto bien firmado: el puntero de la
    versión actual o, con `version`, el manifiesto de esa versión."""
    if not red.servidores:
        raise SinConexion("No hay ningún servidor de actualizaciones configurado.")
    fallos = []
    for s in red.servidores:
        url = s + (f"versiones/{version}/manifiesto.json" if version else f"{CANAL}.json")
        try:
            pub = abrir_sobre(red.leer(url, MAX_SOBRE), claves)
            if version and pub.version != version:
                raise ManifiestoInvalido(f"El manifiesto de la {version} dice ser de la {pub.version}.")
            return pub, s
        except Cancelado:
            raise
        except ErrorActualizacion as e:
            fallos.append(e)
            red.registro(f"Servidor {s}: {e.mensaje}")
    # el error más grave manda: una firma mala no se tapa con un «sin conexión» del alternativo
    for clase in (FirmaInvalida, ManifiestoInvalido, NoEncontrado):
        for e in fallos:
            if isinstance(e, clase):
                raise e
    raise fallos[0]


def comprobar(raiz, version_instalada, red, claves=None):
    """Comprobacion: 'al_dia', 'disponible' o 'incompatible' (con su motivo)."""
    pub, servidor = obtener_publicacion(red, claves)
    m = pub.manifiesto
    r = Rutas(raiz)
    est = leer_estado(raiz)
    try:
        vista = est.get("version_max_vista")
        if vista and version_tupla(pub.version) < version_tupla(vista):
            red.registro(f"El servidor anuncia la {pub.version}, anterior a la {vista} que ya anunció: se ignora.")
        elif os.path.isdir(r.estado) and (not vista or version_tupla(pub.version) > version_tupla(vista)):
            est["version_max_vista"] = pub.version
            escribir_json(r.json_estado, est)
    except (OSError, ValueError):
        pass
    if version_tupla(pub.version) <= version_tupla(version_instalada):
        return Comprobacion("al_dia", pub, servidor)
    motivo = compatible(m, version_instalada)
    return Comprobacion("incompatible" if motivo else "disponible", pub, servidor, motivo)


