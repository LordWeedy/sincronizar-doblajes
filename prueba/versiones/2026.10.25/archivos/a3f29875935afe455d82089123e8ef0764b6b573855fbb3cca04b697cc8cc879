# Plan y descarga a la carpeta de preparación

class Plan:
    def __init__(self, pub, servidor, operaciones, desde):
        self.pub, self.servidor, self.operaciones, self.desde = pub, servidor, operaciones, desde
        self.descargas = [o for o in operaciones if o["tipo"] in ("nuevo", "sustituir")]
        self.bytes = sum(o["tamano"] for o in self.descargas)

    def vacio(self):
        return not self.operaciones


def calcular_plan(raiz, pub, servidor=None, desde=None):
    """Compara lo instalado con el manifiesto: qué archivos son nuevos, cuáles cambian (o están dañados) y cuáles
    retira el actualizador (solo los que instaló él y siguen como los dejó)."""
    raiz = os.path.realpath(raiz)
    est = leer_estado(raiz)
    ops = []
    en_manifiesto = set()
    for a in pub.manifiesto["archivos"]:
        dest = destino_seguro(raiz, a["ruta"])
        en_manifiesto.add(a["ruta"].lower())
        if os.path.isfile(dest):
            try:
                sha_antes = sha256_archivo(dest)
            except PermissionError as e:
                raise ArchivoEnUso(f"No se puede leer {a['ruta']}: está abierto por otro programa.", str(e))
            if os.path.getsize(dest) == a["tamano"] and sha_antes == a["sha256"]:
                continue
            ops.append({"ruta": a["ruta"], "tipo": "sustituir", "tamano": a["tamano"], "sha256": a["sha256"],
                        "sha_antes": sha_antes})
        else:
            ops.append({"ruta": a["ruta"], "tipo": "nuevo", "tamano": a["tamano"], "sha256": a["sha256"],
                        "sha_antes": None})
    for ruta, info in sorted((est.get("archivos") or {}).items()):
        try:
            if ruta.lower() in en_manifiesto:
                continue
            dest = destino_seguro(raiz, ruta)
        except ErrorActualizacion:
            continue
        if os.path.isfile(dest) and sha256_archivo(dest) == info.get("sha256"):
            ops.append({"ruta": ruta, "tipo": "retirar", "tamano": 0, "sha256": None, "sha_antes": info["sha256"]})
    return Plan(pub, servidor, ops, desde if desde is not None else est.get("version"))


def espacio_libre(ruta):
    return shutil.disk_usage(ruta).free


def preparar(raiz, plan, red, progreso=None, claves=None, libre=espacio_libre):
    """Descarga lo que haga falta a .actualizador\\preparacion\\<versión> y lo comprueba todo; no toca la
    instalación. progreso(**datos) recibe la fase, el archivo y los bytes reales."""
    progreso = progreso or (lambda **k: None)
    raiz = os.path.realpath(raiz)
    pub = plan.pub
    carpeta = carpeta_interna(raiz, "preparacion", pub.version)
    marca = os.path.join(carpeta, "publicacion.json")
    previa = leer_json(marca, {}) or {}
    if previa.get("huella") != pub.huella:
        # otra publicación con el mismo número (o restos): se vacía, solo lo nuestro
        for nombre in os.listdir(carpeta):
            if re.fullmatch(r"[0-9a-f]{64}(\.parcial(\.json)?)?", nombre):
                os.remove(os.path.join(carpeta, nombre))
        escribir_json(marca, {"huella": pub.huella, "version": pub.version})
    pendientes = []
    for o in plan.descargas:
        listo = os.path.join(carpeta, o["sha256"])
        if os.path.isfile(listo) and os.path.getsize(listo) == o["tamano"] and sha256_archivo(listo) == o["sha256"]:
            continue
        pendientes.append(o)
    respaldo = sum(os.path.getsize(destino_seguro(raiz, o["ruta"])) for o in plan.operaciones
                   if o["tipo"] in ("sustituir", "retirar"))
    falta = sum(o["tamano"] for o in pendientes) + sum(o["tamano"] for o in plan.descargas) + respaldo + (8 << 20)
    hay = libre(raiz)
    if hay < falta:
        raise SinEspacio(f"No hay espacio suficiente en el disco del programa: hacen falta {tamano_legible(falta)} "
                         f"y quedan {tamano_legible(hay)}.")
    total = sum(o["tamano"] for o in plan.descargas)
    hecho_total = total - sum(o["tamano"] for o in pendientes)
    progreso(fase="descargando", archivo="", n=0, de=len(pendientes), hecho=0, tamano=0, hecho_total=hecho_total,
             total=total)
    servidores = _servidores_de(red, pub, plan.servidor, claves)
    for n, o in enumerate(pendientes, 1):
        listo = os.path.join(carpeta, o["sha256"])
        parcial = listo + ".parcial"
        base = hecho_total

        def avisar(hecho=None, reintento=None, o=o, n=n, base=base):
            if reintento:
                progreso(fase="reintento", archivo=o["ruta"], mensaje=reintento)
            else:
                progreso(fase="descargando", archivo=o["ruta"], n=n, de=len(pendientes), hecho=hecho,
                         tamano=o["tamano"], hecho_total=base + hecho, total=total)
        ultimo = None
        for s in servidores():
            url = f"{s}versiones/{pub.version}/archivos/{o['sha256']}"
            try:
                red.descargar(url, parcial, o["tamano"], o["sha256"], avisar)
                ultimo = None
                break
            except Cancelado:
                raise
            except ErrorActualizacion as e:
                ultimo = e
                red.registro(f"No se pudo descargar {o['ruta']} de {s}: {e.mensaje}")
        if ultimo is not None:
            raise ultimo
        reemplazar(parcial, listo)
        try:
            os.remove(parcial + ".json")
        except OSError:
            pass
        hecho_total += o["tamano"]
    progreso(fase="verificando", archivo="", hecho_total=total, total=total)
    for o in plan.descargas:
        listo = os.path.join(carpeta, o["sha256"])
        if not os.path.isfile(listo) or sha256_archivo(listo) != o["sha256"]:
            raise ManifiestoInvalido(f"{o['ruta']}: lo descargado no coincide con el manifiesto.")
        if o["ruta"].lower().endswith(".py"):
            with open(listo, "rb") as f:
                fuente = f.read()
            try:
                compile(fuente, o["ruta"], "exec", dont_inherit=True)
            except SyntaxError as e:
                raise ManifiestoInvalido(f"La versión {pub.version} trae {o['ruta']} con un error (línea {e.lineno}); "
                                         "no se instala.", str(e))
    progreso(fase="listo", archivo="", hecho_total=total, total=total)
    return carpeta


def _servidores_de(red, pub, primero, claves):
    """Generador de servidores para descargar los archivos de pub: primero el que sirvió el manifiesto; los demás,
    solo si sirven exactamente la misma publicación firmada (mismo manifiesto)."""
    comprobados = {}

    def gen():
        orden = ([primero] if primero else []) + [s for s in red.servidores if s != primero]
        for s in orden:
            if s != primero and s not in comprobados:
                try:
                    otra, _ = obtener_publicacion(Red([s], contexto=red.contexto, registro=red.registro,
                                                      cancelar=red.cancelar, t_conexion=red.t_conexion,
                                                      intentos=red.intentos, espera_base=red.espera_base,
                                                      avance=red.avance), claves, pub.version)
                    comprobados[s] = otra.huella == pub.huella
                    if not comprobados[s]:
                        red.registro(f"El servidor {s} sirve otra publicación de la {pub.version}: no se usa.")
                except Cancelado:
                    raise
                except ErrorActualizacion as e:
                    comprobados[s] = False
                    red.registro(f"El servidor {s} no sirve la {pub.version}: {e.mensaje}")
            if s == primero or comprobados.get(s):
                yield s
    return gen


