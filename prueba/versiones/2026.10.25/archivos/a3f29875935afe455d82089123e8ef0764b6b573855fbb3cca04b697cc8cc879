def al_arrancar(raiz, version):
    """Lo primero que hace la GUI. Si la última actualización se quedó a medias (corte de luz, el ayudante murió),
    la deshace y vuelve a abrir el programa; si espera la señal de arranque y no hay ayudante, lanza uno que vigile.
    Devuelve None, o {"salud": id, "hacia": versión} si este arranque tiene que dar la señal."""
    r = Rutas(raiz)
    if not os.path.exists(r.diario):
        if os.path.isdir(r.salud):          # la salida de la ventana de la última actualización, ya cerrada
            shutil.rmtree(r.salud, ignore_errors=True)
        return None
    d = leer_json(r.diario)
    if not d:
        return None
    cerrojo = Cerrojo(r.cerrojo)
    if not cerrojo.tomar():
        # un ayudante está trabajando: si espera la señal, la da este arranque
        return {"salud": d["id"], "hacia": d["hacia"]} if d.get("estado") == "comprobando" else None
    try:
        if d.get("estado") in ESTADOS_APLICANDO:
            reg = Registro(raiz)
            reg(f"La actualización a la {d['hacia']} se quedó a medias ({d['estado']}): se deshace.")
            try:
                problemas = revertir(raiz, reg)
            except Exception as e:
                problemas = [mensaje_de(e)]
            guardar_resultado(raiz, False, f"La actualización a la {d['hacia']} se interrumpió (¿se apagó el equipo?) "
                              f"y se ha vuelto a la {d.get('desde')}." +
                              (" Ha habido problemas al restaurar: revisa .actualizador\\registro.txt."
                               if problemas else ""), d.get("desde"), d["hacia"], "; ".join(problemas))
            if not problemas:
                # este proceso puede tener cargada una mezcla de las dos versiones: se abre de nuevo, ya restaurado
                cerrojo.soltar()
                _lanzar(orden_de_arranque(), cwd=os.getcwd())
                sys.exit(0)
            return None
        if d.get("estado") == "comprobando":
            cerrojo.soltar()
            ayudante = copiar_ayudante(raiz)
            _lanzar([python_ventana(), "-I", ayudante, "vigilar", "--instalacion", r.raiz, "--id", d["id"],
                     "--pid", str(os.getpid())]
                    + ([] if os.environ.get("SINCRONIZAR_ACTUALIZADOR_SIN_VENTANA") != "1" else ["--sin-ventana"]),
                    cwd=r.raiz)
            Registro(raiz)(f"Arranque con la actualización a la {d['hacia']} sin confirmar: se vigila.")
            return {"salud": d["id"], "hacia": d["hacia"]}
    finally:
        cerrojo.soltar()
    return None


