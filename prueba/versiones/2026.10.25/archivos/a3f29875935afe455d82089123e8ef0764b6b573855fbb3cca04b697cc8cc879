# Cerrojos entre procesos (también entre equipos, si la carpeta es compartida) e instancias del programa

if os.name == "nt":
    import msvcrt

    def _bloquear(fd):
        os.lseek(fd, 0, os.SEEK_SET)
        msvcrt.locking(fd, msvcrt.LK_NBLCK, 1)

    def _desbloquear(fd):
        os.lseek(fd, 0, os.SEEK_SET)
        msvcrt.locking(fd, msvcrt.LK_UNLCK, 1)
else:
    import fcntl

    def _bloquear(fd):
        fcntl.lockf(fd, fcntl.LOCK_EX | fcntl.LOCK_NB, 1, 0)

    def _desbloquear(fd):
        fcntl.lockf(fd, fcntl.LOCK_UN, 1, 0)


class Cerrojo:
    """Cerrojo de un archivo: lo tiene un solo proceso a la vez y se suelta solo si el proceso muere."""

    def __init__(self, ruta):
        self.ruta, self.fd = ruta, None

    def tomar(self, esperar=0.0):
        fin = time.time() + esperar
        try:
            os.makedirs(os.path.dirname(self.ruta), exist_ok=True)
        except OSError:
            pass
        while True:
            fd = None
            try:
                fd = os.open(self.ruta, os.O_RDWR | os.O_CREAT | getattr(os, "O_BINARY", 0))
                _bloquear(fd)
                self.fd = fd
                return True
            except OSError:
                if fd is not None:
                    os.close(fd)
            if time.time() >= fin:
                return False
            time.sleep(0.2)

    def soltar(self):
        if self.fd is not None:
            try:
                _desbloquear(self.fd)
            except OSError:
                pass
            os.close(self.fd)
            self.fd = None

    def __enter__(self):
        return self

    def __exit__(self, *a):
        self.soltar()


def cerrojo_libre(ruta):
    c = Cerrojo(ruta)
    if c.tomar():
        c.soltar()
        return True
    return False


class Instancia:
    """Una ventana del programa o un análisis en marcha, para que no se actualice con él abierto."""

    def __init__(self, raiz, tipo, ocupado=False, que=""):
        r = Rutas(raiz)
        carpeta_interna(r.raiz, "instancias")
        limpiar_instancias(r.raiz)
        self.id = f"{socket.gethostname()}_{os.getpid()}_{tipo}"
        self.base = os.path.join(r.instancias, self.id)
        self.cerrojo = Cerrojo(self.base + ".lock")
        if not self.cerrojo.tomar(2.0):
            raise OSError("no se pudo registrar la instancia")
        self.info = {"id": self.id, "tipo": tipo, "equipo": socket.gethostname(), "pid": os.getpid(),
                     "desde": ahora(), "ocupado": bool(ocupado), "que": que, "version": VERSION}
        for viejo in (".cerrar", ".respuesta"):
            try:
                os.remove(self.base + viejo)
            except OSError:
                pass
        escribir_json(self.base + ".json", self.info)

    def marcar(self, ocupado, que=""):
        self.info.update(ocupado=bool(ocupado), que=que)
        try:
            escribir_json(self.base + ".json", self.info)
        except OSError:
            pass

    def peticion_de_cierre(self):
        return os.path.exists(self.base + ".cerrar")

    def responder(self, texto):
        try:
            escribir_json(self.base + ".respuesta", {"respuesta": texto, "cuando": ahora()})
            os.remove(self.base + ".cerrar")
        except OSError:
            pass

    def cerrar(self):
        self.cerrojo.soltar()
        for ext in (".json", ".lock", ".cerrar", ".respuesta"):
            try:
                os.remove(self.base + ext)
            except OSError:
                pass


def registrar_instancia(raiz, tipo, ocupado=False, que=""):
    """Para el motor y la GUI: nunca falla (sin carpeta escribible, sin registro)."""
    try:
        return Instancia(raiz, tipo, ocupado, que)
    except Exception:
        return None


def instancias(raiz):
    """[info] de las instancias que siguen vivas (su cerrojo está tomado)."""
    r = Rutas(raiz)
    vivas = []
    try:
        nombres = os.listdir(r.instancias)
    except OSError:
        return []
    for nombre in nombres:
        if not nombre.endswith(".lock"):
            continue
        base = os.path.join(r.instancias, nombre[:-5])
        if not cerrojo_libre(base + ".lock"):
            info = leer_json(base + ".json", {}) or {}
            info.setdefault("id", nombre[:-5])
            info["base"] = base
            vivas.append(info)
    return vivas


def limpiar_instancias(raiz):
    """Borra el registro de instancias que ya no existen (su cerrojo está libre)."""
    r = Rutas(raiz)
    try:
        nombres = os.listdir(r.instancias)
    except OSError:
        return
    for nombre in nombres:
        if not nombre.endswith(".lock"):
            continue
        base = os.path.join(r.instancias, nombre[:-5])
        c = Cerrojo(base + ".lock")
        if c.tomar():
            for ext in (".json", ".cerrar", ".respuesta"):
                try:
                    os.remove(base + ext)
                except OSError:
                    pass
            c.soltar()
            try:
                os.remove(base + ".lock")
            except OSError:
                pass


def describir_instancia(info):
    que = {"gui": "una ventana del programa", "motor": "un análisis"}.get(info.get("tipo"), "el programa")
    equipo = info.get("equipo") or "?"
    lugar = "en este equipo" if equipo == socket.gethostname() else f"en el equipo {equipo}"
    extra = f" ({info['que']})" if info.get("que") else ""
    return f"{que} {lugar}{extra}"


def ocupadas(raiz, excepto=None):
    """Las instancias vivas con un trabajo en marcha (los análisis lo están siempre)."""
    return [i for i in instancias(raiz) if i.get("id") != excepto and (i.get("ocupado") or i.get("tipo") == "motor")]


