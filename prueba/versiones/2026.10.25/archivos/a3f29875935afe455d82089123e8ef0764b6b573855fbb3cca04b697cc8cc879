_RESERVADOS = {"con", "prn", "aux", "nul", "conin$", "conout$"} | {f"{p}{n}" for p in ("com", "lpt")
                                                                    for n in "123456789¹²³"}


def validar_ruta(ruta):
    """La ruta relativa de un archivo del manifiesto ("a/b.py"), o ManifiestoInvalido si podría salirse de la
    carpeta del programa o pisar algo que no es suyo."""
    if not isinstance(ruta, str) or not 0 < len(ruta) <= 200:
        raise ManifiestoInvalido("El manifiesto trae una ruta vacía o demasiado larga.")
    if any(ord(c) < 32 for c in ruta) or any(c in ruta for c in '\\:*?"<>|'):
        raise ManifiestoInvalido(f"El manifiesto trae una ruta no válida: {ruta!r}.")
    if ruta.startswith("/") or ruta.endswith("/"):
        raise ManifiestoInvalido(f"El manifiesto trae una ruta absoluta o de carpeta: {ruta!r}.")
    partes = ruta.split("/")
    for p in partes:
        if p in ("", ".", ".."):
            raise ManifiestoInvalido(f"El manifiesto trae una ruta que sale de la carpeta: {ruta!r}.")
        if p != p.strip() or p.endswith("."):
            raise ManifiestoInvalido(f"El manifiesto trae una ruta ambigua en Windows: {ruta!r}.")
        if p.split(".")[0].lower() in _RESERVADOS:
            raise ManifiestoInvalido(f"El manifiesto trae un nombre reservado de Windows: {ruta!r}.")
        if re.search(r"~\d", p):
            raise ManifiestoInvalido(f"El manifiesto trae un nombre corto de Windows (8.3): {ruta!r}.")
    if partes[0].lower() in PROTEGIDOS or ruta.lower() in PROTEGIDOS:
        raise ManifiestoInvalido(f"El manifiesto intenta tocar datos que no son del programa: {ruta!r}.")
    return ruta


def destino_seguro(raiz, ruta):
    """La ruta absoluta de un archivo del programa dentro de la instalación, comprobando que ninguna carpeta del
    camino (ni el archivo) sea un enlace o punto de unión que lleve fuera."""
    raiz = os.path.realpath(raiz)
    partes = validar_ruta(ruta).split("/")
    actual = raiz
    for i, p in enumerate(partes):
        actual = os.path.join(actual, p)
        if es_enlace(actual):
            raise SinPermisos(f"{ruta}: en la instalación hay un enlace o punto de unión ({actual}); por seguridad "
                              "no se escribe a través de él.")
        if i < len(partes) - 1 and os.path.exists(actual) and not os.path.isdir(actual):
            raise ManifiestoInvalido(f"{ruta}: {actual} no es una carpeta.")
    if not dentro(raiz, actual):
        raise SinPermisos(f"{ruta}: queda fuera de la carpeta del programa; no se toca.")
    if os.path.isdir(actual):
        raise ManifiestoInvalido(f"{ruta}: en la instalación es una carpeta, no un archivo.")
    return actual


def validar_manifiesto(m):
    def exigir(cond, texto):
        if not cond:
            raise ManifiestoInvalido(f"El manifiesto no es válido: {texto}.")
    exigir(isinstance(m, dict), "no es un objeto")
    for clave, tipo in (("formato", int), ("programa", str), ("version", str), ("fecha", str), ("canal", str),
                        ("notas", str), ("requisitos", dict), ("actualizable_desde", str), ("archivos", list)):
        exigir(isinstance(m.get(clave), tipo), f"falta «{clave}» o no es del tipo esperado")
    exigir(m["formato"] == FORMATO, f"formato {m['formato']} desconocido (este programa entiende el {FORMATO})")
    exigir(m["programa"] == PROGRAMA, f"es de otro programa ({m['programa']})")
    try:
        exigir(version_tupla(m["actualizable_desde"]) <= version_tupla(m["version"]),
               "«actualizable_desde» es posterior a la propia versión")
    except ValueError as e:
        raise ManifiestoInvalido(f"El manifiesto no es válido: {e}.")
    exigir(len(m["notas"]) <= 20000, "las notas son demasiado largas")
    exigir(0 < len(m["archivos"]) <= MAX_ARCHIVOS, "la lista de archivos está vacía o es demasiado larga")
    vistos, total = set(), 0
    for a in m["archivos"]:
        exigir(isinstance(a, dict), "un archivo no es un objeto")
        exigir(isinstance(a.get("tamano"), int) and 0 <= a["tamano"] <= MAX_ARCHIVO, "un tamaño no es válido")
        exigir(isinstance(a.get("sha256"), str) and re.fullmatch(r"[0-9a-f]{64}", a["sha256"]),
               "un SHA-256 no es válido")
        ruta = validar_ruta(a.get("ruta"))
        exigir(ruta.lower() not in vistos, f"«{ruta}» está repetido")
        vistos.add(ruta.lower())
        total += a["tamano"]
    exigir(total <= MAX_TOTAL, "los archivos ocupan demasiado")
    for c in COMPONENTES:
        exigir(c.lower() in vistos, f"falta {c}")
    req = m["requisitos"]
    if "python_min" in req:
        try:
            version_tupla(req["python_min"])
        except ValueError:
            raise ManifiestoInvalido("El manifiesto no es válido: «python_min» no es una versión.")
    return m


class Publicacion:
    """Un manifiesto ya comprobado: firma, contenido y versión."""

    def __init__(self, manifiesto, datos, sobre, clave):
        self.manifiesto, self.datos, self.sobre, self.clave = manifiesto, datos, sobre, clave
        self.huella = hashlib.sha256(datos).hexdigest()
        self.version = manifiesto["version"]


def abrir_sobre(sobre, claves=None):
    """El sobre (manifiesto + firma, un solo archivo) -> Publicacion, solo si lo firma una clave de confianza."""
    claves = CLAVES_PUBLICAS if claves is None else claves
    if not claves:
        raise FirmaInvalida("Este programa no tiene ninguna clave de confianza configurada.")
    if len(sobre) > MAX_SOBRE:
        raise ManifiestoInvalido("El manifiesto es demasiado grande.")
    try:
        s = json.loads(sobre.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise ManifiestoInvalido("El manifiesto descargado está incompleto o no es un manifiesto.")
    if not (isinstance(s, dict) and s.get("formato") == FORMATO and isinstance(s.get("clave"), str)
            and isinstance(s.get("manifiesto"), str) and isinstance(s.get("firma"), str)):
        raise ManifiestoInvalido("El manifiesto descargado está incompleto o no es un manifiesto.")
    publica = claves.get(s["clave"])
    if publica is None:
        raise FirmaInvalida("El manifiesto está firmado con una clave en la que este programa no confía.")
    try:
        datos = base64.b64decode(s["manifiesto"], validate=True)
        firma = base64.b64decode(s["firma"], validate=True)
        publica = bytes.fromhex(publica)
    except ValueError:
        raise ManifiestoInvalido("El manifiesto descargado está dañado.")
    if not ed25519_verificar(publica, CONTEXTO_FIRMA + datos, firma):
        raise FirmaInvalida("La firma del manifiesto no es válida: alguien lo ha modificado o no es nuestro. "
                            "No se instala nada.")
    try:
        m = json.loads(datos.decode("utf-8"))
    except (UnicodeDecodeError, ValueError):
        raise ManifiestoInvalido("El manifiesto firmado no se puede leer.")
    return Publicacion(validar_manifiesto(m), datos, sobre, s["clave"])


def crear_sobre(datos, secreta, clave_id):
    firma = ed25519_firmar(secreta, CONTEXTO_FIRMA + datos)
    return json.dumps({"formato": FORMATO, "clave": clave_id, "manifiesto": base64.b64encode(datos).decode(),
                       "firma": base64.b64encode(firma).decode()}, indent=1).encode("utf-8")


def compatible(m, version_instalada):
    """None si se puede instalar en este equipo desde la versión instalada; si no, el motivo."""
    req = m["requisitos"]
    if req.get("plataforma") == "win" and os.name != "nt":
        return "es solo para Windows"
    if "python_min" in req and sys.version_info[:3] < version_tupla(req["python_min"])[:3]:
        return (f"necesita Python {req['python_min']} o posterior (este equipo tiene "
                f"{'.'.join(map(str, sys.version_info[:3]))})")
    try:
        if version_tupla(version_instalada) < version_tupla(m["actualizable_desde"]):
            return (f"no se puede actualizar directamente desde la {version_instalada} (hace falta la "
                    f"{m['actualizable_desde']} o posterior): instala el paquete completo")
    except ValueError:
        return "la versión instalada no se reconoce"
    return None


