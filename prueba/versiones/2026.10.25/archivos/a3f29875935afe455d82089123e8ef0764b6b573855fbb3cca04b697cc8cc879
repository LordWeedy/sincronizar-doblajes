# Utilidades

def version_tupla(v):
    if not isinstance(v, str) or not re.fullmatch(r"\d{1,6}(\.\d{1,6}){0,3}", v):
        raise ValueError(f"versión no válida: {v!r}")
    t = tuple(int(x) for x in v.split("."))
    return t + (0,) * (4 - len(t))


def sha256_archivo(ruta, bloque=1 << 20):
    h = hashlib.sha256()
    with open(ruta, "rb") as f:
        while True:
            b = f.read(bloque)
            if not b:
                break
            h.update(b)
    return h.hexdigest()


def reemplazar(origen, destino, espera=1.0):
    """os.replace reintentando un momento si el destino está abierto (otro lector, el antivirus)."""
    fin = time.time() + espera
    while True:
        try:
            os.replace(origen, destino)
            return
        except PermissionError:
            if time.time() >= fin:
                raise
            time.sleep(0.1)


def escribir_atomico(ruta, datos):
    tmp = f"{ruta}.{os.getpid()}.tmp"
    try:
        with open(tmp, "wb") as f:
            f.write(datos)
            f.flush()
            os.fsync(f.fileno())
        reemplazar(tmp, ruta, 3.0)
    finally:
        if os.path.exists(tmp):
            try:
                os.remove(tmp)
            except OSError:
                pass


def escribir_json(ruta, obj):
    escribir_atomico(ruta, json.dumps(obj, ensure_ascii=False, indent=1).encode("utf-8"))


def leer_json(ruta, defecto=None):
    for _ in range(20):
        try:
            with open(ruta, "rb") as f:
                return json.loads(f.read().decode("utf-8"))
        except FileNotFoundError:
            return defecto
        except PermissionError:
            time.sleep(0.05)
        except (OSError, ValueError):
            return defecto
    return defecto


def ahora():
    return time.strftime("%Y-%m-%d %H:%M:%S")


def tamano_legible(n):
    if n < 1024:
        return f"{n} B"
    if n < 1 << 20:
        return f"{n / 1024:.1f} KB".replace(".", ",")
    return f"{n / 1048576:.2f} MB".replace(".", ",")


_SECRETOS = (
    (re.compile(r"(?i)\b(https?://)[^/\s:@]+:[^/\s@]+@"), r"\1***@"),
    (re.compile(r"(?i)\b(https?://[^\s?#]+)\?[^\s#\"']*"), r"\1?***"),
    (re.compile(r"(?i)\b(authorization|proxy-authorization|cookie|set-cookie)(\s*[:=]\s*)[^\r\n]*"), r"\1\2***"),
    (re.compile(r"(?i)\b(token|access_token|password|contraseña|clave_privada|secret)(\s*[:=]\s*)\S+"), r"\1\2***"),
)


def sin_secretos(texto):
    for patron, cambio in _SECRETOS:
        texto = patron.sub(cambio, texto)
    return texto


