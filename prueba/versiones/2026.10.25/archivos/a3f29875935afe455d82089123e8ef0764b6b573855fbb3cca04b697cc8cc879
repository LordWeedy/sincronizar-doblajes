def _ocupada_por(raiz, pid):
    """La instancia viva del proceso pid si tiene un trabajo en marcha, o None."""
    for i in instancias(raiz):
        if i.get("pid") == pid and i.get("equipo") == socket.gethostname() and i.get("ocupado"):
            return i
    return None


def _volver_a_abrir(diario_o_plan, reg):
    orden = (diario_o_plan or {}).get("relanzar")
    if not orden:
        return
    try:
        env = dict(os.environ, SINCRONIZAR_ACTUALIZACION=diario_o_plan["id"])
        env.pop("SINCRO_GUI_RELANZADA", None)
        _lanzar(orden, cwd=diario_o_plan.get("cwd"), env=env)
    except OSError as e:
        reg(f"No se pudo volver a abrir el programa: {e}")


def _vigilar(raiz, id_, pid, ui, reg, t_salud):
    """Espera la señal de arranque de una actualización ya aplicada cuyo ayudante desapareció."""
    r = Rutas(raiz)
    d = leer_json(r.diario) or {}
    if d.get("id") != id_ or d.get("estado") != "comprobando":
        ui.fin(True, "")
        return 0
    ui.fase(f"Comprobando que arranca la versión {d['hacia']}...")
    try:
        esperar_salud(raiz, d["id"], d["hacia"], tiempo=t_salud, al_esperar=lambda t: ui.esperando(d["hacia"], t))
    except ErrorActualizacion as e:
        if pid and _proceso_vivo(pid):
            # sigue abierta sin dar la señal: no se le quita el programa de debajo; se mirará en el próximo arranque
            reg(f"Sin señal de arranque de la {d['hacia']}, pero el programa sigue abierto: no se deshace todavía.")
            ui.fin(False, "")
            return 1
        reg(f"La versión {d['hacia']} no ha arrancado: {e.mensaje}")
        problemas = revertir(raiz, reg)
        guardar_resultado(raiz, False, f"No se ha actualizado a la {d['hacia']}: {e.mensaje} Se ha vuelto a la "
                          f"{d.get('desde')}.", d.get("desde"), d["hacia"], "; ".join(problemas))
        _volver_a_abrir(d, reg)
        ui.fin(False, f"{e.mensaje}\nSe ha vuelto a la versión {d.get('desde')}.")
        return 1
    confirmar(raiz, reg)
    guardar_resultado(raiz, True, f"Actualizado a la versión {d['hacia']}.", d["hacia"], d.get("desde"))
    ui.fin(True, f"Actualizado a la versión {d['hacia']}.")
    return 0


def _proceso_vivo(pid):
    if os.name != "nt":
        try:
            os.kill(pid, 0)
            return True
        except OSError:
            return False
    import ctypes
    h = ctypes.windll.kernel32.OpenProcess(0x1000, False, pid)      # PROCESS_QUERY_LIMITED_INFORMATION
    if not h:
        return False
    try:
        codigo = ctypes.c_ulong()
        ctypes.windll.kernel32.GetExitCodeProcess(h, ctypes.byref(codigo))
        return codigo.value == 259                                  # STILL_ACTIVE
    finally:
        ctypes.windll.kernel32.CloseHandle(h)


def ejecutar_ayudante(raiz, ui=None, vigilar=None, pid=None, t_salud=T_SALUD):
    """El proceso ayudante: aplica plan.json con la ventana del programa cerrada, comprueba que la versión nueva
    arranca y, si no, vuelve a la anterior y abre esa. Con `vigilar` (id) solo espera la señal de arranque de una
    actualización ya aplicada (el ayudante de entonces desapareció). Devuelve el código de salida."""
    ui = ui or _UiNula()
    reg = Registro(raiz, eco=ui.linea)
    r = Rutas(raiz)
    cerrojo = Cerrojo(r.cerrojo)
    if not cerrojo.tomar(10):
        reg("Ya hay otra actualización en marcha; esta no hace nada.")
        ui.fin(False, "Ya hay otra actualización en marcha.")
        return 3
    if vigilar:
        try:
            return _vigilar(raiz, vigilar, pid, ui, reg, t_salud)
        except Exception as e:
            reg(f"Fallo al vigilar el arranque: {mensaje_de(e)}")
            ui.fin(False, mensaje_de(e))
            return 1
        finally:
            cerrojo.soltar()
    plan = leer_json(r.plan)
    if not plan:
        cerrojo.soltar()
        ui.fin(False, "No hay ninguna actualización preparada.")
        return 2
    abrir_viejo = True       # la ventana se cerró para actualizar: si no queda abierta la nueva, se abre la de antes
    try:
        pub = abrir_sobre(plan["sobre"].encode("utf-8"))
        if pub.huella != plan["huella"] or pub.version != plan["hacia"]:
            raise ManifiestoInvalido("El plan de la actualización no coincide con el manifiesto firmado.")
        plan["manifiesto"] = pub.manifiesto
        ui.fase("Esperando a que se cierre el programa...")
        if plan.get("instancia") and not esperar_cierre(raiz, [plan["instancia"]]):
            abrir_viejo = False
            raise Ocupado("La ventana del programa no se ha cerrado; no se actualiza.")
        cerrar_otras(raiz, registro=reg)
        ui.fase(f"Instalando la versión {plan['hacia']}...")
        aplicar(raiz, plan, reg, progreso=ui.aplicando)
        ui.fase(f"Comprobando que arranca la versión {plan['hacia']}...")
        carpeta_interna(r.raiz, "salud")
        salida = os.path.join(r.salud, f"{plan['id']}.salida.txt")
        try:
            comprobar_versiones(versiones_instaladas(raiz, plan.get("python")), plan["hacia"])
            with open(salida, "w", encoding="utf-8") as err:
                env = dict(os.environ, SINCRONIZAR_ACTUALIZACION=plan["id"])
                env.pop("SINCRO_GUI_RELANZADA", None)
                proceso = _lanzar(plan["relanzar"], cwd=plan.get("cwd"), env=env, salida=err)
            try:
                esperar_salud(raiz, plan["id"], plan["hacia"], proceso, tiempo=t_salud,
                              al_esperar=lambda t: ui.esperando(plan["hacia"], t))
            except ErrorActualizacion:
                if proceso.poll() is None:
                    if _ocupada_por(raiz, proceso.pid):
                        # alguien ya está trabajando con ella: no se cierra ni se deshace; lo resuelve el próximo arranque
                        abrir_viejo = False
                        reg("Sin señal de arranque, pero la ventana nueva ya tiene un trabajo en marcha: se deja.")
                        ui.fin(False, "La versión nueva está abierta pero no ha confirmado que arranca bien.")
                        return 1
                    proceso.terminate()          # recién abierta, sin trabajos y sin arrancar del todo
                    try:
                        proceso.wait(10)
                    except subprocess.TimeoutExpired:
                        proceso.kill()
                raise
        except ErrorActualizacion as e:
            try:
                with open(salida, encoding="utf-8", errors="replace") as f:
                    e.detalle = (e.detalle + "\n" + f.read()[-3000:]).strip()
            except OSError:
                pass
            reg(f"La versión nueva no arranca bien: {e.mensaje} {e.detalle}")
            revertir(raiz, reg)
            raise
        abrir_viejo = False
        confirmar(raiz, reg)
        guardar_resultado(raiz, True, f"Actualizado a la versión {plan['hacia']}.", plan["hacia"], plan.get("desde"))
        ui.fin(True, f"Actualizado a la versión {plan['hacia']}.")
        return 0
    except Exception as e:
        texto = mensaje_de(e)
        reg(f"Actualización no hecha: {texto}")
        desde = plan.get("desde")
        guardar_resultado(raiz, False, f"No se ha actualizado a la {plan.get('hacia')}: {texto}"
                          + (f" Sigue instalada la {desde}." if desde else ""), desde, plan.get("hacia"),
                          getattr(e, "detalle", ""))
        ui.fin(False, texto)
        return 1
    finally:
        try:
            os.remove(r.plan)
        except OSError:
            pass
        if not os.path.exists(r.diario):
            shutil.rmtree(r.salud, ignore_errors=True)
        cerrojo.soltar()
        if abrir_viejo:
            _volver_a_abrir(plan, reg)


