# Aplicar: respaldo, diario y sustitución; deshacer si falla o si se interrumpe

def _sha_o_none(ruta):
    return sha256_archivo(ruta) if os.path.isfile(ruta) else None


def comprobar_escritura(raiz, ops):
    """Antes de tocar nada: se puede escribir en cada carpeta y ningún archivo es de solo lectura."""
    raiz = os.path.realpath(raiz)
    carpetas = set()
    for o in ops:
        dest = destino_seguro(raiz, o["ruta"])
        if o["tipo"] != "nuevo" and os.path.exists(dest):
            atributos = getattr(os.stat(dest), "st_file_attributes", 0)
            if atributos & getattr(stat, "FILE_ATTRIBUTE_READONLY", 1) or not os.access(dest, os.W_OK):
                raise SinPermisos(f"No se puede sustituir {o['ruta']}: es de solo lectura.")
        carpeta = os.path.dirname(dest)
        while not os.path.isdir(carpeta):
            carpeta = os.path.dirname(carpeta)
        carpetas.add(carpeta)
    for carpeta in carpetas:
        prueba = os.path.join(carpeta, f".act-prueba-{os.getpid()}")
        try:
            with open(prueba, "wb") as f:
                f.write(b"x")
            os.remove(prueba)
        except OSError as e:
            if es_sin_espacio(e):
                raise SinEspacio("No queda espacio en el disco del programa.")
            raise SinPermisos(f"No se puede escribir en {carpeta}: la carpeta del programa necesita permisos que "
                              "este usuario no tiene. Instala el programa en una carpeta tuya (Documentos, "
                              "Escritorio) o actualiza con el paquete completo.", str(e))


def _copiar_comprobado(origen, destino, sha):
    tmp = destino + ".copia"
    with open(origen, "rb") as fo, open(tmp, "wb") as fd:
        shutil.copyfileobj(fo, fd, 1 << 20)
        fd.flush()
        os.fsync(fd.fileno())
    if sha and sha256_archivo(tmp) != sha:
        os.remove(tmp)
        raise ErrorActualizacion(f"La copia de {os.path.basename(destino)} no coincide; no se sigue.")
    return tmp


def _poner(tmp, dest, ruta):
    """Sustituye dest por tmp de una vez; si el archivo está abierto por otro programa, reintenta unos segundos."""
    try:
        reemplazar(tmp, dest, ESPERA_EN_USO)
    except PermissionError as e:
        raise ArchivoEnUso(f"No se pudo sustituir {ruta}: está abierto por otro programa o protegido.", str(e))
    except OSError as e:
        if es_sin_espacio(e):
            raise SinEspacio("No queda espacio en el disco del programa.")
        raise


def aplicar(raiz, plan_datos, registro=None, progreso=None, fallo=None):
    """Aplica el plan (de lanzar_ayudante / plan.json) como una transacción anotada en el diario. Si algo falla,
    deshace lo hecho y vuelve a lanzar el error. `fallo(i, op)` es para las pruebas."""
    reg = registro or Registro(raiz)
    progreso = progreso or (lambda *a: None)
    raiz = os.path.realpath(raiz)
    r = Rutas(raiz)
    id_ = plan_datos["id"]
    ops = plan_datos["operaciones"]
    preparacion = plan_datos["preparacion"]
    if not dentro(raiz, preparacion):
        raise SinPermisos("La carpeta de preparación queda fuera de la instalación.")
    comprobar_escritura(raiz, ops)
    resp = carpeta_interna(raiz, "respaldos", id_)
    carpeta_interna(raiz, "respaldos", id_, "archivos")
    diario = {"id": id_, "estado": "respaldando", "desde": plan_datos.get("desde"), "hacia": plan_datos["hacia"],
              "respaldo": os.path.relpath(resp, raiz), "operaciones": ops, "hechas": 0, "carpetas_creadas": [],
              "inicio": ahora(), "estado_previo": os.path.exists(r.json_estado),
              "relanzar": plan_datos.get("relanzar"), "cwd": plan_datos.get("cwd")}
    escribir_json(r.diario, diario)
    escribir_json(os.path.join(resp, "respaldo.json"), {"id": id_, "desde": diario["desde"],
                                                         "hacia": diario["hacia"], "fecha": ahora()})
    reg(f"Actualizando de la {diario['desde']} a la {diario['hacia']} ({len(ops)} cambios); respaldo en {resp}")
    try:
        if os.path.exists(r.json_estado):
            shutil.copy2(r.json_estado, os.path.join(resp, "estado.json"))
        for o in ops:
            dest = destino_seguro(raiz, o["ruta"])
            if o["tipo"] == "nuevo":
                if os.path.exists(dest):
                    raise ErrorActualizacion(f"{o['ruta']} ha aparecido mientras se preparaba la actualización; "
                                             "vuelve a intentarlo.")
                continue
            try:
                if _sha_o_none(dest) != o["sha_antes"]:
                    raise ErrorActualizacion(f"{o['ruta']} ha cambiado mientras se preparaba la actualización; "
                                             "vuelve a intentarlo.")
                copia = os.path.join(resp, "archivos", *o["ruta"].split("/"))
                os.makedirs(os.path.dirname(copia), exist_ok=True)
                reemplazar(_copiar_comprobado(dest, copia, o["sha_antes"]), copia)
            except PermissionError as e:
                raise ArchivoEnUso(f"No se puede leer {o['ruta']} para respaldarlo: está abierto por otro "
                                   "programa.", str(e))
        for o in ops:
            if o["tipo"] != "retirar":
                origen = os.path.join(preparacion, o["sha256"])
                if not os.path.isfile(origen) or sha256_archivo(origen) != o["sha256"]:
                    raise ManifiestoInvalido(f"{o['ruta']}: lo preparado ya no coincide con el manifiesto.")
        diario["estado"] = "aplicando"
        escribir_json(r.diario, diario)
        for i, o in enumerate(ops):
            if fallo:
                fallo(i, o)
            dest = destino_seguro(raiz, o["ruta"])
            progreso(i + 1, len(ops), o["ruta"])
            if o["tipo"] == "retirar":
                try:
                    os.remove(dest)
                except PermissionError as e:
                    raise ArchivoEnUso(f"No se pudo retirar {o['ruta']}: está abierto por otro programa.", str(e))
            else:
                carpeta = os.path.dirname(dest)
                nuevas = []
                while not os.path.isdir(carpeta):
                    nuevas.append(carpeta)
                    carpeta = os.path.dirname(carpeta)
                for c in reversed(nuevas):
                    os.mkdir(c)
                    diario["carpetas_creadas"].append(os.path.relpath(c, raiz))
                    escribir_json(r.diario, diario)
                tmp = f"{dest}.act-{id_}.tmp"
                with open(os.path.join(preparacion, o["sha256"]), "rb") as fo, open(tmp, "wb") as fd:
                    shutil.copyfileobj(fo, fd, 1 << 20)
                    fd.flush()
                    os.fsync(fd.fileno())
                if sha256_archivo(tmp) != o["sha256"]:
                    raise ErrorActualizacion(f"La copia de {o['ruta']} no coincide; no se sigue.")
                t = time.time()
                os.utime(tmp, (t, t))
                _poner(tmp, dest, o["ruta"])
            diario["hechas"] = i + 1
            escribir_json(r.diario, diario)
        archivos = {a["ruta"]: {"sha256": a["sha256"], "tamano": a["tamano"]}
                    for a in plan_datos["manifiesto"]["archivos"]}
        for a in plan_datos["manifiesto"]["archivos"]:
            if _sha_o_none(destino_seguro(raiz, a["ruta"])) != a["sha256"]:
                raise ErrorActualizacion(f"Tras sustituirlo, {a['ruta']} no coincide con el manifiesto.")
        est = leer_estado(raiz)
        est.update(version=plan_datos["hacia"], archivos=archivos, instalado=ahora(),
                   esquema_ajustes=est.get("esquema_ajustes", 1))
        escribir_json(r.json_estado, est)
        diario["estado"] = "comprobando"
        escribir_json(r.diario, diario)
        reg("Archivos sustituidos y comprobados; falta ver que la versión nueva arranca.")
        return diario
    except BaseException as e:
        reg(f"Fallo al aplicar: {type(e).__name__}: {mensaje_de(e) if isinstance(e, Exception) else e}")
        if isinstance(e, (KeyboardInterrupt, SystemExit)):
            raise
        revertir(raiz, reg)
        raise


def revertir(raiz, registro=None):
    """Deja la instalación como antes de la actualización del diario (se puede repetir sin peligro)."""
    reg = registro or Registro(raiz)
    raiz = os.path.realpath(raiz)
    r = Rutas(raiz)
    d = leer_json(r.diario)
    if not d:
        return []
    resp = os.path.join(raiz, d["respaldo"])
    problemas = []
    for o in reversed(d["operaciones"]):
        try:
            dest = destino_seguro(raiz, o["ruta"])
        except ErrorActualizacion as e:
            problemas.append(e.mensaje)
            continue
        tmp = f"{dest}.act-{d['id']}.tmp"
        for resto in (tmp, dest + ".copia"):
            if os.path.exists(resto):
                try:
                    os.remove(resto)
                except OSError:
                    pass
        try:
            if o["tipo"] == "nuevo":
                if os.path.isfile(dest) and sha256_archivo(dest) == o["sha256"]:
                    os.remove(dest)
                continue
            if _sha_o_none(dest) == o["sha_antes"]:
                continue
            copia = os.path.join(resp, "archivos", *o["ruta"].split("/"))
            if not os.path.isfile(copia):
                problemas.append(f"{o['ruta']}: no hay respaldo")
                continue
            os.makedirs(os.path.dirname(dest), exist_ok=True)
            _poner(_copiar_comprobado(copia, dest, o["sha_antes"]), dest, o["ruta"])
        except Exception as e:
            problemas.append(f"{o['ruta']}: {mensaje_de(e)}")
    for c in reversed(d.get("carpetas_creadas") or []):
        try:
            os.rmdir(os.path.join(raiz, c))
        except OSError:
            pass
    copia_estado = os.path.join(resp, "estado.json")
    try:
        if os.path.exists(copia_estado):
            shutil.copy2(copia_estado, r.json_estado + ".copia")
            reemplazar(r.json_estado + ".copia", r.json_estado, 3.0)
        elif not d.get("estado_previo") and os.path.exists(r.json_estado):
            os.remove(r.json_estado)
    except OSError as e:
        problemas.append(f"estado.json: {e}")
    datos = os.path.join(resp, "datos")
    if os.path.isdir(datos):
        for nombre in os.listdir(datos):
            try:
                dest = os.path.join(raiz, nombre)
                shutil.copy2(os.path.join(datos, nombre), dest + ".copia")
                reemplazar(dest + ".copia", dest, 3.0)
            except OSError as e:
                problemas.append(f"{nombre}: {e}")
    for o in d["operaciones"]:
        try:
            dest = destino_seguro(raiz, o["ruta"])
        except ErrorActualizacion:
            continue
        esperado = None if o["tipo"] == "nuevo" else o["sha_antes"]
        if _sha_o_none(dest) != esperado:
            problemas.append(f"{o['ruta']}: no ha quedado como antes")
    d["estado"] = "revertido"
    d["problemas"] = problemas
    d["fin"] = ahora()
    escribir_json(os.path.join(resp, "diario.json"), d)
    os.remove(r.diario)
    reg(f"Deshecha la actualización a la {d['hacia']}: instalada otra vez la {d['desde']}"
        + (f"; PROBLEMAS: {'; '.join(problemas)}" if problemas else "."))
    return problemas


def confirmar(raiz, registro=None):
    """La versión nueva ha arrancado: se cierra el diario y se limpian la preparación y los respaldos viejos."""
    reg = registro or Registro(raiz)
    r = Rutas(raiz)
    d = leer_json(r.diario)
    if not d:
        return
    resp = os.path.join(r.raiz, d["respaldo"])
    d["estado"] = "confirmado"
    d["fin"] = ahora()
    escribir_json(os.path.join(resp, "diario.json"), d)
    os.remove(r.diario)
    shutil.rmtree(os.path.join(r.preparacion, d["hacia"]), ignore_errors=True)
    limpiar_respaldos(r.raiz)
    reg(f"Actualizado a la {d['hacia']} y comprobado que arranca.")


def respaldos(raiz):
    """[(carpeta, datos de respaldo.json, diario archivado)] de los respaldos del actualizador, del más nuevo al
    más viejo."""
    r = Rutas(raiz)
    out = []
    try:
        nombres = os.listdir(r.respaldos)
    except OSError:
        return out
    for n in nombres:
        c = os.path.join(r.respaldos, n)
        datos = leer_json(os.path.join(c, "respaldo.json"))
        if datos and not es_enlace(c):
            out.append((c, datos, leer_json(os.path.join(c, "diario.json"))))
    out.sort(key=lambda x: (x[1].get("fecha", ""), x[0]), reverse=True)
    return out


def limpiar_respaldos(raiz, conservar=RESPALDOS_CONSERVADOS):
    """Borra los respaldos más viejos (solo carpetas del actualizador con su respaldo.json)."""
    for c, _, diario in respaldos(raiz)[conservar:]:
        if diario and diario.get("estado") in ("confirmado", "revertido"):
            shutil.rmtree(c, ignore_errors=True)


def migrar_ajustes(raiz, ruta_ajustes, migraciones=None, esquema=None):
    """Pasa los ajustes al esquema actual con las MIGRACIONES; antes los respalda junto a la actualización en curso
    (y se restauran si se deshace). Nunca rompe el arranque: si falla, se dejan como estaban."""
    migraciones = MIGRACIONES if migraciones is None else migraciones
    esquema = ESQUEMA_AJUSTES if esquema is None else esquema
    r = Rutas(raiz)
    try:
        est = leer_estado(raiz)
        actual = est.get("esquema_ajustes", 1)
        if actual >= esquema or not os.path.exists(ruta_ajustes):
            return None
        with open(ruta_ajustes, encoding="utf-8") as f:
            ajustes = json.load(f)
        d = leer_json(r.diario) or {}
        destino = (os.path.join(r.raiz, d["respaldo"], "datos") if d.get("respaldo")
                   else carpeta_interna(r.raiz, "respaldos", "ajustes-" + time.strftime("%Y%m%d-%H%M%S"), "datos"))
        os.makedirs(destino, exist_ok=True)
        if not os.path.exists(os.path.join(destino, os.path.basename(ruta_ajustes))):
            shutil.copy2(ruta_ajustes, os.path.join(destino, os.path.basename(ruta_ajustes)))
        for n in range(actual + 1, esquema + 1):
            ajustes = migraciones[n](dict(ajustes))
        escribir_atomico(ruta_ajustes, json.dumps(ajustes, ensure_ascii=False, indent=1).encode("utf-8"))
        est["esquema_ajustes"] = esquema
        escribir_json(r.json_estado, est)
        Registro(raiz)(f"Ajustes pasados del esquema {actual} al {esquema} (respaldo en {destino}).")
        return esquema
    except Exception as e:
        Registro(raiz)(f"No se pudieron migrar los ajustes: {mensaje_de(e)}")
        return None


