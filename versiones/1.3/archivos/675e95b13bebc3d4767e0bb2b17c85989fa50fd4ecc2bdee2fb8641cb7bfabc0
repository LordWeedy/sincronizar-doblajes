    def _drop_highlight(self, event, aviso, activo):
        pal = self._get_palette()
        aviso.configure(background=pal['select_bg'] if activo else pal['entry_bg'],
                        foreground=pal['select_fg'] if activo else pal['muted'])
        return event.action

    def _add_paths(self, rutas, rol=None):
        """Añade archivos y carpetas (sin subcarpetas) y los empareja por episodio. `rol` fuerza
        'doblaje' u 'original' (los .srt siempre son subtítulos); sin él, se decide por la
        extensión: audio = doblaje, vídeo = original."""
        archivos = []
        for ruta in rutas:
            ruta = os.path.normpath(ruta)
            if os.path.isdir(ruta):
                archivos += [os.path.join(ruta, f) for f in sorted(os.listdir(ruta))
                             if os.path.isfile(os.path.join(ruta, f))]
            elif os.path.isfile(ruta):
                archivos.append(ruta)
        ya = {os.path.normcase(x) for j in self.trabajos for x in (j.doblaje, j.original, j.sub) if x}
        nuevos = 0
        for ruta in archivos:
            ext = os.path.splitext(ruta)[1].lower()
            if ext in EXTENSIONES_SUB:
                rol_archivo = "sub"
            elif rol:
                rol_archivo = rol if ext in sd.AUDIO_EXT + EXTENSIONES_VIDEO else None
            else:
                rol_archivo = rol_por_extension(ruta)
            # (fuera también lo que crea el programa: el audio sincronizado y el vídeo «[con subtítulos]», que si no
            # entraba como otra RAW del mismo episodio y se volvía a procesar: Becker 1x01, 23-10-2026)
            nombre = os.path.basename(ruta)
            if rol_archivo is None or "_SYNC" in nombre or " [con subtítulos]" in nombre or os.path.normcase(ruta) in ya:
                continue
            self._place(ruta, rol_archivo, sd.episodio(os.path.basename(ruta)))
            ya.add(os.path.normcase(ruta))
            nuevos += 1
        self._auto_subs()
        self.trabajos.sort(key=lambda j: (j.clave is None, j.clave or (0, 0), j.doblaje or j.original or ""))
        self._refresh_list()
        listos = sum(1 for j in self.trabajos if j.completo() and not j.estado)
        solo_subs = sum(1 for j in self.trabajos if j.solo_subs() and not j.estado)
        incompletos = sum(1 for j in self.trabajos if not j.procesable())
        mensaje = f"{nuevos} archivo(s) añadido(s). {listos} episodio(s) listos para sincronizar."
        if solo_subs:
            mensaje += f" {solo_subs} de solo subtítulos (vídeo y subtítulo sin doblaje)."
        if incompletos:
            mensaje += f" {incompletos} fila(s) incompletas (les falta el doblaje o la RAW)."
        self.status_text.set(mensaje)

    def _place(self, ruta, rol, clave):
        """Coloca un archivo en la fila de su episodio (o en una nueva)."""
        mismos = [j for j in self.trabajos if j.clave == clave and not j.estado]
        if rol == "doblaje":
            fila = next((j for j in mismos if j.doblaje is None), None)
            if fila is None:
                fila = Trabajo(clave)
                if mismos:      # otro doblaje del mismo episodio: comparte original y subtítulo
                    fila.original, fila.sub = mismos[0].original, mismos[0].sub
                self.trabajos.append(fila)
            fila.doblaje = ruta
            return
        if not mismos:
            fila = Trabajo(clave)
            self.trabajos.append(fila)
            mismos = [fila]
        for fila in mismos:
            actual = getattr(fila, rol)
            # si hay MKV y MP4 del mismo episodio, manda el MKV
            if actual is None or (rol == "original" and ruta.lower().endswith(".mkv")
                                  and not actual.lower().endswith(".mkv")):
                setattr(fila, rol, ruta)
                if rol == "sub":
                    fila.sub_quitado = fila.sub_auto = False

    def _auto_subs(self):
        for j in self.trabajos:
            if j.original and not j.sub and not j.sub_quitado:
                candidato = os.path.splitext(j.original)[0] + ".srt"
                if os.path.exists(candidato):
                    j.sub, j.sub_auto = candidato, True

    def _valores(self, j):
        nombre = lambda r: os.path.basename(r) if r else "—"
        return (j.etiqueta(), nombre(j.doblaje), nombre(j.original), nombre(j.sub),
                j.texto_estado(), resumen_corto(j.res))

    def _tag(self, j):
        estado = j.texto_estado()
        if estado in EN_CURSO:
            return "curso"
        if estado in ("Hecho", "Muxeado"):
            return "ok"
        if estado.startswith("Hecho"):
            return "aviso"
        if estado in ("Error", "Sin muxear"):
            return "error"
        if estado in ("Ya existe", "Cancelado", "Falta doblaje", "Falta la RAW"):
            return "apagado"
        return ""

    def _refresh_list(self):
        seleccion = [self._por_iid[i] for i in self.tree.selection() if i in self._por_iid]
        self.tree.delete(*self.tree.get_children())
        self._por_iid = {}
        for j in self.trabajos:
            iid = str(id(j))
            self._por_iid[iid] = j
            self.tree.insert("", "end", iid=iid, values=self._valores(j), tags=(self._tag(j),))
        vivos = [str(id(j)) for j in seleccion if str(id(j)) in self._por_iid]
        if vivos:
            self.tree.selection_set(vivos)
        self._update_empty_hint()
        self._mostrar_detalle()

    def _update_row(self, j):
        iid = str(id(j))
        if self.tree.exists(iid):
            self.tree.item(iid, values=self._valores(j), tags=(self._tag(j),))

    def _update_empty_hint(self):
        if self.trabajos:
            self.lista_vacia.place_forget()
        else:
            self.lista_vacia.place(relx=0.5, rely=0.55, anchor="center")

    def _selected(self):
        return [self._por_iid[i] for i in self.tree.selection() if i in self._por_iid]

    def _selected_one(self):
        sel = self._selected()
        return sel[0] if sel else None

    def _on_right_click(self, event):
        iid = self.tree.identify_row(event.y)
        if not iid:
            return
        if iid not in self.tree.selection():
            self.tree.selection_set(iid)
        self.menu_fila.tk_popup(event.x_root, event.y_root)

    def _change_file(self, rol):
        j = self._selected_one()
        if not j:
            return
        if j.estado in EN_CURSO:
            self._show_warning("En proceso", "Ese episodio se está procesando; espera a que termine.")
            return
        tipos = {"doblaje": [("Audio o vídeo doblado", " ".join("*" + e for e in sd.AUDIO_EXT + EXTENSIONES_VIDEO))],
                 "original": [("Vídeo o audio de la RAW", " ".join("*" + e for e in EXTENSIONES_VIDEO + sd.AUDIO_EXT))],
                 "sub": [("Subtítulos SRT", "*.srt")]}[rol] + [("Todos los archivos", "*.*")]
        ruta = filedialog.askopenfilename(title="Selecciona el archivo", filetypes=tipos)
        if not ruta:
            return
        setattr(j, rol, os.path.normpath(ruta))
        if rol == "sub":
            j.sub_quitado = j.sub_auto = False
        if j.clave is None:
            j.clave = sd.episodio(os.path.basename(ruta))
        j.estado, j.res, j.log = None, None, []
        self._auto_subs()
        self._refresh_list()

    def _remove_sub(self):
        for j in self._selected():
            if j.estado not in EN_CURSO:
                j.sub, j.sub_quitado = None, True
                self._update_row(j)
        self._mostrar_detalle()

    def _reset_selected(self):
        for j in self._selected():
            if j.estado not in EN_CURSO:
                j.estado = None
                self._update_row(j)
        self.status_text.set("Marcados para volver a procesar. Si sus resultados ya existen, "
                             "marca «Sobrescribir resultados que ya existan».")

    def _remove_selected(self):
        quitar = [j for j in self._selected() if j.estado not in EN_CURSO[1:]]
        for j in quitar:
            j.quitado = True
            self.trabajos.remove(j)
        if quitar:
            self._refresh_list()

    def _clear_list(self):
        for j in list(self.trabajos):
            if j.estado not in EN_CURSO[1:]:
                j.quitado = True
                self.trabajos.remove(j)
        self._refresh_list()

    def _open_folder(self):
        j = self._selected_one()
        ruta = (j.salida or j.doblaje or j.original) if j else None
        if not ruta:
            return
        if os.path.exists(ruta):
            subprocess.Popen(["explorer", "/select,", os.path.normpath(ruta)])
        elif os.path.isdir(os.path.dirname(ruta)):
            os.startfile(os.path.dirname(ruta))

