def themed_messagebox(parent, title, message, palette, buttons="ok"):
    """
    Cuadro de diálogo modal dibujado a mano con los colores del tema actual
    (claro/oscuro). tkinter.messagebox SIEMPRE usa el aspecto nativo del
    sistema operativo y no respeta los estilos ttk de la app.

    buttons: "ok" (un solo botón; siempre devuelve True), "okcancel"
    (Aceptar/Cancelar) o "yesno" (Sí/No); en los dos últimos devuelve True si
    se acepta/Sí, False si se cancela/No o se cierra la ventana.
    """
    dialog = tk.Toplevel(parent)
    dialog.title(title)
    dialog.configure(background=palette['bg'])
    dialog.transient(parent)
    dialog.resizable(False, False)

    resultado = {"value": False}

    frame = tk.Frame(dialog, background=palette['bg'], padx=25, pady=20)
    frame.pack(fill="both", expand=True)

    tk.Label(frame, text=message, background=palette['bg'], foreground=palette['fg'],
             wraplength=420, justify="left").pack(pady=(0, 20))

    btn_frame = tk.Frame(frame, background=palette['bg'])
    btn_frame.pack()

    def aceptar():
        resultado["value"] = True
        dialog.destroy()

    def cancelar():
        resultado["value"] = False
        dialog.destroy()

    if buttons == "okcancel":
        ttk.Button(btn_frame, text="Aceptar", command=aceptar, width=10).pack(side="left", padx=5)
        ttk.Button(btn_frame, text="Cancelar", command=cancelar, width=10).pack(side="left", padx=5)
        dialog.protocol("WM_DELETE_WINDOW", cancelar)
    elif buttons == "yesno":
        ttk.Button(btn_frame, text="Sí", command=aceptar, width=10).pack(side="left", padx=5)
        ttk.Button(btn_frame, text="No", command=cancelar, width=10).pack(side="left", padx=5)
        dialog.protocol("WM_DELETE_WINDOW", cancelar)
    else:
        ttk.Button(btn_frame, text="Aceptar", command=aceptar, width=10).pack()
        dialog.protocol("WM_DELETE_WINDOW", aceptar)

    dialog.update_idletasks()
    try:
        x = parent.winfo_rootx() + (parent.winfo_width() // 2) - (dialog.winfo_width() // 2)
        y = parent.winfo_rooty() + (parent.winfo_height() // 2) - (dialog.winfo_height() // 2)
        dialog.geometry(f"+{max(x, 0)}+{max(y, 0)}")
    except Exception:
        pass

    dialog.grab_set()
    dialog.wait_window()
    return resultado["value"]


def themed_askstring(parent, title, message, initial, palette, auto_label=None):
    """Pide un texto con los colores del tema. Devuelve el texto, "" si se pulsa auto_label
    (volver a lo automático) o None si se cancela."""
    dialog = tk.Toplevel(parent)
    dialog.title(title)
    dialog.configure(background=palette['bg'])
    dialog.transient(parent)
    dialog.resizable(False, False)
    resultado = {"value": None}
    frame = tk.Frame(dialog, background=palette['bg'], padx=25, pady=20)
    frame.pack(fill="both", expand=True)
    tk.Label(frame, text=message, background=palette['bg'], foreground=palette['fg'],
             wraplength=640, justify="left").pack(anchor="w", pady=(0, 10))
    texto = tk.StringVar(value=initial)
    entrada = ttk.Entry(frame, textvariable=texto, width=95)
    entrada.pack(fill="x", pady=(0, 20))
    btn_frame = tk.Frame(frame, background=palette['bg'])
    btn_frame.pack()

    def cerrar(valor):
        resultado["value"] = valor
        dialog.destroy()

    ttk.Button(btn_frame, text="Aceptar", width=10, command=lambda: cerrar(texto.get().strip())).pack(side="left", padx=5)
    if auto_label:
        ttk.Button(btn_frame, text=auto_label, command=lambda: cerrar("")).pack(side="left", padx=5)
    ttk.Button(btn_frame, text="Cancelar", width=10, command=lambda: cerrar(None)).pack(side="left", padx=5)
    dialog.protocol("WM_DELETE_WINDOW", lambda: cerrar(None))
    dialog.bind("<Return>", lambda e: cerrar(texto.get().strip()))
    dialog.bind("<Escape>", lambda e: cerrar(None))
    dialog.update_idletasks()
    try:
        x = parent.winfo_rootx() + (parent.winfo_width() // 2) - (dialog.winfo_width() // 2)
        y = parent.winfo_rooty() + (parent.winfo_height() // 2) - (dialog.winfo_height() // 2)
        dialog.geometry(f"+{max(x, 0)}+{max(y, 0)}")
    except Exception:
        pass
    entrada.focus_set()
    entrada.icursor("end")
    dialog.grab_set()
    dialog.wait_window()
    return resultado["value"]


