class Trabajo:
    """Una fila de la lista: un doblaje con su original y, si lo hay, su subtítulo."""

    def __init__(self, clave):
        self.clave = clave              # (temporada, episodio) o None
        self.doblaje = self.original = self.sub = None
        self.sub_quitado = False        # el usuario quitó el subtítulo: no se vuelve a poner solo
        self.sub_auto = False           # el subtítulo lo ha puesto el programa (el .srt que se llama como el original)
        self.nombre_mux = None         # nombre y título del vídeo muxeado puestos a mano; None = plantilla
        self.correcciones = ""          # ajustes a mano del castellano (sd.leer_correcciones), p. ej. "-100; 15:44-16:09 +700"
        self.plan_mux = None            # el que se usa al procesar (se calcula al empezar)
        self.estado = None              # None = según lo que falte
        self.log = []
        self.res = None
        self.salida = None
        self.inicio = None
        self.quitado = False

    def completo(self):
        return bool(self.doblaje and self.original)

    def solo_subs(self):
        """Vídeo y subtítulo sin doblaje: el vídeo ya está hecho (un final con su audio) y solo se le ajusta el
        subtítulo, comparándolo con su voz, y se muxea en un MKV nuevo si está marcado muxear. Solo si el subtítulo
        lo ha puesto el usuario: un original sin doblaje con su .srt al lado no se procesa por su cuenta."""
        return bool(self.original and self.sub and not self.doblaje and not self.sub_auto)

    def procesable(self):
        return self.completo() or self.solo_subs()

    def texto_estado(self):
        if self.estado:
            return self.estado
        if self.solo_subs():
            return "Solo subtítulos"
        if not self.doblaje:
            return "Falta doblaje"
        if not self.original:
            return "Falta la RAW"
        return "Listo · con correcciones a mano" if self.correcciones else "Listo"

    def etiqueta(self):
        return f"{self.clave[0]}x{self.clave[1]:02d}" if self.clave else "—"


def rol_por_extension(ruta):
    ext = os.path.splitext(ruta)[1].lower()
    if ext in EXTENSIONES_SUB:
        return "sub"
    if ext in EXTENSIONES_VIDEO:
        return "original"
    if ext in sd.AUDIO_EXT:
        return "doblaje"
    return None


