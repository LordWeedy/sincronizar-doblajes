    def _cargar_ajustes(self):
        """Opciones de muxeado de la última vez (la plantilla suele valer para toda una serie)."""
        try:
            with open(AJUSTES, encoding="utf-8") as f:
                a = json.load(f)
        except (OSError, ValueError):
            return
        # los forzados (OCR) y la limpieza del ruido no se recuerdan: son de uso puntual y siempre empiezan desmarcados
        for clave, var in (("rellenar", self.rellenar), ("otras_pistas", self.otras_pistas), ("muxear", self.muxear),
                           ("estirar_variable", self.estirar_variable),
                           ("decodificar", self.decodificar), ("formato", self.formato),
                           ("mux_idioma", self.mux_idioma), ("mux_titulo", self.mux_titulo),
                           ("plantilla", self.plantilla)):
            if clave in a:
                try:
                    var.set(a[clave])
                except (tk.TclError, ValueError):
                    pass
        if self.formato.get() not in FORMATOS_AUDIO:
            self.formato.set("flac")

    def _guardar_ajustes(self):
        try:
            with open(AJUSTES, "w", encoding="utf-8") as f:
                json.dump({"rellenar": self.rellenar.get(), "otras_pistas": self.otras_pistas.get(),
                           "muxear": self.muxear.get(), "estirar_variable": self.estirar_variable.get(),
                           "decodificar": self.decodificar.get(), "formato": self.formato.get(),
                           "mux_idioma": self.mux_idioma.get(),
                           "mux_titulo": self.mux_titulo.get(), "plantilla": self.plantilla.get()},
                          f, ensure_ascii=False, indent=1)
        except OSError:
            pass

    def _leer_una_vez(self, funcion, ruta):
        """Nombre del episodio o título de un archivo (ffprobe); se lee una sola vez por archivo."""
        clave = (funcion.__name__, ruta)
        if clave not in self._cache_nombres:
            try:
                self._cache_nombres[clave] = funcion(ruta) if ruta else ""
            except Exception:
                self._cache_nombres[clave] = ""
        return self._cache_nombres[clave]

    def _plan_mux(self, j):
        """Nombre y título del vídeo muxeado: el puesto a mano, el de la plantilla o None (se queda el
        nombre del original y el título del castellano)."""
        if j.nombre_mux:
            return j.nombre_mux
        plantilla = self.plantilla.get().strip()
        if not plantilla or not j.doblaje:
            return None
        ep = j.clave or sd.episodio(os.path.basename(j.doblaje))
        return sd.expandir_plantilla(plantilla, ep, self._leer_una_vez(sd.nombre_episodio, j.doblaje))

    def _texto_plan_mux(self, j):
        nombre = self._plan_mux(j)
        ruta = sd.ruta_mux(j.original, self.output_folder.get().strip() or None,
                           self.mux_titulo.get().strip() or "Castellano", nombre)
        if os.path.exists(ruta):
            return f"ya existe {os.path.basename(ruta)}; no se tocará"
        # el mismo orden que usa el script: plantilla o mano, título del castellano, título del original
        titulo = (nombre or self._leer_una_vez(sd.titulo_contenedor, j.doblaje)
                  or self._leer_una_vez(sd.titulo_contenedor, j.original))
        return (f"se creará al procesar: {os.path.basename(ruta)}   ·   título: " + (titulo or "ninguno")
                + ("   (puesto a mano)" if j.nombre_mux else ""))

    def _edit_mux_name(self):
        j = self._selected_one()
        if not j or not j.completo():
            self._show_info("Nombre del vídeo", "Selecciona un episodio con doblaje y RAW.")
            return
        if j.estado in EN_CURSO:
            self._show_warning("En proceso", "Ese episodio se está procesando; espera a que termine.")
            return
        actual = self._plan_mux(j) or os.path.splitext(os.path.basename(
            sd.ruta_mux(j.original, None, self.mux_titulo.get().strip() or "Castellano")))[0]
        nuevo = themed_askstring(
            self.master, "Nombre y título del vídeo",
            "Nombre del .mkv muxeado de este episodio, que también será su título. Los caracteres que Windows "
            "no admite en un nombre de archivo (como las comillas) solo se quitan del nombre, no del título.",
            actual, self._get_palette(), auto_label="Automático (plantilla)")
        if nuevo is None:
            return
        j.nombre_mux = nuevo or None
        if j.estado not in EN_CURSO:
            j.estado, j.res, j.log = None, None, []
        self._update_row(j)
        self._mostrar_detalle()

    def _edit_correcciones(self):
        """Ajustes a mano del castellano para lo que la medida no puede ver (sd.leer_correcciones)."""
        j = self._selected_one()
        if not j or not j.completo():
            self._show_info("Correcciones a mano", "Selecciona un episodio con doblaje y RAW.")
            return
        if j.estado in EN_CURSO:
            self._show_warning("En proceso", "Ese episodio se está procesando; espera a que termine.")
            return
        texto = j.correcciones
        while True:
            texto = themed_askstring(
                self.master, "Correcciones a mano",
                "Para lo que la imagen no puede medir. Milisegundos que se retrasa (+) o se adelanta (-) el castellano, "
                "en todo el episodio o entre dos tiempos del vídeo final (mm:ss), separados con punto y coma. Por "
                "ejemplo: -100; 15:44-16:09 +700\nLos cortes que hagan falta se ponen en el silencio más cercano. Para "
                "aplicarlas, vuelve a procesar el episodio con «Sobrescribir» marcado (el .mkv que ya exista no se "
                "toca: cámbiale el nombre o bórralo antes).",
                texto, self._get_palette(), auto_label="Sin correcciones")
            if texto is None:
                return
            try:
                sd.leer_correcciones(texto)
                break
            except ValueError as e:
                self._show_warning("Correcciones a mano", str(e))
        j.correcciones = texto.strip()
        if j.estado not in EN_CURSO:
            j.estado, j.res, j.log = None, None, []
        self._update_row(j)
        self._mostrar_detalle()

    def _open_mux(self):
        j = self._selected_one()
        mkv = j.res.get('mux') if j and j.res else None
        if mkv and os.path.exists(mkv):
            subprocess.Popen(["explorer", "/select,", os.path.normpath(mkv)])
        else:
            self._show_info("Sin vídeo muxeado", "Este episodio todavía no se ha muxeado en su RAW.")

    def _open_report(self):
        j = self._selected_one()
        informe = os.path.splitext(j.salida)[0] + "_informe.txt" if j and j.salida else None
        if informe and os.path.exists(informe):
            os.startfile(informe)
        else:
            self._show_info("Sin informe", "Este episodio todavía no tiene informe.")

    # ------------------------------------------------------------------
    # Detalle del episodio seleccionado
    # ------------------------------------------------------------------
    def _mostrar_detalle(self):
        j = self._selected_one()
        res = j.res if j else None
        v = self.info_vars
        for var in v.values():
            var.set("—")
        self.cortes_tree.delete(*self.cortes_tree.get_children())
        self.otros_avisos.set("")
        if not j:
            self.detalle_titulo.set("Selecciona un episodio de la lista.")
        else:
            self.detalle_titulo.set(f"{j.etiqueta()} · {j.texto_estado()}")
            v['doblaje'].set(j.doblaje or "—")
            v['original'].set(j.original or "—")
            v['sub'].set(j.sub or "—")
            v['audio'].set("se elige solo al procesar")
            if self.muxear.get() and j.completo():
                v['mux'].set(self._texto_plan_mux(j))
            if j.solo_subs():
                v['audio'].set("solo subtítulos: el vídeo ya está hecho; el subtítulo se compara con su voz")
                if self.muxear.get():
                    ruta = sd.ruta_mux(j.original, self.output_folder.get().strip() or None, "con subtítulos")
                    v['mux'].set(f"se creará al procesar: {os.path.basename(ruta)} (el vídeo con el subtítulo "
                                 "añadido; el de partida no se toca)")
        if res:
            if res['pista']:
                # la descripción de la pista sincronizada, sacada de la línea de pistas del registro
                desc = next((x.split(" (")[0] for x in (res['pistas'] or "").split(" · ")
                             if x.startswith(f"{res['pista']}: ")), str(res['pista']))
                texto = f"pista {desc}" if res['pistas'] else "la única pista del doblaje"
                if res['audio_doblado']:
                    texto += f": {res['audio_doblado']}"
                if res['pistas_extra']:
                    texto += "   · también: " + ", ".join(f"pista {n} ({d})" for n, d, _ in res['pistas_extra'])
                if res['video']:
                    texto += "   · medido con los cambios de plano del vídeo"
                v['audio'].set(texto)
            if res['variable']:
                v['velocidad'].set(f"variable (VHS): se estira el castellano ({res['variable']}); la RAW no se "
                                   "toca")
            elif res['velocidad']:
                v['velocidad'].set(f"{res['velocidad']}: se adaptan los fps de la RAW; el castellano no se toca")
            elif res['mapa']:
                v['velocidad'].set("la misma que la RAW" + (
                    f" (una diferencia de {abs(res['reparto'][0])} ms en todo el episodio, repartida)"
                    if res['reparto'] else ""))
            if res['subs']:
                v['subs'].set(f"{res['subs'][0]} líneas ajustadas")
            elif j.salida:
                v['subs'].set("sin subtítulo")
            if res['subs_dob']:
                hechas = [s for s in res['subs_dob'] if s[2]]
                imagen = [s for s in res['subs_dob'] if s[3]]
                partes = [f"{len(hechas)} pista(s) del doblaje ajustada(s): " + ", ".join(s[1] for s in hechas)] \
                    if hechas else []
                partes += [f"{len(imagen)} de imagen fuera (no se pueden ajustar)"] if imagen else []
                if partes:
                    dob = "; ".join(partes)
                    v['subs'].set(dob if v['subs'].get() in ("—", "sin subtítulo") else f"{v['subs'].get()} · {dob}")
            if res['forzados']:
                n, ruta = res['forzados']
                forz = (f"{n} forzados leídos con OCR" if n else "forzados del .srt que ya había") + \
                       f" ({os.path.basename(ruta)}; se puede corregir a mano antes de muxear)"
                v['subs'].set(forz if v['subs'].get() in ("—", "sin subtítulo") else f"{v['subs'].get()} · {forz}")
            elif res['forz_nota']:
                v['subs'].set(f"{v['subs'].get()} · forzados: {res['forz_nota']}")
            if res['mux_error']:
                v['mux'].set(f"no se ha podido muxear: {res['mux_error']}")
            elif res['mux']:
                info = res['mux_info'] or ""
                nota = ("ya existía; no se ha tocado" if "ya existía" in info else
                        "con el vídeo adaptado a la velocidad del doblaje" if "original adaptado" in info else "")
                v['mux'].set(os.path.basename(res['mux']) + (f"   ({nota})" if nota else ""))
            if res['tiempo']:
                v['tiempo'].set(res['tiempo'])
            filas = [(c['t'], (c['txt'], c['accion'].capitalize(), f"{c['ms']} ms", c['tipo'], f"{c['suelo']} dB",
                               "⚠ conviene escucharlo" if c['aviso'] else ""),
                      "aviso" if c['aviso'] else ("ok" if c['accion'] == "inserta" else "error"))
                     for c in res['cortes']]
            filas += [(z['t0'], (z['txt'], "Sin corte", "", f"música del doblaje desplazada {z['d']:+.1f} s",
                                 "", "⚠ conviene escucharlo"), "aviso") for z in res['musica']]
            # 0.001: detrás del corte del mismo instante
            filas += [(r['t'] + 0.001, (r['txt'], "Rellena", f"{r['ms']} ms",
                                        f"audio de la RAW {r['o0']}-{r['o1']} ({r['db']:+.1f} dB)",
                                        "", "⚠ escucha las uniones"), "relleno") for r in res['rellenos']]
            for _, valores, tag in sorted(filas, key=lambda f: f[0]):
                self.cortes_tree.insert("", "end", values=valores, tags=(tag,))
            if not filas and res['mapa']:
                self.cortes_tree.insert("", "end", tags=("apagado",), values=(
                    "—", "Sin cortes", "", "el castellano se ha estirado siguiendo la velocidad de la RAW"
                    if res['variable'] else "el doblaje solo necesitaba el desfase inicial"
                    + (" y adaptar la velocidad de la RAW" if res['velocidad'] else ""),
                    "", ""))
            otros = [a for a in res['avisos'] if not a.startswith(("corte ", "relleno "))
                     and "música desplazada" not in a]
            # los que piden revisar, delante y destacados; los demás solo piden escuchar
            otros = (["REVISAR: " + a[len("[revisar] "):] for a in otros if a.startswith("[revisar] ")]
                     + [a for a in otros if not a.startswith("[revisar] ")])
            if res['error']:
                otros.insert(0, res['error'])
            if res['velocidad'] and not res['mux'] and not res['error']:
                # el audio va al tiempo del original adaptado, que solo existe al muxear con el programa (Pequeñas
                # mentiras: muxeado a mano en el Blu-ray a 24 fps, el castellano iba un 4 % más rápido)
                otros.insert(0, "el doblaje va a otra velocidad: este audio solo cuadra con la RAW adaptada, que "
                                "el programa crea al muxear. Marca «Muxear en la RAW» y vuelve a procesar "
                                "(como el audio ya existe, solo muxea). Metido a mano en la RAW tal cual NO cuadra")
            if otros:
                self.otros_avisos.set("⚠ " + "\n⚠ ".join(otros))
        self._fill_log(j)

    def _fill_log(self, j):
        self.log_text.config(state=tk.NORMAL)
        self.log_text.delete("1.0", tk.END)
        if j and j.log:
            self.log_text.insert(tk.END, "\n".join(j.log) + "\n")
            self.log_text.see(tk.END)
        self.log_text.config(state=tk.DISABLED)

    def notify_finished(self, message):
        """Avisa al usuario (sonido + ventana emergente) de que el proceso ha terminado."""
        try:
            self.master.bell()
        except Exception:
            pass
        try:
            self.master.deiconify()
            self.master.lift()
            self.master.focus_force()
        except Exception:
            pass
        try:
            themed_messagebox(self.master, "Proceso finalizado", message, self._get_palette(), buttons="ok")
        except Exception:
            pass

    def _poll_queue(self):
        try:
            while True:
                kind, payload = self.progress_queue.get_nowait()
                if kind == "inicio":
                    j, n, total = payload
                    self.actual = payload
                    j.estado, j.log, j.res, j.inicio = "Analizando…", [], None, time.time()
                    self._update_row(j)
                    iid = str(id(j))
                    if self.tree.exists(iid):
                        self.tree.selection_set(iid)
                        self.tree.see(iid)
                    self._mostrar_detalle()
                elif kind == "linea":
                    j, linea = payload
                    j.log.append(linea)
                    etapa = None
                    if linea.startswith("Deriva de velocidad"):
                        etapa = "Montando…"
                    elif linea.startswith("Buscando subtítulos quemados"):
                        etapa = "Forzados…"
                    elif linea.startswith("Sincronizando también la pista"):
                        etapa = "Otras pistas…"
                    elif linea.startswith("Verificación"):
                        etapa = "Codificando…"
                    elif linea.startswith("Guardado") and j.sub:
                        etapa = "Subtítulos…"
                    elif linea.startswith("Muxeando en"):
                        etapa = "Muxeando…"
                    if etapa:
                        j.estado = etapa
                        self._update_row(j)
                        if self._selected_one() is j:
                            self.detalle_titulo.set(f"{j.etiqueta()} · {j.texto_estado()}")
                    if self._selected_one() is j:
                        self.log_text.config(state=tk.NORMAL)
                        self.log_text.insert(tk.END, linea + "\n")
                        self.log_text.see(tk.END)
                        self.log_text.config(state=tk.DISABLED)
                elif kind == "pregunta":
                    j, actual, nuevo, caja = payload
                    convertir, todos = self._dialogo_sin_cortes(j, actual, nuevo)
                    if todos:
                        self.respuesta_tanda = convertir
                    caja["convertir"] = convertir
                    caja["evento"].set()
                elif kind == "fin":
                    j, estado, lineas, salida = payload
                    j.estado = estado
                    if lineas is not None:
                        j.log = list(lineas)
                    j.res = leer_informe(j.log) if j.log and estado != "Cancelado" else None
                    if salida:
                        j.salida = salida
                    self._terminados += 1
                    self.progress['value'] = self._terminados
                    self._update_row(j)
                    if self._selected_one() is j:
                        self._mostrar_detalle()
                elif kind == "done":
                    self.actual = None
                    if self.act is not None:
                        self.act.marcar_ocupado(False)
                    for j in self.trabajos:
                        if j.estado in EN_CURSO:
                            j.estado = None
                            self._update_row(j)
                    self.status_text.set(str(payload))
                    self.start_button.config(state=tk.NORMAL)
                    self.stop_button.config(state=tk.DISABLED)
                    self._mostrar_detalle()
                    self.notify_finished(str(payload))
        except queue.Empty:
            pass
        if self.actual:
            j, n, total = self.actual
            if j.inicio and j.estado in EN_CURSO:
                s = int(time.time() - j.inicio)
                self.status_text.set(f"Procesando ({n}/{total}): {j.etiqueta()} · {j.estado} · "
                                     f"{s // 60}:{s % 60:02d}")
        self.master.after(150, self._poll_queue)

    def _start_thread(self):
        if self.worker_thread is not None and self.worker_thread.is_alive():
            return
        trabajos = [j for j in self.trabajos
                    if j.procesable() and not ((j.estado or "").startswith("Hecho") or j.estado == "Muxeado")]
        if not trabajos:
            incompletos = sum(1 for j in self.trabajos if not j.procesable())
            self._show_warning("Nada que procesar",
                               "No hay episodios listos: cada fila necesita un doblaje y su RAW (o, para "
                               "solo ajustar un subtítulo, el vídeo y el subtítulo)." +
                               (f"\n\nHay {incompletos} fila(s) incompletas." if incompletos else "") +
                               "\n\nPara rehacer uno ya hecho: clic derecho → «Volver a procesar».")
            return
        missing = [d['label'] for d in DEPENDENCIES + MODULOS
                   if not d.get('opcional') and not self.dependency_status.get(d['key'], {}).get('found')]
        if missing:
            if not self._ask_yesno(
                "Faltan dependencias",
                "Faltan: " + ", ".join(missing) + ".\n¿Quieres continuar de todas formas? (probablemente fallará)"
            ):
                return
        carpeta = self.output_folder.get().strip()
        if carpeta and not os.path.isdir(carpeta):
            self._show_error("Carpeta de salida", f"La carpeta de salida no existe:\n{carpeta}")
            return
        # el idioma del castellano: el del muxeado, que va también en el nombre del audio sincronizado
        idioma = self.mux_idioma.get().strip() or "es-ES"
        if not re.fullmatch(r"[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*", idioma):
            self._show_error("Idioma", "Usa una etiqueta de idioma como es-ES, es-419, ca-ES o spa.")
            return
        mux = None
        if self.muxear.get():
            mux = (idioma, self.mux_titulo.get().strip() or "Castellano")
            for j in trabajos:          # aquí (hilo de la ventana): lee la plantilla y el título del castellano
                j.plan_mux = self._plan_mux(j)
        self._guardar_ajustes()

        self.stop_event.clear()
        for j in trabajos:
            j.estado = "En cola"
            self._update_row(j)
        self._terminados = 0
        self.progress.configure(maximum=len(trabajos), value=0)
        self.start_button.config(state=tk.DISABLED)
        self.stop_button.config(state=tk.NORMAL)
        self.status_text.set(f"Sincronizando {len(trabajos)} episodio(s)...")

        self.worker_thread = threading.Thread(
            target=self._worker,
            args=(trabajos, carpeta, idioma, self.sobrescribir.get(), mux, self.rellenar.get(),
                  (self.mux_idioma.get().strip() or "es-ES") if self.forzados.get() else None,
                  self.decodificar.get(), self.otras_pistas.get(), self.formato.get(), self.estirar_variable.get(),
                  self.limpiar.get()),
            daemon=True,
        )
        self.respuesta_tanda = None
        if self.act is not None:        # con una tanda en marcha no se actualiza (ni desde otra ventana)
            self.act.marcar_ocupado(True, f"una tanda de {len(trabajos)} episodio(s)")
        self.worker_thread.start()

    def _stop(self):
        self.stop_event.set()
        terminar_proceso_activo()
        self.status_text.set("Deteniendo: se cancela el episodio en curso y se borra lo que llevaba...")

    def _preguntar_sin_cortes(self, j, actual, nuevo):
        """(Hilo de trabajo) El castellano de j no tiene cortes: ¿se convierte a `nuevo` o va intacto (`actual`)?
        Lo pregunta la ventana (o se usa lo elegido para toda la tanda) y aquí se espera la respuesta."""
        if self.respuesta_tanda is not None:
            return self.respuesta_tanda
        caja = {"evento": threading.Event(), "convertir": False}
        self.progress_queue.put(("pregunta", (j, actual, nuevo, caja)))
        while not caja["evento"].wait(0.2):
            if self.stop_event.is_set():
                return False
        return caja["convertir"]

    def _dialogo_sin_cortes(self, j, actual, nuevo):
        """Ventana: dejar intacto el castellano sin cortes o convertirlo. Devuelve (convertir, para toda la tanda)."""
        palette = self._get_palette()
        dialog = tk.Toplevel(self.master)
        dialog.title("Castellano sin cortes")
        dialog.configure(background=palette['bg'])
        dialog.transient(self.master)
        dialog.resizable(False, False)
        res = {"convertir": False}
        todos = tk.BooleanVar(value=False)
        frame = tk.Frame(dialog, background=palette['bg'], padx=25, pady=20)
        frame.pack(fill="both", expand=True)
        tk.Label(frame, background=palette['bg'], foreground=palette['fg'], wraplength=440, justify="left",
                 text=f"{j.etiqueta()}: el castellano no necesita cortes ni rellenos, así que puede ir tal cual, sin "
                      f"recodificar y sin perder nada ({actual}).\n\n¿Lo dejo intacto o lo convierto a {nuevo}?"
                 ).pack(anchor="w", pady=(0, 12))
        ttk.Checkbutton(frame, text="Hacer lo mismo con el resto de esta tanda", variable=todos).pack(anchor="w",
                                                                                                    pady=(0, 15))
        botones = tk.Frame(frame, background=palette['bg'])
        botones.pack()

        def cerrar(convertir):
            res["convertir"] = convertir
            dialog.destroy()

        ttk.Button(botones, text=f"Dejar intacto ({actual})", command=lambda: cerrar(False)).pack(side="left", padx=5)
        ttk.Button(botones, text=f"Convertir a {nuevo}", command=lambda: cerrar(True)).pack(side="left", padx=5)
        dialog.protocol("WM_DELETE_WINDOW", lambda: cerrar(False))
        dialog.update_idletasks()
        try:
            x = self.master.winfo_rootx() + (self.master.winfo_width() // 2) - (dialog.winfo_width() // 2)
            y = self.master.winfo_rooty() + (self.master.winfo_height() // 2) - (dialog.winfo_height() // 2)
            dialog.geometry(f"+{max(x, 0)}+{max(y, 0)}")
        except Exception:
            pass
        dialog.lift()
        self.master.bell()
        dialog.grab_set()
        dialog.wait_window()
        return res["convertir"], todos.get()

    # ------------------------------------------------------------------
    def _ejecutar(self, cmd, j, entorno):
        """(Hilo de trabajo) Lanza el script, pasa cada línea a la ventana y contesta sus preguntas. (líneas, código)."""
        lineas = []
        try:
            proceso = open_subprocess(cmd, stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                      stderr=subprocess.STDOUT, bufsize=1, env=entorno)
            _registrar_proceso_activo(proceso)
            try:
                for linea in iter(proceso.stdout.readline, ''):
                    linea = linea.rstrip("\r\n")
                    if linea.startswith(sd.PREGUNTA_SIN_CORTES):
                        # sin cortes: ¿intacto o al formato elegido? Se pregunta en la ventana y se contesta
                        actual, _, nuevo = linea[len(sd.PREGUNTA_SIN_CORTES):].partition("|")
                        convertir = self._preguntar_sin_cortes(j, actual, nuevo)
                        try:
                            proceso.stdin.write(("convertir" if convertir else "intacto") + "\n")
                            proceso.stdin.flush()
                        except OSError:
                            pass
                        continue
                    lineas.append(linea)
                    self.progress_queue.put(("linea", (j, linea)))
                codigo = proceso.wait()
            finally:
                _limpiar_proceso_activo()
                try:
                    proceso.stdin.close()
                except OSError:
                    pass
        except OSError as e:
            lineas.append(f"ERROR: no se pudo lanzar el análisis: {e}")
            codigo = -1
        return lineas, codigo

    def _solo_subs(self, j, carpeta, idioma, sobrescribir, mux, entorno):
        """(Hilo de trabajo) Una fila de solo subtítulos: el subtítulo ajustado al vídeo, que ya está hecho, comparándolo
        con su voz, y, si se muxea, un MKV nuevo con él (el vídeo de partida no se toca). Devuelve cómo ha ido:
        "hecho", "avisos", "error", "existe" o "cancelado", y si se ha muxeado."""
        salida = sd.ruta_subs_solo(j.original, idioma, carpeta or None)
        informe = os.path.splitext(salida)[0] + "_informe.txt"
        mkv = sd.ruta_mux(j.original, carpeta or None, "con subtítulos") if mux else None
        hacer_mux = bool(mkv and not os.path.exists(mkv))
        # hecho: el subtítulo o, si se muxea, el vídeo con él (al muxear no se deja copia del subtítulo)
        if os.path.exists(salida) or (mkv and not hacer_mux):
            if not sobrescribir:
                lineas = leer_lineas(informe) + ([f"Ya existe el vídeo muxeado, no se toca: {mkv}"] if mkv else [])
                self.progress_queue.put(("fin", (j, "Ya existe", lineas, salida)))
                return "existe", False
            borrar((salida, informe))
        self.en_curso_salidas = [salida, informe] + ([mkv] if hacer_mux else [])
        cmd = [python_analisis(), SCRIPT, "--solo-subs", j.original, "--subs", j.sub, "-o", salida, "--idioma", idioma]
        if hacer_mux:
            cmd += ["--muxear", mkv, "--mux-idioma", mux[0], "--mux-titulo", mux[1]]
        lineas, codigo = self._ejecutar(cmd, j, entorno)
        if self.stop_event.is_set():
            borrar(self.en_curso_salidas)
            self.en_curso_salidas = []
            lineas.append("Cancelado por el usuario; se han borrado los archivos a medias.")
            self.progress_queue.put(("fin", (j, "Cancelado", lineas, None)))
            return "cancelado", False
        self.en_curso_salidas = []
        res = leer_informe(lineas)
        muxeado = bool(hacer_mux and os.path.exists(mkv) and not res['mux_error'])
        if codigo != 0 or res['error'] or not (os.path.exists(salida) or muxeado):
            if not res['error']:
                lineas.append(f"ERROR: el análisis terminó con código {codigo}")
            borrar((salida, informe) + ((mkv,) if hacer_mux else ()))
            self.progress_queue.put(("fin", (j, "Error", lineas, None)))
            return "error", False
        if mkv and not hacer_mux:
            lineas.append(f"Ya existe el vídeo muxeado, no se toca: {mkv}")
        estado = "Hecho" + texto_avisos(res)
        if res['mux_error']:
            estado += " · sin muxear"
        self.progress_queue.put(("fin", (j, estado, lineas, salida)))
        return ("avisos" if res['avisos'] else "hecho"), muxeado

    def _worker(self, *args):
        """(Hilo de trabajo) La tanda (_tanda). Pase lo que pase, la ventana recibe «done»: si el hilo muriera sin
        avisar, se quedaría en «Analizando…» con el botón de empezar bloqueado (así se veía el fallo del 23-10-2026)."""
        try:
            self._tanda(*args)
        except Exception as e:
            import traceback
            donde = traceback.extract_tb(e.__traceback__)[-1]
            self.progress_queue.put(("done", f"Proceso parado por un fallo interno de la GUI: {type(e).__name__}: {e} "
                                             f"[{donde.name}, línea {donde.lineno}]."))

    def _tanda(self, trabajos, carpeta, idioma, sobrescribir, mux=None, rellenar=True, forzados=None, deco="cpu",
               otras_pistas=True, formato="flac", estirar=False, limpiar=False):
        """mux: (idioma, título) para meter el audio en el vídeo original, o None.
        rellenar: lo que le falte al doblaje se rellena con el audio original.
        forzados: idioma con el que leer (OCR) los forzados quemados en la imagen del doblaje, o None.
        deco: con qué se decodifica el vídeo (clave de sd.DECODIFICADORES).
        otras_pistas: las demás pistas dobladas del doblaje se sincronizan y muxean también.
        formato: el del audio doblado si hay que recodificarlo (clave de FORMATOS_AUDIO); sin cortes, se pregunta.
        estirar: si la velocidad del doblaje varía (VHS), se estira el castellano en vez de cortarlo.
        limpiar: el castellano se limpia del ruido de la cinta (VHS) antes de montarlo."""
        total = len(trabajos)
        hechos = con_avisos = errores = saltados = muxeados = 0
        entorno = dict(os.environ, PYTHONUNBUFFERED="1", PYTHONIOENCODING="utf-8")

        for n, j in enumerate(trabajos, 1):
            if self.stop_event.is_set():
                break
            if j.quitado:
                continue
            self.progress_queue.put(("inicio", (j, n, total)))
            # un fallo inesperado en un episodio no para la tanda: su fila queda en error con el motivo y se sigue
            # (el 23-10-2026 un fallo así, sin avisar, dejó sin hacer todos los de «solo subtítulos» tras el primero)
            try:
                if j.solo_subs():
                    como, muxeado = self._solo_subs(j, carpeta, idioma, sobrescribir, mux, entorno)
                    if como == "cancelado":
                        break
                    hechos += como in ("hecho", "avisos")
                    con_avisos += como == "avisos"
                    errores += como == "error"
                    saltados += como == "existe"
                    muxeados += muxeado
                    continue
                try:
                    salida = sd.ruta_salida(j.doblaje, idioma, carpeta or None)
                except Exception as e:
                    self.progress_queue.put(("fin", (j, "Error", [f"ERROR: no se pudo leer el doblaje: {e}"], None)))
                    errores += 1
                    continue
                base = os.path.splitext(salida)[0]
                sub_out = base + ".srt" if j.sub else None
                informe = base + "_informe.txt"
                forz_out = sd.ruta_forzados(salida) if forzados else None
                try:                # subtítulos de texto que trae el doblaje: se ajustan en _sub1.srt, _sub2.ass...
                    subs_dob = [sd.ruta_sub_doblaje(salida, s) for s in sd.pistas_sub_doblaje(j.doblaje) if s["ext"]]
                except Exception:
                    subs_dob = []
                try:                # las otras pistas de audio que pueden salir (_pista2_[cat].eac3...)
                    pistas_extra = [sd.ruta_pista_extra(salida, s) for s in sd.pistas_audio(j.doblaje)]
                except Exception:
                    pistas_extra = []
                subs_dob += pistas_extra        # se tratan igual: se respetan las de antes, se borran las de ahora
                # el .mkv final nunca se sobrescribe: puede ser uno que hayas muxeado tú
                mkv = sd.ruta_mux(j.original, carpeta or None, mux[1], j.plan_mux) if mux else None
                hacer_mux = bool(mkv and not os.path.exists(mkv))
                solo_mux = False
                if any(x and os.path.exists(x) for x in (salida, sub_out)):
                    if not sobrescribir:
                        if not (hacer_mux and os.path.exists(salida)):
                            lineas = leer_lineas(informe)
                            if mkv and not hacer_mux:
                                lineas.append(f"Ya existe el vídeo muxeado, no se toca: {mkv}")
                            self.progress_queue.put(("fin", (j, "Ya existe", lineas, salida)))
                            saltados += 1
                            continue
                        if sd.leer_mapa(salida) and sub_out and not os.path.exists(sub_out):
                            # al muxear no se deja copia del subtítulo ajustado: sin él el vídeo iría sin subtítulo, y
                            # rehacerlo con el mapa no averigua para qué versión estaba hecho (eso lo hacen las voces)
                            self.progress_queue.put(("linea", (j, "El subtítulo ajustado ya no está (al muxear no se "
                                                                  "deja copia): se vuelve a sincronizar para meterlo")))
                            borrar((salida, informe))
                        elif sd.leer_mapa(salida):
                            solo_mux = True     # el audio ya está: solo falta meterlo en el vídeo
                        else:
                            # sin su informe no se sabe la velocidad ni los cortes: muxearlo así podía dejarlo desfasado
                            # (Pequeñas mentiras: borrado el informe, el original no se habría adaptado a 25 fps)
                            self.progress_queue.put(("linea", (j, "Falta el informe del audio sincronizado (guarda la "
                                                                  "velocidad y los cortes): se vuelve a sincronizar")))
                            borrar((salida,))
                    else:
                        borrar((salida, sub_out, informe, forz_out) + tuple(subs_dob))
                self.en_curso_salidas = [] if solo_mux else [x for x in (salida, sub_out, informe) if x]
                # los forzados y subtítulos de antes (quizá corregidos a mano) se respetan; los que se creen ahora, no
                forz_nuevo = bool(forz_out and not os.path.exists(forz_out))
                if forz_nuevo:
                    self.en_curso_salidas.append(forz_out)
                subs_nuevos = [x for x in subs_dob if not os.path.exists(x)]
                self.en_curso_salidas += subs_nuevos
                if hacer_mux:
                    self.en_curso_salidas.append(mkv)

                cmd = [python_analisis(), SCRIPT, j.doblaje, j.original, "-o", salida]
                if solo_mux:
                    cmd += ["--solo-muxear"]
                else:
                    if j.sub:
                        cmd += ["--subs", j.sub]
                    if not rellenar:
                        cmd += ["--sin-relleno-original"]
                    cmd += ["--formato", formato if formato in FORMATOS_AUDIO else "flac", "--sin-cortes", "preguntar"]
                    if estirar:
                        cmd += ["--estirar-variable"]
                    if limpiar:
                        cmd += ["--limpiar"]
                    if j.correcciones:
                        cmd += ["--correcciones", j.correcciones]
                if forzados:                # el idioma del OCR es el de la pista muxeada
                    cmd += ["--forzados", "--mux-idioma", forzados]
                if deco != "cpu" and deco in sd.DECODIFICADORES:
                    cmd += ["--decodificar", deco]
                if not otras_pistas:
                    cmd += ["--solo-pista-principal"]
                if hacer_mux:
                    cmd += ["--muxear", mkv, "--mux-idioma", mux[0], "--mux-titulo", mux[1]]
                    if j.plan_mux:          # sin él, el script copia el título del castellano si lo tiene
                        cmd += ["--titulo-video", j.plan_mux]
                lineas, codigo = self._ejecutar(cmd, j, entorno)

                if self.stop_event.is_set():
                    borrar(self.en_curso_salidas)
                    self.en_curso_salidas = []
                    lineas.append("Cancelado por el usuario; se han borrado los archivos a medias.")
                    self.progress_queue.put(("fin", (j, "Cancelado", lineas, None)))
                    break
                self.en_curso_salidas = []

                if solo_mux:
                    # el informe ya lleva la línea del muxeado si ha ido bien (la añade el script)
                    res = leer_informe(lineas)
                    previo = leer_lineas(informe)
                    if not any(RE_MUX.match(x) for x in previo):     # sin informe (audio hecho fuera)
                        previo += [x for x in lineas if RE_MUX.match(x)]
                    if res['mux_error']:
                        previo.append(f"No se pudo muxear: {res['mux_error']}")
                        self.progress_queue.put(("fin", (j, "Sin muxear", previo, salida)))
                        errores += 1
                    else:
                        self.progress_queue.put(("fin", (j, "Muxeado", previo, salida)))
                        muxeados += 1
                    continue

                res = leer_informe(lineas)
                if codigo != 0 or res['error'] or not os.path.exists(salida):
                    if not res['error']:
                        lineas.append(f"ERROR: el análisis terminó con código {codigo}")
                    borrar((salida, sub_out, informe) + ((forz_out,) if forz_nuevo else ()) + tuple(subs_nuevos))
                    if hacer_mux:
                        borrar((mkv,))
                    self.progress_queue.put(("fin", (j, "Error", lineas, None)))
                    errores += 1
                    continue
                if mkv and not hacer_mux:
                    lineas.append(f"Ya existe el vídeo muxeado, no se toca: {mkv}")
                if res['avisos']:
                    estado = "Hecho" + texto_avisos(res)
                    con_avisos += 1
                else:
                    estado = "Hecho"
                if res['mux_error']:
                    estado += " · sin muxear"
                elif hacer_mux:
                    muxeados += 1
                hechos += 1
                self.progress_queue.put(("fin", (j, estado, lineas, salida)))
            except Exception as e:
                import traceback
                donde = traceback.extract_tb(e.__traceback__)[-1]
                self.en_curso_salidas = []
                self.progress_queue.put(("fin", (j, "Error", [f"ERROR interno de la GUI: {type(e).__name__}: {e} "
                                                              f"[{donde.name}, línea {donde.lineno}]"], None)))
                errores += 1

        partes = [f"{hechos}/{total} episodio(s) sincronizados"]
        if muxeados:
            partes.append(f"{muxeados} muxeado(s) en su RAW")
        if con_avisos:
            partes.append(f"{con_avisos} con avisos (en naranja: conviene escuchar esos puntos)")
        if saltados:
            partes.append(f"{saltados} ya existían (marca «Sobrescribir» para rehacerlos)")
        if errores:
            partes.append(f"{errores} con error")
        if self.stop_event.is_set():
            partes.append("detenido por el usuario")
        self.progress_queue.put(("done", "Proceso terminado: " + ", ".join(partes) + "."))


def primera_ejecucion():
    """Este Python no tiene numpy/scipy: se ofrece descargarlos (y ffmpeg si falta) y se relanza."""
    root = tk.Tk()
    tareas = [("Instalando numpy y scipy...", instalar_modulos)]
    if not ffmpeg_disponible():
        tareas.append(("Descargando ffmpeg...", instalar_ffmpeg))

    def fin(ok):
        if ok and os.path.exists(VENV_PYW):
            subprocess.Popen([VENV_PYW, os.path.abspath(__file__)] + sys.argv[1:],
                             env=dict(os.environ, SINCRO_GUI_RELANZADA="1"))
        elif ok is None:
            messagebox.showinfo("Sincronizar Doblaje",
                                "Sin numpy y scipy el programa no puede analizar el audio.\n"
                                "La próxima vez que lo abras se volverá a ofrecer la descarga.")

    Instalador(root, mensaje_componentes(True, len(tareas) > 1), tareas, LIGHT_PALETTE, fin)
    root.mainloop()


def main():
    if sd is None:
        primera_ejecucion()
        return
    dnd = False
    root = None
    if TkinterDnD is not None:
        try:
            root = TkinterDnD.Tk()
            dnd = True
        except Exception:
            root = None
    if root is None:
        root = tk.Tk()
    app = App(root, dnd=dnd)
    root.protocol("WM_DELETE_WINDOW", lambda: on_closing(root, app))
    if len(sys.argv) > 1:       # archivos soltados sobre el acceso directo
        root.after(300, lambda: app._add_paths(sys.argv[1:]))
    root.mainloop()


if __name__ == "__main__":
    main()
