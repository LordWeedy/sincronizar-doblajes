    def _plegar_dependencias(self, abrir=None):
        """Despliega o pliega el detalle de las dependencias (abrir: True o False para forzarlo)."""
        self.deps_abiertas = (not self.deps_abiertas) if abrir is None else abrir
        if self.deps_abiertas:
            self.deps_detalle.grid(row=1, column=0, sticky="ew")
            self.deps_boton.config(text="Ocultar ▴")
        else:
            self.deps_detalle.grid_remove()
            self.deps_boton.config(text="Mostrar ▾")

    def check_dependencies(self):
        missing = []
        palette = self._get_palette()
        for dep in DEPENDENCIES + MODULOS:
            if dep in DEPENDENCIES:
                # MKVToolNix no siempre se añade al PATH: se busca también donde lo instala
                ruta = sd.ruta_mkvmerge() if dep['key'] == 'mkvmerge' and sd else None
                status = check_dependency_binary(ruta or dep['key'])
                detail = status.get('version') or status.get('path')
            else:
                status = check_module(dep['key'])
                detail = status['version'] or "instalado"
            self.dependency_status[dep['key']] = status
            if status['found']:
                icon, color, text = "✔", "#35a127", f"{dep['label']}: {detail}"
            elif dep.get('opcional'):
                icon, color = "–", palette['muted']
                text = f"{dep['label']}: no instalado — {dep['desc']}"
            else:
                icon, color = "✘", "#C62828"
                text = f"{dep['label']}: NO encontrado — {dep['desc']}"
                missing.append(dep['label'])
            row_vars = self.dependency_row_vars.get(dep['key'])
            if row_vars:
                row_vars['icon'].set(icon)
                row_vars['text'].set(text)
            icon_label = self.dependency_icon_labels.get(dep['key'])
            if icon_label:
                icon_label.config(fg=color)
        if missing:
            self.status_text.set(
                "Aviso: faltan dependencias obligatorias: " + ", ".join(missing) +
                ". Pulsa «Descargar lo que falta» o instálalas y usa «Verificar de nuevo»."
            )
        if hasattr(self, 'descargar_button'):
            self.descargar_button.config(state=tk.DISABLED if ffmpeg_disponible() else tk.NORMAL)
        if hasattr(self, 'deps_resumen'):
            opcionales = [d['label'] for d in DEPENDENCIES + MODULOS if d.get('opcional')
                          and not self.dependency_status.get(d['key'], {}).get('found')]
            if missing:
                self.deps_resumen.set("✘ Falta: " + ", ".join(missing))
                self.deps_resumen_label.configure(style="Aviso.TLabel")
                self._plegar_dependencias(True)
            else:
                self.deps_resumen.set("✔ Todo lo necesario está instalado"
                                      + (f" (sin instalar, opcional: {', '.join(opcionales)})" if opcionales else ""))
                self.deps_resumen_label.configure(style="TLabel")
        return missing

