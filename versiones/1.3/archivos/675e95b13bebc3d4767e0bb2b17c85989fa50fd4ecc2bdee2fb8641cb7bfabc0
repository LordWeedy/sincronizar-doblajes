def ejecutar(cmd, log):
    """Ejecuta un comando mandando su salida a log; error si no termina bien."""
    proceso = open_subprocess(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, bufsize=1)
    for linea in iter(proceso.stdout.readline, ''):
        if linea.strip():
            log("  " + linea.rstrip())
    if proceso.wait() != 0:
        raise RuntimeError(f"falló: {' '.join(os.path.basename(c) if i == 0 else c for i, c in enumerate(cmd))}")


