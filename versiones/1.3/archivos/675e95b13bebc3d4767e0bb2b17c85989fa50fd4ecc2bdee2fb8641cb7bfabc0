def open_subprocess(command, **kwargs):
    kwargs.setdefault('text', True)
    kwargs.setdefault('encoding', 'utf-8')
    kwargs.setdefault('errors', 'replace')
    if os.name == 'nt':
        try:
            kwargs['creationflags'] = subprocess.CREATE_NO_WINDOW
        except AttributeError:
            pass
    return subprocess.Popen(command, **kwargs)


def run_subprocess(command, **kwargs):
    kwargs.setdefault('text', True)
    if os.name == 'nt':
        try:
            kwargs['creationflags'] = subprocess.CREATE_NO_WINDOW
        except AttributeError:
            pass
    return subprocess.run(command, **kwargs)


def python_analisis():
    """python.exe del mismo entorno. Con pythonw.exe cada ffmpeg que lanza el análisis
    abriría su propia ventana de consola; python.exe con CREATE_NO_WINDOW no."""
    carpeta, exe = os.path.split(sys.executable)
    consola = os.path.join(carpeta, "python.exe")
    if exe.lower() == "pythonw.exe" and os.path.exists(consola):
        return consola
    return sys.executable


def borrar(rutas):
    """Borra archivos a medias; reintenta un momento si ffmpeg aún los tiene abiertos."""
    for ruta in rutas:
        for _ in range(10):
            try:
                if ruta and os.path.exists(ruta):
                    os.remove(ruta)
                break
            except PermissionError:
                time.sleep(0.3)
            except OSError:
                break


# --- Registro del análisis en curso, para poder terminarlo de inmediato con
# "Detener" o si se cierra la ventana a mitad de un episodio ---
_current_process_lock = threading.Lock()
_current_process = None


def _registrar_proceso_activo(proceso):
    global _current_process
    with _current_process_lock:
        _current_process = proceso


def _limpiar_proceso_activo():
    global _current_process
    with _current_process_lock:
        _current_process = None


def terminar_proceso_activo():
    """Termina (o mata si no responde) el análisis en curso ahora mismo, si lo hay."""
    with _current_process_lock:
        proceso = _current_process
    if proceso and proceso.poll() is None:
        try:
            if os.name == 'nt':
                # /T: también los ffmpeg que haya lanzado el análisis
                run_subprocess(["taskkill", "/F", "/T", "/PID", str(proceso.pid)], capture_output=True)
            else:
                proceso.terminate()
            proceso.wait(timeout=5)
            if proceso.poll() is None:
                proceso.kill()
                proceso.wait(timeout=5)
        except Exception:
            pass


