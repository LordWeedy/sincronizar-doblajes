def check_dependency_binary(command, version_flags=("--version", "-V", "-version")):
    path = shutil.which(command)
    result = {'found': path is not None, 'path': path, 'version': None}
    if not result['found']:
        return result
    for flag in version_flags:
        try:
            proc = run_subprocess([command, flag], capture_output=True, check=False, timeout=3)
            if proc.returncode != 0:
                continue
            output = ((proc.stdout or "") + (proc.stderr or "")).strip()
            if output:
                result['version'] = output.splitlines()[0][:120]
                break
        except Exception:
            continue
    return result


def check_module(nombre):
    if importlib.util.find_spec(nombre) is None:
        return {'found': False, 'version': None}
    try:
        modulo = __import__(nombre)
        return {'found': True, 'version': getattr(modulo, '__version__', None)}
    except Exception:
        return {'found': False, 'version': None}


