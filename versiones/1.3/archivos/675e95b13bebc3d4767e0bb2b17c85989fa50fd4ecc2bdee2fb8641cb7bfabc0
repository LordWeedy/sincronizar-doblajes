def _abrir_url(url, timeout=60):
    return urllib.request.urlopen(urllib.request.Request(url, headers={"User-Agent": "Sincronizar-Doblaje"}),
                                  timeout=timeout)


def _suma_publicada(url_sumas, nombre):
    with _abrir_url(url_sumas, 30) as r:
        texto = r.read().decode("utf-8", "replace")
    for linea in texto.splitlines():
        partes = linea.split()
        if len(partes) == 1 and re.fullmatch(r"[0-9a-fA-F]{64}", partes[0]):
            return partes[0].lower()                    # archivo con solo la suma (gyan.dev)
        if len(partes) >= 2 and partes[-1].lstrip("*") == nombre:
            return partes[0].lower()                    # "suma  nombre" (GitHub)
    raise RuntimeError("no se encontró la suma SHA-256 publicada")


def instalar_ffmpeg(log, progreso):
    """ffmpeg.exe y ffprobe.exe en la carpeta "ffmpeg" junto al programa; se comprueba su SHA-256."""
    os.makedirs(FFMPEG_LOCAL, exist_ok=True)
    zip_tmp = os.path.join(FFMPEG_LOCAL, "descarga.zip")
    ultimo_error = None
    for url, url_sumas in FUENTES_FFMPEG:
        nombre = url.rsplit("/", 1)[1]
        try:
            log(f"Descargando {url}")
            esperada = _suma_publicada(url_sumas, nombre)
            suma = hashlib.sha256()
            with _abrir_url(url) as r, open(zip_tmp, "wb") as f:
                total, hecho = int(r.headers.get("Content-Length") or 0), 0
                while True:
                    bloque = r.read(1 << 20)
                    if not bloque:
                        break
                    f.write(bloque)
                    suma.update(bloque)
                    hecho += len(bloque)
                    progreso(hecho, total)
            if suma.hexdigest() != esperada:
                raise RuntimeError("la suma SHA-256 no coincide con la publicada")
            log("  Suma SHA-256 comprobada. Extrayendo ffmpeg.exe y ffprobe.exe ...")
            extraidos = set()
            with zipfile.ZipFile(zip_tmp) as z:
                for miembro in z.namelist():
                    base = os.path.basename(miembro)
                    if base in ("ffmpeg.exe", "ffprobe.exe") and base not in extraidos:
                        with z.open(miembro) as origen, open(os.path.join(FFMPEG_LOCAL, base), "wb") as destino:
                            shutil.copyfileobj(origen, destino)
                        extraidos.add(base)
            if len(extraidos) < 2:
                raise RuntimeError("el zip no trae ffmpeg.exe y ffprobe.exe")
            break
        except Exception as e:
            ultimo_error = e
            log(f"  No se pudo con esta fuente: {e}")
        finally:
            borrar([zip_tmp])
    else:
        raise RuntimeError(f"no se pudo descargar ffmpeg ({ultimo_error})")
    if FFMPEG_LOCAL not in os.environ.get("PATH", ""):
        os.environ["PATH"] = FFMPEG_LOCAL + os.pathsep + os.environ.get("PATH", "")
    log(f"ffmpeg listo en {FFMPEG_LOCAL}")


class Instalador:
    """Pregunta si descargar lo que falta y, si se acepta, lo hace enseñando el progreso.
    al_terminar(ok) recibe True si todo fue bien, False si falló y None si se rechazó."""

    def __init__(self, ventana, mensaje, tareas, palette, al_terminar):
        self.win, self.tareas, self.pal, self.al_terminar = ventana, tareas, palette, al_terminar
        self.q = queue.Queue()
        self.ok = None
        ventana.title("Sincronizar Doblaje · componentes")
        ventana.configure(background=palette['bg'])
        ventana.resizable(False, False)
        self.marco = tk.Frame(ventana, background=palette['bg'], padx=22, pady=16)
        self.marco.pack(fill="both", expand=True)
        self.titulo = tk.StringVar(value=mensaje)
        tk.Label(self.marco, textvariable=self.titulo, background=palette['bg'], foreground=palette['fg'],
                 wraplength=560, justify="left").pack(anchor="w")
        self.botones = tk.Frame(self.marco, background=palette['bg'])
        self.botones.pack(pady=(16, 0))
        ttk.Button(self.botones, text="Descargar e instalar", command=self._empezar).pack(side="left", padx=5)
        ttk.Button(self.botones, text="Ahora no", command=lambda: self._cerrar(None)).pack(side="left", padx=5)
        ventana.protocol("WM_DELETE_WINDOW", lambda: self._cerrar(None))

    def _empezar(self):
        self.botones.destroy()
        self.detalle = tk.StringVar(value="")
        self.barra = ttk.Progressbar(self.marco, mode="indeterminate", length=560)
        self.barra.pack(fill="x", pady=(12, 2))
        tk.Label(self.marco, textvariable=self.detalle, background=self.pal['bg'], foreground=self.pal['muted'],
                 anchor="w").pack(fill="x")
        self.texto = tk.Text(self.marco, height=14, width=78, state=tk.DISABLED, wrap="word",
                             background=self.pal['entry_bg'], foreground=self.pal['entry_fg'])
        self.texto.pack(fill="both", expand=True, pady=(6, 0))
        self.cerrar = ttk.Button(self.marco, text="Cerrar", state=tk.DISABLED, command=lambda: self._cerrar(self.ok))
        self.cerrar.pack(pady=(10, 0))
        self.win.protocol("WM_DELETE_WINDOW", lambda: None)     # no se cierra a medias
        self.barra.start(12)
        threading.Thread(target=self._trabajar, daemon=True).start()
        self.win.after(100, self._sondear)

    def _trabajar(self):
        for titulo, funcion in self.tareas:
            self.q.put(("titulo", titulo))
            try:
                funcion(lambda m: self.q.put(("log", m)), lambda h, t: self.q.put(("prog", (h, t))))
            except Exception as e:
                self.q.put(("log", f"ERROR: {e}"))
                self.q.put(("fin", False))
                return
        self.q.put(("fin", True))

    def _sondear(self):
        try:
            while True:
                tipo, dato = self.q.get_nowait()
                if tipo == "titulo":
                    self.titulo.set(dato)
                    self.detalle.set("")
                    self.barra.configure(mode="indeterminate")
                    self.barra.start(12)
                elif tipo == "log":
                    self.texto.config(state=tk.NORMAL)
                    self.texto.insert(tk.END, dato + "\n")
                    self.texto.see(tk.END)
                    self.texto.config(state=tk.DISABLED)
                elif tipo == "prog":
                    hecho, total = dato
                    if total:
                        self.barra.stop()
                        self.barra.configure(mode="determinate", maximum=total, value=hecho)
                        self.detalle.set(f"{hecho / 1048576:.1f} de {total / 1048576:.1f} MB")
                elif tipo == "fin":
                    self.ok = dato
                    self.barra.stop()
                    self.barra.configure(mode="determinate", maximum=1, value=1 if dato else 0)
                    self.titulo.set("Listo: ya está todo lo necesario." if dato else
                                    "No se pudo completar la descarga; el detalle está abajo.")
                    self.cerrar.config(state=tk.NORMAL)
                    self.win.protocol("WM_DELETE_WINDOW", lambda: self._cerrar(self.ok))
                    if dato:
                        self.win.after(1200, lambda: self._cerrar(True))
                    return
        except queue.Empty:
            pass
        self.win.after(100, self._sondear)

    def _cerrar(self, ok):
        if self.win is not None:
            self.win, ventana = None, self.win
            self.al_terminar(ok)
            try:
                ventana.destroy()
            except tk.TclError:
                pass


