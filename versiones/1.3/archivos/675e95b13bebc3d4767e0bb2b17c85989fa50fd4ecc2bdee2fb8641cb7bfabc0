def leer_informe(lineas):
    """Extrae del informe (o de la salida en vivo) los cortes, avisos y el mapa de tiempos."""
    r = dict(cortes=[], musica=[], rellenos=[], avisos=[], mapa=None, deriva=None, inicio=None,
             retraso=None, verif=None, subs=None, error=None, pista=None, guia=None, pistas=None, video=False,
             mux=None, mux_info=None, mux_error=None, forzados=None, forz_nota=None, subs_dob=[], pistas_extra=[],
             velocidad=None, audio_doblado=None, reparto=None, pista_ori=None, variable=None, tiempo=None)
    en_avisos = False
    for linea in lineas:
        if linea.startswith("Señal de análisis: vídeo"):
            r['video'] = True
        elif (m := RE_VELOCIDAD.match(linea)):
            r['velocidad'] = m[1]
        elif (m := RE_VARIABLE.match(linea)):
            r['variable'] = m[1]
        elif (m := RE_REPARTO.match(linea)):
            r['reparto'] = (int(m[1]), int(m[2]))
        elif (m := RE_AUDIO_DOBLADO.match(linea)):
            r['audio_doblado'] = m[1]
        elif (m := RE_PISTA_EXTRA.match(linea)):
            r['pistas_extra'].append((int(m[1]), m[2], m[3]))
        elif (m := RE_SUB_DOB.match(linea)):
            # (n.º, descripción, ruta ajustada o None, de imagen)
            r['subs_dob'].append((int(m[1]), m[2], m[4] or m[5], bool(m[6])))
        elif (m := RE_FORZ.match(linea)):
            r['forzados'] = (int(m[1]), m[2])
        elif (m := RE_FORZ_EXISTE.match(linea)):
            r['forzados'] = (None, m[1])
        elif linea.startswith("Forzados: "):
            r['forz_nota'] = linea[len("Forzados: "):]
        elif (m := RE_MUX.match(linea)):
            r['mux'], r['mux_info'], r['mux_error'] = m[1], m[2], None
        elif (m := RE_RELLENO.match(linea)):
            r['rellenos'].append(dict(t=a_segundos(m[1]), txt=m[1], ms=int(m[2]), o0=m[3], o1=m[4], db=float(m[5])))
        elif (m := RE_MUX_EXISTE.match(linea)):
            r['mux'], r['mux_info'] = m[1], "ya existía; no se ha tocado"
        elif (m := RE_MUX_ERROR.match(linea)):
            r['mux_error'] = m[1]
        elif (m := RE_CORTE.match(linea)):
            r['cortes'].append(dict(t=a_segundos(m[1]), txt=m[1], accion=m[2], ms=int(m[3]),
                                    tipo=m[4], suelo=int(m[5])))
        elif (m := RE_MUSICA.match(linea)):
            r['musica'].append(dict(t0=a_segundos(m[1]), t1=a_segundos(m[2]),
                                    txt=f"{m[1]}-{m[2]}", d=float(m[3])))
        elif (m := RE_DERIVA.match(linea)):
            r['deriva'] = (float(m[1]), int(m[2]))
        elif (m := RE_INICIO.match(linea)):
            r['inicio'] = (m[1], int(m[2]))
        elif (m := RE_RETRASO.match(linea)):
            r['retraso'] = int(m[1])
        elif (m := RE_VERIF.match(linea)):
            r['verif'] = (float(m[1]), float(m[2]))
        elif (m := RE_SUBS.match(linea)):
            r['subs'] = (int(m[1]), m[2])
        elif (m := RE_PISTA.match(linea)):
            r['pista'], r['guia'] = int(m[1]), (int(m[2]) if m[2] else None)
        elif linea.startswith("Pistas del doblaje: "):
            r['pistas'] = linea[len("Pistas del doblaje: "):]
        elif (m := re.match(r"Pista del original: (\d+):", linea)):
            r['pista_ori'] = int(m[1])
        elif (m := RE_TIEMPO.match(linea)):
            # el del análisis, con su desglose; si luego se muxea, el total con el muxeado delante
            if linea.startswith("Tiempo hasta el error"):
                r['tiempo'] = f"hasta el error, {m[1]}"
            elif linea.startswith("Tiempo total") and r['tiempo']:
                r['tiempo'] = f"{m[1]} en total con el muxeado; el análisis, {r['tiempo']}"
            else:
                r['tiempo'] = m[1]
        elif linea.startswith("Mapa: "):
            try:
                r['mapa'] = json.loads(linea[6:])
            except ValueError:
                pass
        elif linea.startswith("ERROR"):
            r['error'] = linea
        elif linea.startswith("Avisos:"):
            en_avisos = True
        elif en_avisos and linea.startswith("  - "):
            r['avisos'].append(linea[4:])
        else:
            en_avisos = False
    for c in r['cortes']:
        c['aviso'] = any(a.startswith(f"corte {c['txt']}") for a in r['avisos'])
    return r


def resumen_corto(res):
    if not res:
        return ""
    if res['error']:
        return res['error'].replace("ERROR: ", "")[:90] + (
            f" · al cabo de {tiempo_corto(res['tiempo'])}" if res['tiempo'] else "")
    n = len(res['cortes'])
    # sin mapa no hay análisis en el informe (p. ej. solo se ha muxeado un audio hecho fuera)
    partes = [f"{n} corte{'s' if n != 1 else ''}"] if res['mapa'] or n else []
    if res['subs'] and not res['mapa']:         # solo subtítulos
        partes.append(f"{res['subs'][0]} subtítulos")
    if res['verif']:
        partes.append(f"{res['verif'][0]:.1f} ms" + (" (vídeo)" if res['video'] else ""))
    if res['musica']:
        partes.append("música desplazada")
    if res['rellenos']:
        partes.append(f"{sum(r['ms'] for r in res['rellenos']) / 1000:.0f} s de la RAW")
    if res['forzados'] and res['forzados'][0]:
        partes.append(f"{res['forzados'][0]} forzados")
    if res['mux_error']:
        partes.append("sin muxear")
    elif res['mux']:
        partes.append("muxeado")
    if res['tiempo']:
        partes.append(tiempo_corto(res['tiempo']))
    return " · ".join(partes)


def texto_avisos(res):
    """« · 1 a revisar · 3 avisos» (los que dicen que algo puede estar mal y los que solo piden escuchar)."""
    n_rev = sum(1 for a in res['avisos'] if a.startswith("[revisar] "))
    n = len(res['avisos']) - n_rev
    return ((f" · {n_rev} a revisar" if n_rev else "") + (f" · {n} aviso{'s' if n > 1 else ''}" if n else ""))


def tiempo_corto(t):
    """La primera duración del texto del tiempo («14 min 5 s»): la total, o la del análisis si no se muxeó."""
    m = re.search(r"\d+ min \d+ s|\d+ s", t)
    return m[0] if m else t


