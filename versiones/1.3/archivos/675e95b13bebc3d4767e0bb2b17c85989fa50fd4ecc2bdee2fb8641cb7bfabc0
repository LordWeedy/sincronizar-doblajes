class Globo:
    """Texto de ayuda que aparece al dejar el cursor quieto sobre un control, y se va al salir o al pulsar. Las
    explicaciones de cada opción iban escritas al lado y formaban un ladrillo (pedido del usuario, 21-10-2026).
    paleta: función que da los colores del tema del momento (claro u oscuro)."""

    def __init__(self, widget, texto, paleta, espera=450, ancho=460):
        self.widget, self.texto, self.paleta, self.espera, self.ancho = widget, texto, paleta, espera, ancho
        self.ventana = self.pendiente = None
        widget.bind("<Enter>", self._programar, add="+")
        widget.bind("<Leave>", self._ocultar, add="+")
        widget.bind("<ButtonPress>", self._ocultar, add="+")

    def _programar(self, _=None):
        self._cancelar()
        self.pendiente = self.widget.after(self.espera, self._mostrar)

    def _cancelar(self):
        if self.pendiente:
            self.widget.after_cancel(self.pendiente)
            self.pendiente = None

    def _mostrar(self):
        self.pendiente = None
        if self.ventana or not self.widget.winfo_viewable():
            return
        pal = self.paleta()
        self.ventana = v = tk.Toplevel(self.widget)
        v.wm_overrideredirect(True)
        v.attributes("-topmost", True)
        tk.Label(v, text=self.texto, justify="left", wraplength=self.ancho, background=pal['entry_bg'],
                 foreground=pal['fg'], relief="solid", borderwidth=1, padx=8, pady=6).pack()
        v.update_idletasks()
        # debajo del control y sin salirse de la pantalla (si no cabe debajo, encima)
        w, h = v.winfo_width(), v.winfo_height()
        x = min(self.widget.winfo_rootx() + 12, v.winfo_screenwidth() - w - 8)
        y = self.widget.winfo_rooty() + self.widget.winfo_height() + 4
        if y + h > v.winfo_screenheight() - 8:
            y = self.widget.winfo_rooty() - h - 4
