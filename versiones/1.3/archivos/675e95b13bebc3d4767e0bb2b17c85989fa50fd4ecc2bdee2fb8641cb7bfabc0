    def _on_mousewheel(self, event):
        """La rueda desplaza la página salvo encima de listas y textos, que se desplazan solos."""
        try:
            widget = self.master.winfo_containing(event.x_root, event.y_root)
        except (KeyError, tk.TclError):
            return
        while widget is not None:
            if isinstance(widget, (ttk.Treeview, tk.Text)):
                return
            if widget is self.master:
                break
            widget = widget.master
        if widget is self.master:
            self.canvas.yview_scroll(int(-event.delta / 120), "units")

