# En el proceso ayudante (con el programa cerrado)

class VentanaAyudante:
    """Ventana pequeña del ayudante. ejecutar(trabajo) corre trabajo(ui) en un hilo y la ventana va contando lo
    que pasa; se cierra sola si todo va bien."""

    def __init__(self):
        self.root = tk.Tk()
        self.root.title("Sync Master · actualizando")
        self.root.configure(background=PALETA['bg'])
        self.root.resizable(False, False)
        self.q = queue.Queue()
        marco = tk.Frame(self.root, background=PALETA['bg'], padx=22, pady=16)
        marco.pack(fill="both", expand=True)
        self.fase_v = tk.StringVar(value="Preparando...")
        self.detalle_v = tk.StringVar(value="")
        tk.Label(marco, textvariable=self.fase_v, background=PALETA['bg'], foreground=PALETA['fg'],
                 font=("TkDefaultFont", 10, "bold"), wraplength=460, justify="left").pack(anchor="w")
        estilo = ttk.Style(self.root)
        try:
            estilo.theme_use("clam")
        except tk.TclError:
            pass
        estilo.configure("Horizontal.TProgressbar", background=PALETA['select_bg'], troughcolor=PALETA['entry_bg'])
        self.barra = ttk.Progressbar(marco, mode="determinate", length=460, maximum=1, value=0)
        self.barra.pack(fill="x", pady=(10, 4))
        self.detalle_l = tk.Label(marco, textvariable=self.detalle_v, background=PALETA['bg'],
                                  foreground=PALETA['muted'], wraplength=460, justify="left")
        self.detalle_l.pack(anchor="w")
        self.boton = ttk.Button(marco, text="Cerrar", command=self.root.destroy)
        self.codigo = 1
        self.root.protocol("WM_DELETE_WINDOW", lambda: None)

    # (llamadas desde el hilo de trabajo)
    def linea(self, t):
        pass

    def fase(self, t):
        self.q.put(("fase", t))

    def aplicando(self, i, n, ruta):
        self.q.put(("aplicando", (i, n, ruta)))

    def esperando(self, version, t):
        self.q.put(("esperando", (version, t)))

    def fin(self, ok, texto):
        self.q.put(("fin", (ok, texto)))

    def ejecutar(self, trabajo):
        def hilo():
            try:
                self.codigo = trabajo(self)
            except Exception as e:
                self.fin(False, f"Fallo inesperado: {e}")
            self.q.put(("terminado", None))
        threading.Thread(target=hilo, daemon=True).start()
        self.root.after(100, self._sondear)
        self.root.mainloop()
        return self.codigo

    def _sondear(self):
        terminado = False
        try:
            while True:
                tipo, dato = self.q.get_nowait()
                if tipo == "fase":
                    self.fase_v.set(dato)
                    self.detalle_v.set("")
                    self.barra.stop()
                    self.barra.configure(mode="determinate", maximum=1, value=0)
                elif tipo == "aplicando":
                    i, n, ruta = dato
                    self.barra.configure(mode="determinate", maximum=n, value=i)
                    self.detalle_v.set(f"{i} de {n}: {ruta}")
                elif tipo == "esperando":
                    version, t = dato
                    if str(self.barra.cget("mode")) != "indeterminate":
                        self.barra.configure(mode="indeterminate")
                        self.barra.start(15)
                    self.detalle_v.set(f"Esperando a que la versión {version} se abra y diga que funciona "
                                       f"({int(t)} s)")
                elif tipo == "fin":
                    ok, texto = dato
                    self.barra.stop()
                    self.barra.configure(mode="determinate", maximum=1, value=1 if ok else 0)
                    if texto:
                        self.fase_v.set(texto if ok else "No se ha actualizado")
                        self.detalle_v.set("" if ok else texto)
                        self.detalle_l.configure(foreground=PALETA['muted'] if ok else PALETA['aviso'])
                    self.ok = ok
                elif tipo == "terminado":
                    terminado = True
        except queue.Empty:
            pass
        if terminado:
            if getattr(self, "ok", False) or not self.detalle_v.get():
                self.root.after(1500, self.root.destroy)
            else:
                self.boton.pack(pady=(12, 0))
                self.root.protocol("WM_DELETE_WINDOW", self.root.destroy)
                self.root.after(60000, self.root.destroy)
            return
        self.root.after(100, self._sondear)
