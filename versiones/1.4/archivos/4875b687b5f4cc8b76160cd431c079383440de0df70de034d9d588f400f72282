                                        "{ep} = 1x03, {temporada}, {episodio} = 03, {nombre} = nombre del episodio "
                                        "(del título del castellano o de su nombre de archivo)")
    ap.add_argument("--titulo-video", help="título del vídeo muxeado tal cual (por defecto: el de la plantilla o, "
                                           "sin plantilla, el del castellano si lo tiene)")
    ap.add_argument("--forzados", action="store_true",
                    help="lee con el OCR de Windows los subtítulos quemados en la imagen del doblaje y los guarda "
                         "en _forzados.srt con los mismos cortes; al muxear van como subtítulo forzado")
    ap.add_argument("--forz-titulo", default="Forzados", help="título de la pista de forzados (por defecto Forzados)")
    ap.add_argument("--solo-pista-principal", action="store_true",
                    help="no sincronizar las demás pistas dobladas del doblaje (por defecto se sincronizan todas "
                         "menos las versiones originales, con los mismos cortes, y se muxean detrás de la principal)")
    ap.add_argument("--decodificar", choices=list(DECODIFICADORES), default="cpu",
                    help="con qué se decodifica el vídeo al medir con los cambios de plano o leer forzados: "
                         + ", ".join(f"{k} = {v[0]}" for k, v in DECODIFICADORES.items())
                         + ". Si la GPU falla, se usa la CPU (por defecto: cpu)")
    args = ap.parse_args()
    # análisis en marcha: el actualizador no cambia el programa mientras tanto (si no está o falla, da igual)
    try:
        import actualizador
        args.en_marcha = actualizador.registrar_instancia(os.path.dirname(os.path.abspath(__file__)), "motor", True)
    except Exception:
        args.en_marcha = None
    args.idioma = args.idioma or args.mux_idioma or "es-ES"
    if args.solo_muxear and args.muxear is None:
        args.muxear = ""
    try:
        correcciones = leer_correcciones(args.correcciones)
    except ValueError as e:
        ap.error(f"--correcciones: {e}")
    if args.solo_subs:
        if not args.subs:
            ap.error("--solo-subs necesita el subtítulo en --subs")
        salida = args.salida or ruta_subs_solo(args.solo_subs, args.idioma)
        mkv = (args.muxear or ruta_mux(args.solo_subs, titulo="con subtítulos")) if args.muxear is not None else None
        # hecho: el subtítulo o, si se muxea, el vídeo con él (al muxear no se deja copia del subtítulo)
        hecho = next((x for x in (salida, mkv) if x and os.path.exists(x)), None)
        if hecho:
            print(f"Ya existe, lo salto: {hecho}")
            return
        try:
            sincronizar_subtitulos(args.solo_subs, args.subs, salida)
        except Exception as e:
            import traceback
            aqui = [f for f in traceback.extract_tb(e.__traceback__) if f.filename == os.path.abspath(__file__)]
            donde = f"  [{aqui[-1].name}, línea {aqui[-1].lineno}]" if aqui and not isinstance(e, RuntimeError) else ""
            print(f"ERROR: {e}{donde}")
            return
        if mkv:
            lineas = []
            try:
                lineas = [muxear_subtitulo(args.solo_subs, salida, mkv, args.mux_idioma, args.mux_titulo)]
                lineas += sin_copia_subs([salida], mkv)
            except Exception as e:
                lineas = [f"No se pudo muxear: {e}"]
                print(lineas[0])
            with open(os.path.splitext(salida)[0] + "_informe.txt", "a", encoding="utf-8") as f:
                f.write("".join(x + "\n" for x in lineas))
        return

    trabajos = []
    if args.lote:
        dob, ori = args.lote
        originales = {episodio(os.path.basename(f)): f for f in glob.glob(os.path.join(ori, "*.mkv"))}
        for f in sorted(glob.glob(os.path.join(dob, "*"))):
            if not f.lower().endswith(AUDIO_EXT) or "_SYNC" in f:
                continue
            ep = episodio(os.path.basename(f))
            if ep in originales:
                srt = os.path.splitext(originales[ep])[0] + ".srt"
                trabajos.append((f, originales[ep], None, srt if os.path.exists(srt) else None))
            else:
                print(f"Sin original para {os.path.basename(f)}")
    elif args.doblaje and args.original:
        trabajos.append((args.doblaje, args.original, args.salida, args.subs))
    else:
        ap.error("indica DOBLAJE ORIGINAL o --lote")

    def mux(es_path, en_path, salida):
        """Muxea si se pidió y aún no existe; lo apunta en el informe. Un fallo aquí no invalida el audio."""
        if args.muxear is None:
            return ""
        try:
            nombre = None
            if args.plantilla:
                ep = episodio(os.path.basename(es_path)) or episodio(os.path.basename(en_path))
                nombre = expandir_plantilla(args.plantilla, ep, nombre_episodio(es_path))
            # sin plantilla ni título explícito se copia el del castellano o, si no tiene, el del original
            # (mkvmerge no pasa solo el título de un .avi)
            titulo_video = (args.titulo_video or nombre or titulo_contenedor(es_path)
                            or titulo_contenedor(en_path) or None)
            mkv = (args.muxear if args.muxear and len(trabajos) == 1
                   else ruta_mux(en_path, titulo=args.mux_titulo, nombre=nombre))
            if os.path.exists(mkv):
                print(f"Ya existe el vídeo muxeado, no se toca: {mkv}")
                return ", vídeo muxeado ya existía"
            forz = ruta_forzados(salida) if args.forzados and os.path.exists(ruta_forzados(salida)) else None
            subs = subs_para_muxear(es_path, salida, args.mux_idioma)
            linea = muxear(en_path, salida, mkv, args.mux_idioma, args.mux_titulo, titulo_video=titulo_video,
                           forzados=forz, forz_titulo=args.forz_titulo, subtitulos=subs,
                           audios=[] if args.solo_pista_principal else audios_para_muxear(es_path, salida),
                           vel=velocidad_del_mapa(leer_mapa(salida)))
        except Exception as e:
            print(f"No se pudo muxear: {e}")
            return f", SIN muxear ({e})"
        anotar(salida, [linea] + sin_copia_subs([s["ruta"] for s in subs], mkv))
        return ", muxeado"

    def anotar(salida, lineas):
        informe = os.path.splitext(salida)[0] + "_informe.txt"
        if os.path.exists(informe):
            with open(informe, "a", encoding="utf-8") as f:
                f.write("".join(x + "\n" for x in lineas))

    def subtitulos_aparte(es_path, salida):
        """Audio ya sincronizado: los subtítulos del doblaje que falten (y, si no trae, los forzados con OCR)
        se sacan con el mapa de cortes que guardó su informe."""
        pistas = pistas_sub_doblaje(es_path)
        faltan = [s for s in pistas if s["ext"] and not os.path.exists(ruta_sub_doblaje(salida, s))]
        ocr = args.forzados and not any(s["ext"] for s in pistas) and not os.path.exists(ruta_forzados(salida))
        if not faltan and not ocr:
            return
        mapa = leer_mapa(salida)
        if not mapa:
            print("Subtítulos: no se pueden ajustar sin el informe del audio sincronizado (lleva el mapa de cortes)")
            return
        lineas = []
        def p(msg=""):
            print(msg, flush=True); lineas.append(msg)
        t_audio = float(probe_audio(es_path, (args.pista or 1) - 1).get("start_time") or 0)
        if faltan:
            ajustar_subs_doblaje(es_path, t_audio, mapa, salida, p)
        if ocr:
            for a in generar_forzados(es_path, t_audio, mapa, salida, args.mux_idioma, p, args.decodificar)[1]:
                p(f"Aviso: {a}")
        anotar(salida, lineas)

    resumen = []
    for es_path, en_path, salida, sub in trabajos:
        salida = salida or ruta_salida(es_path, args.idioma, pista=args.pista)
        print("\n" + "=" * 78)
        existe = [x for x in (salida, sub and os.path.splitext(salida)[0] + os.path.splitext(sub)[1])
                  if x and os.path.exists(x)]
        if args.solo_muxear:
            if not os.path.exists(salida):
                print(f"ERROR: no existe el audio sincronizado {salida}"); resumen.append((es_path, "ERROR")); continue
            if args.muxear is not None and leer_mapa(salida) is None:
                # el informe guarda la velocidad y los cortes: sin él se muxearía sin adaptar el original, desfasado
                print("ERROR: falta el informe del audio sincronizado (..._informe.txt), que guarda la velocidad y "
                      "los cortes; sin él no se sabe si hay que adaptar el original. Vuelve a sincronizar.")
                resumen.append((es_path, "ERROR: falta el informe")); continue
            if sub and not os.path.exists(os.path.splitext(salida)[0] + os.path.splitext(sub)[1]):
                # al muxear no se deja copia del subtítulo ajustado; rehacerlo con el mapa daría por hecho que va con
                # el doblaje (sin las voces no se sabe para qué versión estaba hecho)
                print("Aviso: el subtítulo ajustado ya no está (al muxear no se deja copia): este vídeo irá sin él; "
                      "para meterlo, vuelve a sincronizar")
            subtitulos_aparte(es_path, salida)
            resumen.append((es_path, "audio ya sincronizado" + mux(es_path, en_path, salida))); continue
        if existe:
            print(f"Ya existe, lo salto: {existe[0]}"); resumen.append((es_path, "ya existía")); continue
        t_trabajo = time.time()
        try:
            avisos = sincronizar(es_path, en_path, salida, sub, args.pista, args.guia, args.pista_original,
                                 args.medir, not args.sin_relleno_original, args.forzados, args.mux_idioma,
                                 args.decodificar, not args.solo_pista_principal, args.formato, args.sin_cortes,
                                 args.estirar_variable, correcciones, limpiar=args.limpiar)
            hecho_mux = mux(es_path, en_path, salida)
            resumen.append((es_path, ("OK" if not avisos else f"OK con {len(avisos)} aviso(s)") + hecho_mux))
            if hecho_mux == ", muxeado":
                linea = f"Tiempo total, con el muxeado: {duracion(time.time() - t_trabajo)}"
                print(linea)
                anotar(salida, [linea])
            if args.muxear is None and velocidad_del_mapa(leer_mapa(salida)) != 1:
                aviso = ("Aviso: el doblaje va a otra velocidad y este audio cuadra con el original ADAPTADO a ella, "
                         "que solo se crea al muxear con este programa (--muxear o la casilla de la GUI; como el "
                         "audio ya existe, solo muxea). Metido a mano en el original tal cual NO cuadra.")
                print(aviso)
                anotar(salida, [aviso])
        except Exception as e:
            # dónde ha fallado (función y línea de este script), para poder arreglarlo a partir del informe
            import traceback
            aqui = [f for f in traceback.extract_tb(e.__traceback__) if f.filename == os.path.abspath(__file__)]
            donde = f"  [{aqui[-1].name}, línea {aqui[-1].lineno}]" if aqui and not isinstance(e, RuntimeError) else ""
            print(f"ERROR: {e}{donde}"); resumen.append((es_path, f"ERROR: {e}"))
            print(f"Tiempo hasta el error: {texto_tiempo(time.time() - t_trabajo)}")
    if len(trabajos) > 1:
        print("\n" + "=" * 78 + "\nResumen:")
        for f, r in resumen:
            print(f"  {os.path.basename(f)}: {r}")


if __name__ == "__main__":
    main()
