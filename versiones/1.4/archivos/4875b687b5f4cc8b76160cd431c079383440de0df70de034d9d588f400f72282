                    help="quita el ruido de la cinta de la pista doblada (VHS: continua, cortes de la captura, "
                         "chasquidos, zumbido y siseo) antes de montarla; tarda unos minutos")
    ap.add_argument("--sin-relleno-original", action="store_true",
                    help="no rellenar con el audio original lo que le falte al doblaje (queda en silencio o con "
                         "el ruido de fondo del doblaje)")
    ap.add_argument("--muxear", nargs="?", const="", metavar="MKV",
                    help="mete el audio sincronizado en el vídeo original como primera pista de audio y "
                         "predeterminada; sin ruta, se crea junto al original con su nombre en .mkv")
    ap.add_argument("--solo-muxear", action="store_true",
                    help="no sincroniza: muxea el audio ya sincronizado (el de -o o el nombre por defecto)")
    ap.add_argument("--mux-idioma", default="es-ES", help="idioma de la pista muxeada (por defecto es-ES)")
    ap.add_argument("--mux-titulo", default="Castellano", help="título de la pista muxeada (por defecto Castellano)")
