def en_paralelo(funcion, elementos, hilos=HILOS):
    """[funcion(x) for x in elementos], repartido en hilos y en el mismo orden."""
    elementos = list(elementos)
    if hilos <= 1 or len(elementos) <= 1:
        return [funcion(x) for x in elementos]
    with ThreadPoolExecutor(min(hilos, len(elementos))) as ex:
        return list(ex.map(funcion, elementos))
