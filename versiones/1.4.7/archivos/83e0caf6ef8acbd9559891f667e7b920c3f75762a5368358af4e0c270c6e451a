"""Batería de pruebas del sincronizador, con la respuesta conocida: cada caso se fabrica a partir de vídeos cortos (de
G:\\cosas varias\\Intros y cosas random), se sincroniza con sincronizar_doblaje.py tal cual y se compara su informe con
lo que tiene que salir. Se pasa después de cada cambio del programa: si algo que funcionaba se rompe, sale FALLO.
Pedido del usuario (21-10-2026): «la robustez para no romper lo que ya funcionaba».

Uso:  python probar_sincronizador.py [--carpeta CARPETA] [--solo caso1,caso2] [--conservar]
Tarda unos minutos (vídeos de 1-4 min en SD). Los archivos fabricados van a una carpeta temporal que se borra al final
(con --conservar se deja, para mirar un fallo). Termina con código 1 si algún caso falla."""
import argparse, ast, builtins, os, re, shutil, subprocess, sys, tempfile, time

VERSION = '1.4.7'
AQUI = os.path.dirname(os.path.abspath(__file__))
MOTOR = os.path.join(AQUI, "sincronizar_doblaje.py")
CARPETA = r"G:\cosas varias\Intros y cosas random"
BASE = "TVE 1 (Continuidad).mp4"            # 3:41, 640x480, 25 fps
CORTO = "Cocodrilos al rescate.mp4"         # 1:00
COLOR = "Motorratones de Marte.mp4"         # 1:01, 1080p HEVC con datos de color mal puestos («trc:reserved»)
OTRO_DIALOGO = "Vaya Semanita - El Katxi - MARTÍN DE IDIAZABAL (480p, h264, youtube).mp4"     # 5:06, otras voces
FONDO = [CORTO, "El locomundo de Tex Avery.mp4", COLOR, "Intro motorratones.mp4"]           # 4:08 seguidos
PAL = 1001 / 960


def ffmpeg(*args):
    r = subprocess.run(["ffmpeg", "-hide_banner", "-v", "error", "-y", *args], capture_output=True, text=True,
                       errors="replace")
    if r.returncode:
        raise RuntimeError(f"ffmpeg: {r.stderr.strip()[-300:]}")


def tasa(path):
    r = subprocess.run(["ffprobe", "-v", "error", "-select_streams", "a:0", "-show_entries", "stream=sample_rate",
                        "-of", "csv=p=0", path], capture_output=True, text=True)
    return int(r.stdout.strip() or 48000)


def segundos(mmss):
    m, s = mmss.split(":")
    return int(m) * 60 + float(s)


def leer(texto):
    """Lo que interesa del informe (o de la salida, si no hay informe): error, inicio (ms, negativo si se recorta),
    cortes [(s, ms con signo)], velocidad, verificación, avisos."""
    r = dict(texto=texto, error=None, inicio=None, cortes=[], velocidad="", verif=None, avisos=[])
    en_avisos = False
    for linea in texto.splitlines():
        if linea.startswith("ERROR"):
            r["error"] = linea
        elif (m := re.match(r"^Inicio: (recortados|añadidos) (\d+) ms", linea)):
            r["inicio"] = int(m[2]) * (-1 if m[1] == "recortados" else 1)
        elif (m := re.match(r"^Corte\s+(\S+)\s+(inserta|recorta)\s+(\d+) ms", linea)):
            r["cortes"].append((segundos(m[1]), int(m[3]) * (-1 if m[2] == "recorta" else 1)))
        elif linea.startswith("Velocidad"):
            r["velocidad"] += linea + "\n"
        elif (m := re.match(r"^Verificación(?! \(con el castellano\)).*(?:desviación típica|mediana) ([\d.]+) ms, "
                            r"p90 ([\d.]+) ms", linea)):
            r["verif"] = (float(m[1]), float(m[2]))
        elif linea.startswith("Avisos:"):
            en_avisos = True
        elif en_avisos and linea.startswith("  - "):
            r["avisos"].append(linea[4:])
        else:
            en_avisos = False
    r["revisar"] = [a for a in r["avisos"] if a.startswith("[revisar] ")]
    return r


# --- comprobaciones (cada una devuelve una lista de fallos, vacía si todo va bien)
def sin_error(r):
    return [f"error: {r['error']}"] if r["error"] else []


def inicio(ms, tol):
    return lambda r: [] if r["inicio"] is not None and abs(r["inicio"] - ms) <= tol else \
        [f"inicio {r['inicio']} ms, se esperaba {ms:+d} ±{tol}"]


def cortes(n):
    return lambda r: [] if len(r["cortes"]) == n else [f"{len(r['cortes'])} cortes {r['cortes']}, se esperaban {n}"]


def un_corte(ms, tol, desde, hasta):
    def f(r):
        if len(r["cortes"]) != 1:
            return [f"{len(r['cortes'])} cortes {r['cortes']}, se esperaba uno de {ms:+d} ms"]
        t, d = r["cortes"][0]
        return ([] if abs(d - ms) <= tol else [f"el corte es de {d:+d} ms, se esperaba {ms:+d} ±{tol}"]) + \
               ([] if desde <= t <= hasta else [f"el corte va en {t:.2f} s, se esperaba entre {desde} y {hasta}"])
    return f


def contiene(texto, donde="texto"):
    return lambda r: [] if texto in r[donde] else [f"falta «{texto}»"]


def no_contiene(texto):
    return lambda r: [f"sale «{texto}»"] if texto in r["texto"] else []


def nada_que_revisar(r):
    return [f"avisa «{a}»" for a in r["revisar"]]


def verificacion(max_ms):
    return lambda r: [] if r["verif"] and r["verif"][0] <= max_ms else [f"verificación {r['verif']}, máx. {max_ms} ms"]


def error_con(texto):
    return lambda r: [] if r["error"] and texto in r["error"] else [f"se esperaba el error «{texto}», salió {r['error']}"]


def verif_castellano(max_ms):
    """La verificación con la propia pista doblada (con guía, 1.4.4): su p90, como mucho max_ms."""
    def f(r):
        m = re.search(r"Verificación \(con el castellano\): mediana ([\d.]+) ms, p90 ([\d.]+) ms", r["texto"])
        return [] if m and float(m[2]) <= max_ms else \
            [f"verificación con el castellano: {m[0] if m else 'no sale'}; se esperaba p90 <= {max_ms} ms"]
    return f


def correccion_sugerida(desde, hasta, ms, tol_ms):
    """Un aviso de trozo descolocado con su corrección a mano: que cubra desde-hasta (s, con 3 s de margen) y mueva ms."""
    def f(r):
        for m in re.finditer(r"la corrección a mano sería «(\d+):(\d\d)-(\d+):(\d\d) ([+-]\d+)»", r["texto"]):
            a, b = int(m[1]) * 60 + int(m[2]), int(m[3]) * 60 + int(m[4])
            if a <= desde + 3 and b >= hasta - 3 and a >= desde - 3 and b <= hasta + 3 and abs(int(m[5]) - ms) <= tol_ms:
                return []
        return [f"no sale la corrección de {desde}-{hasta} s ({ms:+d} ms)"]
    return f


def cortes_en(esperados, tol_ms, tol_s):
    """Los cortes [(s del doblaje, ms con signo)], en ese orden."""
    def f(r):
        if len(r["cortes"]) != len(esperados):
            return [f"{len(r['cortes'])} cortes {r['cortes']}, se esperaban {esperados}"]
        return [f"corte en {t:.2f} s de {d:+d} ms, se esperaba en {te} s de {de:+d} ms"
                for (t, d), (te, de) in zip(r["cortes"], esperados) if abs(d - de) > tol_ms or abs(t - te) > tol_s]
    return f


def corte_cerca(te, de, tol_ms, tol_s):
    """Que haya un corte de de ms (con signo) a te ±tol_s s del doblaje (para casos con cortes de tolerancias distintas:
    un recorte va al silencio más cercano, un relleno justo al empalme)."""
    return lambda r: [] if any(abs(d - de) <= tol_ms and abs(t - te) <= tol_s for t, d in r["cortes"]) else \
        [f"no hay un corte de {de:+d} ms en {te} ±{tol_s} s; cortes: {r['cortes']}"]


# --- los casos: (nombre, qué comprueba, cómo se fabrica el doblaje -> (doblaje, original), comprobaciones)
def casos(c, tmp):
    base, corto, color = (os.path.join(c, x) for x in (BASE, CORTO, COLOR))
    sr = tasa(base)
    t = lambda nombre: os.path.join(tmp, nombre)

    def limpio():
        ffmpeg("-i", base, "-map", "0:a:0", "-ac", "2", "-c:a", "flac", t("limpio.mka"))
        return t("limpio.mka"), base

    def desfase():
        ffmpeg("-i", base, "-map", "0:a:0", "-ac", "2", "-af", "adelay=1500|1500", "-c:a", "flac", t("desfase.mka"))
        return t("desfase.mka"), base

    def sobra():
        ffmpeg("-i", base, "-filter_complex", "[0:a]atrim=0:60,asetpts=PTS-STARTPTS[a1];[0:a]atrim=58,"
               "asetpts=PTS-STARTPTS[a2];[a1][a2]concat=n=2:v=0:a=1[a]", "-map", "[a]", "-ac", "2", "-c:a", "flac",
               t("sobra.mka"))
        return t("sobra.mka"), base

    def falta():
        ffmpeg("-i", base, "-filter_complex", "[0:a]atrim=0:90,asetpts=PTS-STARTPTS[a1];[0:a]atrim=91,"
               "asetpts=PTS-STARTPTS[a2];[a1][a2]concat=n=2:v=0:a=1[a]", "-map", "[a]", "-ac", "2", "-c:a", "flac",
               t("falta.mka"))
        return t("falta.mka"), base

    def pal():
        ffmpeg("-i", base, "-map", "0:a:0", "-ac", "2", "-af", f"asetrate={sr}*1001/960,aresample={sr}", "-c:a", "flac",
               t("pal.mka"))
        return t("pal.mka"), base

    def pal_tono():
        ffmpeg("-i", base, "-map", "0:a:0", "-ac", "2", "-af", f"atempo={PAL:.10f}", "-c:a", "flac", t("pal_tono.mka"))
        return t("pal_tono.mka"), base

    def corto_pal():
        ffmpeg("-i", corto, "-map", "0:a:0", "-ac", "2", "-af",
               f"asetrate={tasa(corto)}*1001/960,aresample={tasa(corto)}", "-c:a", "flac", t("corto_pal.mka"))
        return t("corto_pal.mka"), corto

    def imagen_desplazada():
        ffmpeg("-itsoffset", "0.5", "-i", base, "-i", base, "-map", "0:v:0", "-map", "1:a:0", "-c", "copy",
               t("imagen_desplazada.mkv"))
        return t("imagen_desplazada.mkv"), base

    def con_imagen():
        ffmpeg("-i", base, "-f", "lavfi", "-i", "anoisesrc=d=230:c=pink:r=48000", "-filter_complex",
               "[0:v]trim=0:63,setpts=PTS-STARTPTS[v1];[0:v]trim=60,setpts=PTS-STARTPTS[v2];[v1][v2]concat=n=2:v=1:a=0[v]",
               "-map", "[v]", "-map", "1:a:0", "-c:v", "libx264", "-preset", "ultrafast", "-crf", "23", "-c:a", "aac",
               "-shortest", t("con_imagen.mp4"))
        return t("con_imagen.mp4"), base

    def color_raro():
        ffmpeg("-i", color, "-f", "lavfi", "-i", "anoisesrc=d=70:c=pink:r=48000", "-map", "0:v:0", "-map", "1:a:0",
               "-c:v", "copy", "-c:a", "aac", "-shortest", t("color.mkv"))
        return t("color.mkv"), color

    def destellos():
        # 15 s de destellos al principio (imagen normal e invertida cada 0,16 s, como la cabecera de Becker), en la
        # RAW y en el doblaje; al doblaje le faltan sus primeros 1,5 s (hay que añadírselos) y su audio no se parece
        # (se mide con la imagen)
        ffmpeg("-i", base, "-vf", r"negate=enable='lt(mod(t\,0.32)\,0.16)*lt(t\,15)'", "-c:v", "libx264",
               "-preset", "ultrafast", "-crf", "23", "-c:a", "copy", t("destellos_raw.mp4"))
        ffmpeg("-ss", "1.5", "-i", t("destellos_raw.mp4"), "-f", "lavfi", "-i", "anoisesrc=d=230:c=pink:r=48000",
               "-map", "0:v:0", "-map", "1:a:0", "-c:v", "libx264", "-preset", "ultrafast", "-crf", "23", "-c:a", "aac",
               "-shortest", t("destellos.mp4"))
        return t("destellos.mp4"), t("destellos_raw.mp4")

    def lateral_rota():
        # La pelu del señor Pan 3x02 (27-10-2026): la guía, en AAC y con el tono corregido, tenía la lateral (L-R)
        # estropeada y la mezcla intacta; el programa miraba solo la lateral, daba el sonido por «otro» y medía con la
        # imagen. Aquí, en la RAW y en el doblaje, la lateral es ruido (distinto en cada uno) y la mezcla, el sonido;
        # el del doblaje, además, estirado y vuelto a encoger (la onda no coincide: hace falta la envolvente)
        lado = lambda semilla: (f"anoisesrc=d=230:c=pink:r={sr}:a=0.2:s={semilla}[n];[m][n]amerge=inputs=2,"
                                "pan=stereo|c0=0.6*c0+c1|c1=0.6*c0-c1[a]")
        ffmpeg("-i", base, "-filter_complex", "[0:a]pan=mono|c0=0.5*c0+0.5*c1[m];" + lado(1), "-map", "0:v:0",
               "-map", "[a]", "-c:v", "copy", "-c:a", "flac", "-shortest", t("lateral_rota_raw.mkv"))
        ffmpeg("-i", base, "-filter_complex", f"[0:a]atempo={PAL:.10f},atempo={1 / PAL:.10f},"
               "pan=mono|c0=0.5*c0+0.5*c1[m];" + lado(2), "-map", "0:v:0", "-map", "[a]", "-c:v", "copy",
               "-c:a", "flac", "-shortest", t("lateral_rota.mkv"))
        return t("lateral_rota.mkv"), t("lateral_rota_raw.mkv")

    def guia_sin_imagen():
        # un doblaje con imagen, su castellano (aquí ruido) y la guía inglesa, que es el audio de la RAW: con la guía
        # encajando en todo el episodio no se leen los vídeos (27-10-2026; antes, más de la mitad del tiempo)
        ffmpeg("-i", base, "-map", "0:v:0", "-map", "0:a:0", "-c", "copy", "-metadata:s:a:0", "language=eng",
               t("guia_raw.mkv"))
        ffmpeg("-i", base, "-f", "lavfi", "-i", f"anoisesrc=d=230:c=pink:r={sr}:a=0.1", "-map", "0:v:0", "-map", "1:a:0",
               "-map", "0:a:0", "-c:v", "copy", "-c:a:0", "flac", "-c:a:1", "copy", "-metadata:s:a:0", "language=spa",
               "-metadata:s:a:1", "language=eng", "-shortest", t("guia.mkv"))
        return t("guia.mkv"), t("guia_raw.mkv")

    def guia_sin_idioma():
        # La pelu del señor Pan 3x14: la guía (el audio de la RAW, con el tono corregido) sin idioma y un castellano;
        # con la envolvente, una pista sin idioma no se daba nunca por versión original (y se medía con la imagen)
        ffmpeg("-i", base, "-map", "0:v:0", "-map", "0:a:0", "-c", "copy", "-metadata:s:a:0", "language=eng",
               t("guia_sin_idioma_raw.mkv"))
        ffmpeg("-i", base, "-f", "lavfi", "-i", f"anoisesrc=d=230:c=pink:r={sr}:a=0.1", "-filter_complex",
               f"[0:a]atempo={PAL:.10f},atempo={1 / PAL:.10f}[g]", "-map", "0:v:0", "-map", "1:a:0", "-map", "[g]",
               "-c:v", "copy", "-c:a", "flac", "-metadata:s:a:0", "language=spa", "-metadata:s:a:1", "language=und",
               "-shortest", t("guia_sin_idioma.mkv"))
        return t("guia_sin_idioma.mkv"), t("guia_sin_idioma_raw.mkv")

    def etiquetas_cambiadas():
        # la versión original (con el tono corregido) etiquetada «spa» y el doblaje (aquí ruido) «eng»: con la onda no se
        # veía que la «castellana» tiene los diálogos del original, y se habría muxeado inglés como castellano
        ffmpeg("-i", base, "-f", "lavfi", "-i", f"anoisesrc=d=230:c=pink:r={sr}:a=0.1", "-filter_complex",
               f"[0:a]atempo={PAL:.10f},atempo={1 / PAL:.10f}[g]", "-map", "0:v:0", "-map", "[g]", "-map", "1:a:0",
               "-c:v", "copy", "-c:a", "flac", "-metadata:s:a:0", "language=spa", "-metadata:s:a:1", "language=eng",
               "-shortest", t("etiquetas_cambiadas.mkv"))
        ffmpeg("-i", base, "-map", "0:v:0", "-map", "0:a:0", "-c", "copy", "-metadata:s:a:0", "language=eng",
               t("etiquetas_cambiadas_raw.mkv"))
        return t("etiquetas_cambiadas.mkv"), t("etiquetas_cambiadas_raw.mkv")

    def ruido():
        ffmpeg("-f", "lavfi", "-i", "anoisesrc=d=221:c=pink:r=48000", "-ac", "2", "-c:a", "flac", t("ruido.mka"))
        return t("ruido.mka"), base

    def desfasada_de_la_guia():
        # Diagnóstico asesinato S06 (02-11-2026): dentro del doblaje el castellano no iba a la par de la guía (de 0 a 180
        # ms, distinto en cada trozo) y, con la verificación hecha con la guía, salía «0,0 ms». Aquí el castellano (los
        # graves del audio de la RAW, con otra «voz» encima) va 150 ms tarde entre 1:00 y 2:30, con silencios en los dos
        # empalmes; la guía, a la par
        ffmpeg("-i", base, "-map", "0:v:0", "-map", "0:a:0", "-c", "copy", "-metadata:s:a:0", "language=eng",
               t("desf_raw.mkv"))
        ffmpeg("-i", base, "-f", "lavfi", "-i", f"anoisesrc=d=230:c=white:r={sr}:a=0.3:s=7", "-filter_complex",
               "[0:a]aformat=channel_layouts=stereo,lowpass=f=300,lowpass=f=300,asplit=3[a][b][c];"
               "[a]atrim=0:60,asetpts=PTS-STARTPTS[a1];[b]atrim=59.85:149.85,asetpts=PTS-STARTPTS[b1];"
               "[c]atrim=150,asetpts=PTS-STARTPTS[c1];[a1][b1][c1]concat=n=3:v=0:a=1[me];"
               "[1:a]bandpass=f=1200:width_type=h:w=2000,aformat=channel_layouts=stereo[v];"
               "[me][v]amix=inputs=2:normalize=0:duration=first,"
               "volume=0:enable='between(t,59.6,60.4)+between(t,149.6,150.4)'[cas]",
               "-map", "0:v:0", "-map", "[cas]", "-map", "0:a:0", "-c:v", "copy", "-c:a:0", "flac", "-c:a:1", "copy",
               "-metadata:s:a:0", "language=spa", "-metadata:s:a:1", "language=eng", "-shortest", t("desf.mkv"))
        return t("desf.mkv"), t("desf_raw.mkv")

    def trozo_corto_descolocado():
        # 8 s (1:40-1:48) puestos 1,5 s fuera de su sitio: demasiado corto para ser un desfase de la medida (pide unos
        # 10 s), así que se monta con el de al lado; la verificación solo contaba lo que encaja y salía bien. Ahora lo
        # busca más lejos y avisa, con la corrección a mano que lo arreglaría (1.4.5)
        ffmpeg("-i", base, "-filter_complex", "[0:a]asplit=3[a][b][c];[a]atrim=0:100,asetpts=PTS-STARTPTS[a1];"
               "[b]atrim=101.5:109.5,asetpts=PTS-STARTPTS[b1];[c]atrim=108,asetpts=PTS-STARTPTS[c1];"
               "[a1][b1][c1]concat=n=3:v=0:a=1[a]", "-map", "[a]", "-ac", "2", "-c:a", "flac", t("descolocado.mka"))
        return t("descolocado.mka"), base

    def sonido_desfasado_por_trozos():
        # medido con la imagen (aquí, a la fuerza): el sonido del doblaje va 120 ms tarde de su imagen entre 1:00 y 2:30.
        # Seguir al sonido solo ve partes de 0,2 s o más; el contraste lo corrige (1.4.5)
        ffmpeg("-i", base, "-f", "lavfi", "-i", f"anoisesrc=d=230:c=white:r={sr}:a=0.3:s=7", "-filter_complex",
               "[0:a]aformat=channel_layouts=stereo,lowpass=f=300,lowpass=f=300,asplit=3[a][b][c];"
               "[a]atrim=0:60,asetpts=PTS-STARTPTS[a1];[b]atrim=59.88:149.88,asetpts=PTS-STARTPTS[b1];"
               "[c]atrim=150,asetpts=PTS-STARTPTS[c1];[a1][b1][c1]concat=n=3:v=0:a=1[me];"
               "[1:a]bandpass=f=1200:width_type=h:w=2000,aformat=channel_layouts=stereo[v];"
               "[me][v]amix=inputs=2:normalize=0:duration=first,"
               "volume=0:enable='between(t,59.6,60.4)+between(t,149.6,150.4)'[cas]",
               "-map", "0:v:0", "-map", "[cas]", "-c:v", "copy", "-c:a", "flac", "-metadata:s:a:0", "language=spa",
               "-shortest", t("sonido_trozos.mkv"))
        return t("sonido_trozos.mkv"), base, ["--medir", "video"]

    def desfasada_tono():
        # lo mismo en un DVD PAL con el tono corregido (como La pelu del señor Pan): castellano y guía acelerados sin
        # cambiar el tono; la onda no coincide con el original y se contrasta con la envolvente de los graves
        desfasada_de_la_guia()
        ffmpeg("-i", t("desf.mkv"), "-filter_complex", f"[0:a:0]atempo={PAL:.10f}[c];[0:a:1]atempo={PAL:.10f}[g]",
               "-map", "[c]", "-map", "[g]", "-c:a", "flac", "-metadata:s:a:0", "language=spa",
               "-metadata:s:a:1", "language=eng", t("desf_tono.mka"))
        return t("desf_tono.mka"), t("desf_raw.mkv")

    def empalme_en_mono():
        # One Piece 1x01 de Netflix (04-11-2026, prueba de un compañero del usuario): la escena de después de la
        # cortinilla iba en mono; con la lateral, que ahí calla, el empalme del relleno caía 1 s tarde, ese segundo de
        # ambiente sonaba dos veces y la música de la cortinilla entraba a medias. Aquí, un original con lateral de
        # verdad (otro vídeo en ella) y 6 s en mono justo después de un hueco de 10 s que le falta al doblaje
        # (1:30-1:40); el doblaje, con un ruido lateral muy bajo que no es el del original (como el de un códec). Con la
        # 1.4.5 el corte iba en 1:35,40 y la verificación decía «0,0 ms»
        ffmpeg("-i", base, "-stream_loop", "-1", "-i", corto, "-filter_complex",
               f"[0:a]pan=mono|c0=0.5*c0+0.5*c1[m];[1:a]aresample={sr},pan=mono|c0=0.5*c0+0.5*c1,volume=0.7,"
               "volume=0:enable='between(t,100,106)'[s];[m][s]amerge=inputs=2,pan=stereo|c0=c0+c1|c1=c0-c1[a]",
               "-map", "0:v:0", "-map", "[a]", "-c:v", "copy", "-c:a", "flac", "-shortest", t("mono_raw.mkv"))
        ffmpeg("-i", t("mono_raw.mkv"), "-f", "lavfi", "-i", f"anoisesrc=d=230:c=white:r={sr}:a=0.0001:s=3",
               "-filter_complex", "[0:a]asplit=2[a][b];[a]atrim=0:90,asetpts=PTS-STARTPTS[a1];[b]atrim=100,"
               "asetpts=PTS-STARTPTS[b1];[a1][b1]concat=n=2:v=0:a=1[d];[d][1:a]amerge=inputs=2,"
               "pan=stereo|c0=c0+c2|c1=c1-c2[a]", "-map", "[a]", "-c:a", "flac", "-shortest", t("mono.mka"))
        return t("mono.mka"), t("mono_raw.mkv")

    def estereo_otro_dialogo():
        # Lo de casi todos los doblajes de verdad (05-11-2026, tras la 1.4.6): estéreo con la misma música y efectos en
        # los dos y el diálogo en el centro, cada uno en su idioma. La lateral (L-R) lleva solo el fondo y encaja; la
        # mezcla (L+R) lleva el diálogo, distinto, y encaja poco. Los demás casos se fabrican con audios casi mono y se
        # miden con la mezcla, así que este es el que comprueba que medir también con la mezcla (1.4.6) no mueve nada
        # donde la lateral suena. Fondo: cuatro vídeos seguidos (sin bucles, que darían coincidencias cada vuelta), en
        # la lateral y algo en el centro. Al doblaje le sobran 2 s en el 1:00 y le faltan 8 s del 2:30 del original.
        # (asetpts=N/SR/TB: tiempos seguidos; sin él el doblaje salía con un salto de 40 ms en sus primeros paquetes, que
        # el motor lee como un reproductor, como un hueco, y el informe daba «recortados 40 ms»)
        fondo = [os.path.join(c, x) for x in FONDO]
        mezcla = "".join(f"[{i + 1}:a]aresample={sr},pan=mono|c0=0.5*c0+0.5*c1[f{i}];" for i in range(len(fondo))) + \
            "".join(f"[f{i}]" for i in range(len(fondo))) + f"concat=n={len(fondo)}:v=0:a=1[fondo];" + \
            f"[0:a]aresample={sr},pan=mono|c0=0.5*c0+0.5*c1[dlg];" + \
            "[dlg][fondo]amerge=inputs=2,pan=stereo|c0=0.6*c0+0.6*c1|c1=0.6*c0-0.2*c1,asetpts=N/SR/TB,atrim=0:221"
        entradas = [x for f in fondo for x in ("-i", f)]
        ffmpeg("-i", base, *entradas, "-filter_complex", mezcla + "[a]", "-map", "0:v:0", "-map", "[a]", "-c:v",
               "copy", "-c:a", "flac", "-shortest", t("dial_raw.mkv"))
        ffmpeg("-i", os.path.join(c, OTRO_DIALOGO), *entradas, "-filter_complex",
               mezcla + ",asplit=3[a][b][c];[a]atrim=0:60,asetpts=PTS-STARTPTS[a1];[b]atrim=58:150,asetpts=PTS-STARTPTS"
               "[b1];[c]atrim=158,asetpts=PTS-STARTPTS[c1];[a1][b1][c1]concat=n=3:v=0:a=1,asetpts=N/SR/TB[a]", "-map", "[a]",
               "-c:a", "flac", t("dial.mka"))
        return t("dial.mka"), t("dial_raw.mkv")

