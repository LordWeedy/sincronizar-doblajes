def pruebas_sueltas():
    """Comprobaciones de funciones sueltas del motor, sin fabricar nada: [(nombre, fallos)]."""
    sys.path.insert(0, AQUI)
    import numpy as np
    import sincronizar_doblaje as sd
    out = []
    muestra = ("frame:0    pts:0       pts_time:0\ntimecode=00:00:00:00\nlavfi.scd.mafd=0.000\nlavfi.scd.score=0.000\n"
               "frame:1    pts:42      pts_time:0.042\nlavfi.scd.mafd=0.632\nlavfi.scd.score=0.632\n")
    n = len(sd.RE_FOTOGRAMA.findall(muestra))
    out.append(("patron_fotogramas", "las líneas de ffmpeg con código de tiempo se leen",
                [] if n == 2 else [f"lee {n} fotogramas de 2"]))
    c = sd.ncc_curve(np.ones(100, np.float32), np.ones(50, np.float32))
    out.append(("ncc_corto", "buscar un trozo más largo que la señal no revienta",
                [] if c is None else ["no devuelve None"]))
    av = ["corte 1:00.00: sin silencio claro, conviene escucharlo",
          "1:00-2:00: 12 cambios de plano seguidos del doblaje no encajan con el original; puede estar descolocado"]
    clase = [sd.para_revisar(a) for a in av]
    out.append(("clases_de_aviso", "los avisos se separan en «revisar» y «escuchar»",
                [] if clase == [False, True] else [f"clasificados {clase}"]))
    # el nombre del audio sincronizado: el nuevo, y los de antes se siguen reconociendo (no se repite lo ya hecho)
    fallos = []
    with tempfile.TemporaryDirectory(prefix="nombres_") as d:
        dob = os.path.join(d, "Serie 1x01.avi")
        nuevo = sd.ruta_salida(dob, "es-ES")
        if os.path.basename(nuevo) != "Serie 1x01_[es-ES]_SYNC.mka":
            fallos.append(f"nombre nuevo: {os.path.basename(nuevo)}")
        for viejo, idioma in (("Serie 1x01_[spa]_SYNC_ENG.mka", "es-ES"), ("Serie 1x01_[spa]_SYNC_ENG.flac", "es-ES"),
                              ("Serie 1x01_[spa]_SYNC_ENG.mka", "es-419")):
            open(os.path.join(d, viejo), "w").close()
            r = os.path.basename(sd.ruta_salida(dob, idioma))
            if r != viejo:
                fallos.append(f"con {viejo} ya hecho ({idioma}) da {r}")
            os.remove(os.path.join(d, viejo))
        otra = os.path.join(d, "salida")
        os.makedirs(otra)
        open(os.path.join(otra, "Serie 1x01_[spa]_SYNC_ENG.mka"), "w").close()
        if os.path.dirname(sd.ruta_salida(dob, "es-ES", otra)) != otra or \
                not sd.ruta_salida(dob, "es-ES", otra).endswith("_SYNC_ENG.mka"):
            fallos.append("con carpeta de salida no encuentra el de antes")
    out.append(("nombre_salida", "«…_[es-ES]_SYNC.mka», y los «…_[spa]_SYNC_ENG» de antes se reconocen", fallos))
    # la pista de la RAW con la que se mide (y se rellena): por idioma y, si no decide, por el título (el DVDRemux de
    # Becker: ucraniano «MVO» primero, inglés «Original» después, doblaje .avi sin idioma)
    pista = lambda n, idioma="", titulo="": {"_n": n, "index": n, "codec_name": "ac3", "channels": 2,
                                            "tags": {k: v for k, v in (("language", idioma), ("title", titulo)) if v}}
    casos_pista = [  # (pistas de la RAW, pistas del doblaje, la que tiene que salir)
        ([pista(1, "ukr", "MVO | Comedy Central"), pista(2, "eng", "Original")], [pista(1)], 2),
        ([pista(1, "rus", "Закадровый"), pista(2, "eng")], [pista(1)], 2),
        ([pista(1, "eng", "Commentary"), pista(2, "eng", "English")], [pista(1)], 2),
        ([pista(1, "dan"), pista(2, "eng")], [pista(1, "spa"), pista(2, "eng")], 2),      # por idioma
        ([pista(1, "spa", "Castellano"), pista(2, "eng", "V.O.")], [pista(1)], 2),
        ([pista(1, "ukr"), pista(2, "eng")], [pista(1)], 1),                               # nada lo dice: la primera
        ([pista(1, "eng", "Original")], [pista(1)], 1),
    ]
    fallos, antes = [], sd.pistas_audio
    try:
        for ori, dob, bien in casos_pista:
            sd.pistas_audio = lambda ruta, ori=ori, dob=dob: ori if ruta == "raw" else dob
            sale = sd.elegir_original("raw", "doblaje", "spa", p=lambda *a: None)["_n"]
            if sale != bien:
                fallos.append(f"con {[sd.describir_pista(s) for s in ori]} elige la {sale}, no la {bien}")
    finally:
        sd.pistas_audio = antes
    out.append(("pista_original", "de la RAW se mide con la versión original, no con voces superpuestas", fallos))
    # etiquetas de idioma que no lo son (La pelu del señor Pan 3x14: «???» en ffprobe, «und» en mkvmerge): sin idioma, y
    # que no acaben en el nombre de un archivo («?» no vale en Windows: salía «Broken pipe»)
    fallos = [f"«{e}» -> «{sd.idioma_valido(e)}»" for e, bien in (("???", ""), ("und", ""), ("", ""), ("spa", "spa"),
                                                                  ("es-ES", "es-ES"), ("eng", "eng"))
              if sd.idioma_valido(e) != bien]
    ruta = sd.ruta_pista_extra("x_SYNC.mka", {"_n": 2, "tags": {"language": "???"}})
    if any(ch in os.path.basename(ruta) for ch in '?*<>|:"'):
        fallos.append(f"nombre de la pista extra: {ruta}")
    out.append(("idioma_sin_valor", "«???» y «und» son «sin idioma» y no van al nombre de archivo", fallos))
    # cuándo la envolvente mide bien sin la imagen: el mismo sonido con otra codificación (parecido 0,85-0,94, desfase
    # estable) sí; otra mezcla (el desfase salta 0,18 s de ida y vuelta) no
    t = np.arange(600.0)
    estable = np.column_stack([t, 0.465 + np.random.default_rng(2).normal(0, 0.001, 600), np.full(600, 0.88)])
    salta = estable.copy()
    salta[::7, 1] += 0.18
    fallos = ([] if sd.envolvente_precisa(estable) else ["el mismo sonido con parecido 0,88 no se da por preciso"]) + \
             (["otra mezcla, con saltos de 0,18 s, se da por precisa"] if sd.envolvente_precisa(salta) else [])
    out.append(("envolvente_precisa", "la envolvente vale sin imagen si el desfase es estable, no si salta", fallos))
    # subtítulo de otra versión con diálogo seguido (huecos de 0,5 s) y dos desfases candidatos a 30 s que cubren voz
    # por bloques alternos (Black Mask, 01-11-2026: se alternaban y las líneas salían desordenadas y solapadas)
    iv = np.array([(10 + 2.5 * i, 12 + 2.5 * i) for i in range(48)])
    v = np.zeros(400 * sd.FR_VOZ, np.float32)
    for i, (x0, x1) in enumerate(iv):
        L = 0.0 if (i // 6) % 2 == 0 else -30.0        # el desfase con el que cada bloque de 6 cubre voz
        v[int((x0 + L + 40) * sd.FR_VOZ):int((x1 + L + 40) * sd.FR_VOZ)] = 1
    ref = dict(v=v, t0=-40.0, escala=1.0)
    a, L = sd._tramos_con_deriva(iv, ref, 1.0, 0.0, np.array([50.0, 60, 100, 110]), np.array([0.0, 0, -30, -30]))
    ini, fin = a * iv[:, 0] + L, a * iv[:, 1] + L
    mal = int((ini[1:] < fin[:-1] - sd.SUB_TOL_ORDEN - 1e-9).sum())
    out.append(("subtitulo_en_orden", "un subtítulo de otra versión no sale nunca antes que el anterior",
                [f"{mal} subtítulos salen antes que el anterior"] if mal else []))
    # velocidad con la envolvente (La pelu del señor Pan 3x21): a la misma velocidad una ventana suelta de 0,80 (música
    # lenta, que la envolvente casa aunque vaya un 4 % más rápida) no puede vetar la PAL, confirmada con 0,94-0,98
    misma, pal = (-1.0, 1, 0.80, 5, 0.80), (0.97, 2, 0.95, 5, 0.98)
    fallos = [] if sd.encaja_velocidad(pal, sd.base_envolvente(misma), True) else ["la PAL no encaja"]
    if sd.encaja_velocidad(misma, sd.ENV_RUIDO, True):
        fallos.append("una ventana suelta a la misma velocidad se da por buena")
    out.append(("velocidad_suelta", "una ventana suelta a la misma velocidad no veta la PAL confirmada", fallos))
    # el seguimiento empieza con el desfase del principio, no con el mejor (La pelu del señor Pan 3x18: +1,01 s al
    # principio y +28,4 s, más claro, al final; empezando en +28,4 el primer minuto salía con desfases casuales)
    rng = np.random.default_rng(1)
    AR, n = sd.AR, 700 * sd.AR
    x = rng.standard_normal(n + 60 * AR).astype(np.float32)
    a = x[30 * AR:30 * AR + n]
    b = np.concatenate([x[29 * AR:29 * AR + 300 * AR] + rng.standard_normal(300 * AR).astype(np.float32),
                        x[5 * AR + 300 * AR:5 * AR + n]])                      # +1 s (con ruido) y luego +25 s
    p, m = sd.desfase_inicial(a, b, primero=True)[0], sd.desfase_inicial(a, b)[0]
    out.append(("desfase_del_principio", "con dos desfases en el episodio, el seguimiento empieza por el del principio",
                [] if abs(p - 1) < 0.01 and abs(m - 25) < 0.01 else [f"primero {p:+.3f} s, mejor {m:+.3f} s"]))
    # la limpieza del ruido de la cinta, por trozos (1.4.2: una película de 86 min no se limpiaba, «demasiado largo»):
    # los trozos casan con la limpieza de una vez, en disco sale lo mismo que en la RAM, el ruido de las pausas baja
    # y un 5.1 no se toca (con su aviso). Un tono con vibrato y pausas, siseo, zumbido de 50 Hz, continua y chasquidos.
    # El tono entra y sale en 30 ms, como un sonido de verdad: cortado en seco a -13 dB, el siseo (tramas de 46 ms) deja
    # algo de ese corte en la pausa de al lado y el ruido de las pausas enteras solo bajaba 7 dB (igual en la 1.4.1)
    import limpiar_vhs as lv
    from scipy.ndimage import uniform_filter1d
    fs, fallos, calla = 44100, [], lambda *a: None
    rng = np.random.default_rng(3)
    t = np.arange(100 * fs) / fs
    suena = np.sin(2 * np.pi * 0.25 * t) > -0.3                     # 1,6 s de pausa cada 4 s
    tono = 0.3 * np.sin(2 * np.pi * 180 * t + 2 * np.sin(2 * np.pi * 3 * t)) * uniform_filter1d(suena * 1.0,
                                                                                                int(0.03 * fs))
    x = (tono[:, None] + rng.standard_normal((len(t), 2)) * 0.004
         + 0.003 * np.sin(2 * np.pi * 50 * t)[:, None] - 0.03).astype(np.float32)
    x[rng.choice(np.arange(fs, len(t) - fs), 100, replace=False)] += 0.4
    entero = np.array(lv.limpiar(x, fs, p=calla, bloque_s=1000)[0])
    trozos = np.array(lv.limpiar(x, fs, p=calla, bloque_s=30)[0])
    with tempfile.TemporaryDirectory(prefix="limpieza_", ignore_cleanup_errors=True) as d:
        ruta = os.path.join(d, "x.f32")
        x.tofile(ruta)
        xm = np.memmap(ruta, np.float32, "r", shape=x.shape)
        lienzo = lambda forma: np.memmap(tempfile.mktemp(suffix=".f32", dir=d), np.float32, "w+", shape=forma)
        y = lv.limpiar(xm, fs, p=calla, lienzo=lienzo, bloque_s=30)[0]
