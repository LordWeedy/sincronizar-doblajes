        # un castellano 5.1 en AC3 sin cortes: tal cual iría intacto, pero se ha pedido 2.0 a 224 kb/s (1.4.3)
        ffmpeg("-i", base, "-map", "0:a:0", "-ac", "6", "-c:a", "ac3", "-b:a", "448k", t("estereo.mka"))
        return t("estereo.mka"), base, ["--canales", "2.0", "--formato", "ac3", "--kbps", "224"]

