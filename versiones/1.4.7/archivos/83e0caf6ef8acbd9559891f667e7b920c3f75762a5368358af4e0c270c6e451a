FUNCIONES = (ast.FunctionDef, ast.AsyncFunctionDef, ast.Lambda)


def _mismo_ambito(nodo):
    """Los nodos que cuelgan de un ámbito sin entrar en las funciones y clases de dentro (que son otro ámbito)."""
    for h in ast.iter_child_nodes(nodo):
        yield h
        if not isinstance(h, FUNCIONES + (ast.ClassDef,)):
            yield from _mismo_ambito(h)


def _ligados(nodo):
    """Los nombres que crea un ámbito: argumentos, asignaciones, imports, def, except … as, global, for, :=."""
    out = set()
    if isinstance(nodo, FUNCIONES):
        a = nodo.args
        out |= {x.arg for x in a.posonlyargs + a.args + a.kwonlyargs + [a.vararg, a.kwarg] if x}
    for n in _mismo_ambito(nodo):
        if isinstance(n, ast.Name) and isinstance(n.ctx, (ast.Store, ast.Del)):
            out.add(n.id)
        elif isinstance(n, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            out.add(n.name)
        elif isinstance(n, (ast.Import, ast.ImportFrom)):
            out |= {(x.asname or x.name).split(".")[0] for x in n.names}
        elif isinstance(n, ast.ExceptHandler) and n.name:
            out.add(n.name)
        elif isinstance(n, (ast.Global, ast.Nonlocal)):
            out |= set(n.names)
        elif isinstance(n, ast.comprehension):
            out |= {t.id for t in ast.walk(n.target) if isinstance(t, ast.Name)}
        elif isinstance(n, ast.NamedExpr):
            out.add(n.target.id)
    return out


def nombres_sin_definir(ruta):
    """[(línea, función, nombre)] que una función lee y no existe ni en ella, ni en las que la contienen, ni en el
    módulo, ni en Python. (Lo de una clase no se ve desde sus métodos, como en Python.)"""
    arbol = ast.parse(open(ruta, encoding="utf-8").read())
    fallos = set()

    def revisar(nodo, visibles):
        vis = visibles | _ligados(nodo)
        for n in _mismo_ambito(nodo):
            if isinstance(n, ast.Name) and isinstance(n.ctx, ast.Load) and n.id not in vis:
                fallos.add((n.lineno, getattr(nodo, "name", "lambda"), n.id))
        funciones(nodo, vis)

    def funciones(nodo, vis):
        for n in _mismo_ambito(nodo):
            if isinstance(n, FUNCIONES):
                revisar(n, vis)
            elif isinstance(n, ast.ClassDef):
                funciones(n, vis)

    funciones(arbol, _ligados(arbol) | set(dir(builtins)) | {"__file__"})
    return sorted(fallos)


def main():
    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    ap.add_argument("--carpeta", default=CARPETA)
    ap.add_argument("--solo", default="", help="casos separados por comas")
    ap.add_argument("--conservar", action="store_true", help="no borrar los archivos fabricados")
    args = ap.parse_args()
    solo = {x.strip() for x in args.solo.split(",") if x.strip()}
    tmp = tempfile.mkdtemp(prefix="pruebas_sincro_")
    resultados, t_total = [], time.time()
    try:
        for nombre, que, fallos in pruebas_sueltas():
            if not solo or nombre in solo:
                resultados.append((nombre, que, fallos, 0.0))
        for nombre, que, fabricar, comprobaciones in casos(args.carpeta, tmp):
            if solo and nombre not in solo:
                continue
            t0 = time.time()
            try:
                fabricado = fabricar()          # (doblaje, original) u, opcional, opciones del motor
                dob, ori = fabricado[:2]
                extra = list(fabricado[2]) if len(fabricado) > 2 else []
                salida = os.path.join(tmp, nombre + "_SYNC.mka")
                r = subprocess.run([sys.executable, MOTOR, dob, ori, "-o", salida] + extra, capture_output=True,
                                   text=True, encoding="utf-8", errors="replace", cwd=tmp)
                informe = os.path.splitext(salida)[0] + "_informe.txt"
                texto = open(informe, encoding="utf-8").read() if os.path.exists(informe) else ""
                # el informe si lo hay (la salida repite lo mismo); de la salida, el error (con error no hay informe)
                res = leer(texto or r.stdout)
                res["error"] = res["error"] or next((x for x in r.stdout.splitlines() if x.startswith("ERROR")), None)
                if r.returncode and not res["error"]:
                    res["error"] = f"terminó con código {r.returncode}: {r.stderr.strip()[-300:]}"
                fallos = [x for comprobar in comprobaciones for x in comprobar(res)]
            except Exception as e:
                fallos = [f"no se pudo probar: {e}"]
            resultados.append((nombre, que, fallos, time.time() - t0))
            print(f"{'OK   ' if not fallos else 'FALLO'} {nombre:18s} {time.time() - t0:5.0f} s  {que}"
                  + "".join(f"\n        - {x}" for x in fallos), flush=True)
    finally:
        if args.conservar:
            print(f"Archivos de las pruebas: {tmp}")
        else:
            shutil.rmtree(tmp, ignore_errors=True)
    malos = [x for x in resultados if x[2]]
    for nombre, que, fallos, _ in resultados:
        if not _ and not fallos:
            print(f"OK    {nombre:18s}    -   {que}")
        elif not _:
            print(f"FALLO {nombre:18s}    -   {que}" + "".join(f"\n        - {x}" for x in fallos))
    print(f"\n{len(resultados) - len(malos)} de {len(resultados)} pruebas bien"
          + (f"; FALLAN: {', '.join(x[0] for x in malos)}" if malos else "") + f" ({time.time() - t_total:.0f} s)")
    sys.exit(1 if malos else 0)


if __name__ == "__main__":
    main()
